From: Erik Conijn <egc112@msn.com>
Subject: b43: HT-PHY: 802.11n HT20, MCS 0-7, one stream (experimental)

b43 never supported 802.11n. For the HT-PHY (BCM4331, core rev 29, the
pre-rev-40 TX header) add HT20 with one spatial stream and no
aggregation, following brcmsmac's MCS path in brcms_c_d11hdrs_mac80211:
advertise HT capabilities (RX MCS 0-15, TX MCS 0-7 via TX_RX_DIFF, SMPS
disabled) on a separate 2.4 GHz
band structure; for MCS rates write the HT PLCP (MCS, length, 0x07), the
HT frame type and TX core mask in the PHY control word, BW 20 / SISO /
mcs_table tx_phy_ctl3 in PHY control word 1, the L-SIG length into the
MIMO mode length fields and HT as the fallback frame type; on receive,
frame type 2/3 is HT with the MCS, 40 MHz and short-GI bits from the
PLCP. QoS (four queues, required by mac80211 for HT) is enabled on
the BCM4331 with HT; it stays off with ht=0. Module parameters: ht
(0 = legacy only), ht_txcore (TX core mask), ht_rx_ampdu (accept RX
block ack sessions; TX aggregation is not implemented, the ampdu_action
op also stops mac80211's WARN when rate control tries a TX session).

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Erik Conijn <egc112@msn.com>
---
diff --git a/drivers/net/wireless/broadcom/b43/main.c b/drivers/net/wireless/broadcom/b43/main.c
index 95a5d0b..2d05ff9 100644
--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -100,6 +100,15 @@ MODULE_PARM_DESC(hwtkip, "Enable hardware tkip.");
 
 static int modparam_qos = 1;
 module_param_named(qos, modparam_qos, int, 0444);
+
+/* 802.11n (HT20, MCS 0..7, one stream, no aggregation) on the HT-PHY */
+int b43_modparam_ht = 1;
+module_param_named(ht, b43_modparam_ht, int, 0444);
+MODULE_PARM_DESC(ht, "HT-PHY: 802.11n HT20 MCS 0-7 (1, default) or legacy only (0)");
+
+static int b43_modparam_ht_rx_ampdu = 1;
+module_param_named(ht_rx_ampdu, b43_modparam_ht_rx_ampdu, int, 0644);
+MODULE_PARM_DESC(ht_rx_ampdu, "HT-PHY: accept A-MPDU RX block ack sessions (1, default) or refuse them (0)");
 MODULE_PARM_DESC(qos, "Enable QOS support (default on)");
 
 static int modparam_btcoex = 1;
@@ -357,6 +366,25 @@ static struct ieee80211_supported_band b43_band_2GHz = {
 	.n_bitrates	= b43_g_ratetable_size,
 };
 
+/* the 2.4 GHz band of the HT-PHY with 802.11n: HT20, one stream */
+static struct ieee80211_supported_band b43_band_2GHz_htphy = {
+	.band		= NL80211_BAND_2GHZ,
+	.channels	= b43_2ghz_chantable,
+	.n_channels	= ARRAY_SIZE(b43_2ghz_chantable),
+	.bitrates	= b43_g_ratetable,
+	.n_bitrates	= b43_g_ratetable_size,
+	.ht_cap		= {
+		.ht_supported	= true,
+		.cap		= IEEE80211_HT_CAP_SM_PS,	/* SMPS disabled */
+		.ampdu_factor	= IEEE80211_HT_MAX_AMPDU_64K,	/* as brcmsmac */
+		.ampdu_density	= IEEE80211_HT_MPDU_DENSITY_8,
+		.mcs		= {
+			.rx_mask	= { 0xff, 0xff, },	/* RX 2 streams */
+			.tx_params	= IEEE80211_HT_MCS_TX_DEFINED | IEEE80211_HT_MCS_TX_RX_DIFF,	/* TX 1 stream */
+		},
+	},
+};
+
 static struct ieee80211_supported_band b43_band_2ghz_limited = {
 	.band		= NL80211_BAND_2GHZ,
 	.channels	= b43_2ghz_chantable,
@@ -2603,8 +2631,13 @@ static void b43_request_firmware(struct work_struct *work)
 
 start_ieee80211:
 	wl->hw->queues = B43_QOS_QUEUE_NUM;
+	/*
+	 * QoS stays off on the BCM4331, except with 802.11n on the HT-PHY:
+	 * mac80211 requires four queues for HT.
+	 */
 	if (!modparam_qos || dev->fw.opensource ||
-	    dev->dev->chip_id == BCMA_CHIP_ID_BCM4331)
+	    (dev->dev->chip_id == BCMA_CHIP_ID_BCM4331 &&
+	     !(b43_modparam_ht && dev->phy.type == B43_PHYTYPE_HT)))
 		wl->hw->queues = 1;
 
 	err = ieee80211_register_hw(wl->hw);
@@ -5240,7 +5273,33 @@ static int b43_op_get_antenna(struct ieee80211_hw *hw, int radio_idx,
 	return 0;
 }
 
+/*
+ * A-MPDU: RX block ack sessions are accepted (the ucode deaggregates and
+ * sends the block acks, mac80211 reorders); TX aggregation is not
+ * implemented. Without the op, mac80211 WARNs when rate control tries a TX
+ * session.
+ */
+static int b43_op_ampdu_action(struct ieee80211_hw *hw,
+			       struct ieee80211_vif *vif,
+			       struct ieee80211_ampdu_params *params)
+{
+	struct b43_wl *wl = hw_to_b43_wl(hw);
+	struct b43_wldev *dev = wl->current_dev;
+
+	switch (params->action) {
+	case IEEE80211_AMPDU_RX_START:
+	case IEEE80211_AMPDU_RX_STOP:
+		if (dev && dev->phy.type == B43_PHYTYPE_HT && b43_modparam_ht &&
+		    b43_modparam_ht_rx_ampdu)
+			return 0;
+		return -EOPNOTSUPP;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
 static const struct ieee80211_ops b43_hw_ops = {
+	.ampdu_action		= b43_op_ampdu_action,
 	.add_chanctx = ieee80211_emulate_add_chanctx,
 	.remove_chanctx = ieee80211_emulate_remove_chanctx,
 	.change_chanctx = ieee80211_emulate_change_chanctx,
@@ -5342,7 +5401,9 @@ static int b43_setup_bands(struct b43_wldev *dev,
 
 	if (have_2ghz_phy)
 		hw->wiphy->bands[NL80211_BAND_2GHZ] = limited_2g ?
-			&b43_band_2ghz_limited : &b43_band_2GHz;
+			&b43_band_2ghz_limited :
+			(phy->type == B43_PHYTYPE_HT && b43_modparam_ht) ?
+			&b43_band_2GHz_htphy : &b43_band_2GHz;
 	if (dev->phy.type == B43_PHYTYPE_N) {
 		if (have_5ghz_phy)
 			hw->wiphy->bands[NL80211_BAND_5GHZ] = limited_5g ?
diff --git a/drivers/net/wireless/broadcom/b43/xmit.c b/drivers/net/wireless/broadcom/b43/xmit.c
index f0b0825..3429564 100644
--- a/drivers/net/wireless/broadcom/b43/xmit.c
+++ b/drivers/net/wireless/broadcom/b43/xmit.c
@@ -192,6 +192,64 @@ static u16 b43_generate_tx_phy_ctl1(struct b43_wldev *dev, u8 bitrate)
 	return control;
 }
 
+/*
+ * 802.11n on the HT-PHY (core rev 29, pre-rev-40 TX header), after
+ * brcmsmac's brcms_c_d11hdrs_mac80211 for MCS rate specs: PLCP = MCS byte,
+ * length, 0x07 (smoothing, not sounding); PHY control word = frame type HT
+ * plus the TX core mask; PHY control word 1 = BW 20 | STF mode |
+ * mcs_table[].tx_phy_ctl3 << 8; MIMO mode length = the L-SIG length of the
+ * mixed-mode preamble (brcms_c_calc_lsig_len).
+ */
+extern int b43_modparam_ht;
+
+static int b43_ht_txcore = 1;
+module_param_named(ht_txcore, b43_ht_txcore, int, 0644);
+MODULE_PARM_DESC(ht_txcore, "HT-PHY: TX core mask for MCS frames (1..7, default 1 = core 0)");
+
+#define B43_TXH_PHY_ENC_HT_	0x0002
+static const u8 b43_ht_mcs_phyctl3[8] = {
+	0x00, 0x08, 0x0A, 0x10, 0x12, 0x19, 0x1A, 0x1C,
+};
+static const u16 b43_ht_mcs_kbps20[8] = {
+	6500, 13000, 19500, 26000, 39000, 52000, 58500, 65000,
+};
+
+/* RX: the PLCP byte 0 of the last HT frame, for A-MPDU subframes after the first */
+static u8 b43_ht_last_rx_plcp0;
+static bool b43_ht_subframe_seen;
+
+static bool b43_ht_rate(struct b43_wldev *dev, const struct ieee80211_tx_rate *r)
+{
+	return b43_modparam_ht && dev->phy.type == B43_PHYTYPE_HT &&
+	       r->idx >= 0 && (r->flags & IEEE80211_TX_RC_MCS) && r->idx < 8;
+}
+
+static void b43_ht_plcp(u8 *plcp, u8 mcs, unsigned int len)
+{
+	plcp[0] = mcs & 0x7f;
+	plcp[1] = len & 0xff;
+	plcp[2] = (len >> 8) & 0xff;
+	plcp[3] = 0x07;
+	plcp[4] = 0;
+	plcp[5] = 0;
+}
+
+static u16 b43_ht_phyctl1(u8 mcs)
+{
+	return B43_TXH_PHY1_BW_20 | B43_TXH_PHY1_MODE_SISO |
+	       (b43_ht_mcs_phyctl3[mcs & 7] << 8);
+}
+
+/* brcms_c_calc_lsig_len: one stream, no STBC, 20 MHz, long GI */
+static u16 b43_ht_lsig_len(u8 mcs, unsigned int len)
+{
+	unsigned int kndps = b43_ht_mcs_kbps20[mcs & 7] * 4;
+	unsigned int nsyms = DIV_ROUND_UP((16 + 8 * len + 6) * 1000, kndps);
+
+	nsyms += 1 + 3;		/* HT-LTF per stream, HT-SIG (2), HT-STF (1) */
+	return 3 * nsyms - 3;
+}
+
 static u8 b43_calc_fallback_rate(u8 bitrate, int gmode)
 {
 	switch (bitrate) {
@@ -395,6 +453,45 @@ int b43_generate_txhdr(struct b43_wldev *dev,
 	}
 
 	rates = info->control.rates;
+
+	/* 802.11n: override the rate fields for MCS rates */
+	if (b43_ht_rate(dev, &rates[0])) {
+		const struct ieee80211_tx_rate *rfb =
+			b43_ht_rate(dev, &rates[1]) ? &rates[1] : &rates[0];
+		u8 mcs = rates[0].idx, mcs_fb = rfb->idx;
+		u8 *plcp = NULL;
+
+		switch (dev->fw.hdr_format) {
+		case B43_FW_HDR_598:
+			plcp = txhdr->format_598.plcp.raw;
+			break;
+		case B43_FW_HDR_351:
+			plcp = txhdr->format_351.plcp.raw;
+			break;
+		case B43_FW_HDR_410:
+			plcp = txhdr->format_410.plcp.raw;
+			break;
+		}
+		if (plcp)
+			b43_ht_plcp(plcp, mcs, plcp_fragment_len);
+		b43_ht_plcp(txhdr->plcp_fb.raw, mcs_fb, plcp_fragment_len);
+		txhdr->phy_rate = mcs;
+		extra_ft = (extra_ft & ~B43_TXH_EFT_FB) | B43_TXH_EFT_FB_HT;
+		phy_ctl = (phy_ctl & ~(B43_TXH_PHY_ENC | B43_TXH_PHY_ANT |
+				       B43_TXH_PHY_SHORTPRMBL)) |
+			  B43_TXH_PHY_ENC_HT_ |
+			  ((b43_ht_txcore & 7) << 6);
+		txhdr->mimo_modelen = cpu_to_le16(b43_ht_lsig_len(mcs, plcp_fragment_len));
+		txhdr->mimo_ratelen_fb = cpu_to_le16(b43_ht_lsig_len(mcs_fb, plcp_fragment_len));
+		txhdr->dur_fb = wlhdr->duration_id;
+		/* PHY control word 1 below takes these */
+		rate = 0xff;
+		rate_fb = 0xff;
+		fill_phy_ctl1 = true;
+		txhdr->phy_ctl1 = cpu_to_le16(b43_ht_phyctl1(mcs));
+		txhdr->phy_ctl1_fb = cpu_to_le16(b43_ht_phyctl1(mcs_fb));
+	}
+
 	/* MAC control */
 	if (!(info->flags & IEEE80211_TX_CTL_NO_ACK))
 		mac_ctl |= B43_TXH_MAC_ACK;
@@ -552,7 +649,7 @@ int b43_generate_txhdr(struct b43_wldev *dev,
 		break;
 	}
 
-	if (fill_phy_ctl1) {
+	if (fill_phy_ctl1 && rate != 0xff) {
 		txhdr->phy_ctl1 =
 			cpu_to_le16(b43_generate_tx_phy_ctl1(dev, rate));
 		txhdr->phy_ctl1_fb =
@@ -741,7 +838,34 @@ void b43_rx(struct b43_wldev *dev, struct sk_buff *skb, const void *_rxhdr)
 		break;
 	}
 
-	if (phystat0 & B43_RX_PHYST0_OFDM)
+	if (b43_modparam_ht && dev->phy.type == B43_PHYTYPE_HT &&
+	    (phystat0 & B43_RX_PHYST0_FTYPE) >= 2) {
+		/* HT frame: MCS and 40 MHz in PLCP byte 0, short GI in byte 3 */
+		rate_idx = plcp->raw[0] & 0x7f;
+		status.encoding = RX_ENC_HT;
+		if (plcp->raw[0] & 0x80)
+			status.bw = RATE_INFO_BW_40;
+		if (plcp->raw[3] & 0x80)
+			status.enc_flags |= RX_ENC_FLAG_SHORT_GI;
+		b43_ht_last_rx_plcp0 = plcp->raw[0];
+	} else if (b43_modparam_ht && dev->phy.type == B43_PHYTYPE_HT &&
+		   !(plcp->raw[0] | plcp->raw[1] | plcp->raw[2] |
+		     plcp->raw[3] | plcp->raw[4] | plcp->raw[5])) {
+		/*
+		 * A-MPDU subframe after the first: the ucode fills the PHY
+		 * status and PLCP only for the first one. Keep the frame and
+		 * report the rate of the last HT frame.
+		 */
+		if (!b43_ht_subframe_seen) {
+			b43_ht_subframe_seen = true;
+			b43info(dev->wl, "HT RX: frame with empty PLCP (A-MPDU subframe), phystat0 0x%04x, using MCS %u\n",
+				phystat0, b43_ht_last_rx_plcp0 & 0x7f);
+		}
+		rate_idx = b43_ht_last_rx_plcp0 & 0x7f;
+		status.encoding = RX_ENC_HT;
+		if (b43_ht_last_rx_plcp0 & 0x80)
+			status.bw = RATE_INFO_BW_40;
+	} else if (phystat0 & B43_RX_PHYST0_OFDM)
 		rate_idx = b43_plcp_get_bitrate_idx_ofdm(plcp,
 					!!(chanstat & B43_RX_CHAN_5GHZ));
 	else
