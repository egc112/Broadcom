+	     (rxstrt == dev->hang_last_rxstrt &&
+	      glitch == dev->hang_last_glitch))) {
+		dev->wl->ampdu_stats.hangs++;
+		b43err(dev->wl, "radio hang: in 15 s beacons %u -> %u, rx starts %u -> %u, crs glitches %u -> %u; txallfrm %u, txphyerr %u, macctl 0x%08x; restarting\n",
+		       dev->hang_last_bcn, bcn, dev->hang_last_rxstrt, rxstrt,
+		       dev->hang_last_glitch, glitch,
+		       b43_shm_read16(dev, B43_SHM_SHARED, 0xe0),
+		       b43_shm_read16(dev, B43_SHM_SHARED, 0xfe),
+		       b43_read32(dev, B43_MMIO_MACCTL));
+		dev->hang_armed = false;
+		b43_controller_restart(dev, "radio hang");
+		return;
+	}
