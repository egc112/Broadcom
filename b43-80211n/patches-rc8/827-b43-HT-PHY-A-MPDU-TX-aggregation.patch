+static void b43_ht_hang_check(struct b43_wldev *dev)
+{
+	u16 bcn, rxstrt, glitch;
+
+	if (dev->phy.type != B43_PHYTYPE_HT || !b43_modparam_ht ||
+	    !b43_is_mode(dev->wl, NL80211_IFTYPE_AP))
+		return;
+	bcn = b43_shm_read16(dev, B43_SHM_SHARED, 0xea);
+	rxstrt = b43_shm_read16(dev, B43_SHM_SHARED, 0x110);
+	glitch = b43_shm_read16(dev, B43_SHM_SHARED, 0x10e);
+	if (dev->hang_armed &&
