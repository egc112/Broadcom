+/*
+ * Turn the TX headers of n consecutive MPDUs into one A-MPDU, after
+ * brcmsmac's brcms_c_ampdu_add_frame() and brcms_c_ampdu_finalize(): mark
+ * the frames first/middle/last, no RTS/CTS inside the aggregate, and write
+ * the A-MPDU length (each MPDU padded to 4 bytes behind a 4-byte delimiter,
+ * no pad after the last one, no extra null delimiters) with the A-MPDU bit
+ * into the PLCP and the L-SIG lengths of the first frame. The ucode sends
+ * the whole aggregate with the first frame's PLCP and rates.
+ */
+void b43_ht_ampdu_fixup(struct b43_wldev *dev, struct b43_txhdr **hdrs, int n)
+{
+	unsigned int ampdu_len = 0, len = 0;
+	struct b43_txhdr *first = hdrs[0];
+	u8 *plcp;
+	u32 mac_ctl;
+	int i;
+
+	for (i = 0; i < n; i++) {
+		plcp = hdrs[i]->format_598.plcp.raw;
+		len = plcp[1] | (plcp[2] << 8);
+		ampdu_len += roundup(len, 4) + 4;
+
+		mac_ctl = le32_to_cpu(hdrs[i]->mac_ctl);
+		mac_ctl &= ~(B43_TXH_MAC_AMPDU | B43_TXH_MAC_STMSDU |
+			     B43_TXH_MAC_SENDRTS | B43_TXH_MAC_SENDCTS |
+			     B43_TXH_MAC_USEFBR);
+		if (i == n - 1)
+			mac_ctl |= B43_TXH_MAC_AMPDU_LAST;
+		else if (i == 0)
+			mac_ctl |= B43_TXH_MAC_AMPDU_FIRST;
+		else
+			mac_ctl |= B43_TXH_MAC_AMPDU_INTER;
+		if (i == 0)
+			mac_ctl |= B43_TXH_MAC_STMSDU;
+		hdrs[i]->mac_ctl = cpu_to_le32(mac_ctl);
+		hdrs[i]->format_598.preload_size = 0;
+	}
+	/* no pad behind the last MPDU */
+	ampdu_len -= roundup(len, 4) - len;
+
+	plcp = first->format_598.plcp.raw;
+	plcp[1] = ampdu_len & 0xff;
+	plcp[2] = (ampdu_len >> 8) & 0xff;
+	plcp[3] |= 0x08;		/* MIMO_PLCP_AMPDU */
+	first->mimo_modelen = cpu_to_le16(b43_ht_lsig_len(plcp[0], ampdu_len));
+	first->mimo_ratelen_fb =
+		cpu_to_le16(b43_ht_lsig_len(first->plcp_fb.raw[0], ampdu_len));
+
+}
