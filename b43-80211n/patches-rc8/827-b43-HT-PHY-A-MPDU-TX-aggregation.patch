From: Erik Conijn <egc112@msn.com>
Subject: b43: HT-PHY: A-MPDU TX aggregation with block ack window tracking

Add TX aggregation for the HT-PHY (BCM4331, ucode 666.2, pre-rev-40 TX
header), after brcmsmac's ampdu.c and dma.c:

- ampdu_action accepts TX block ack sessions on TID 0 and 3 (best effort);
  b43_tx_ampdu() collects the queued frames for one receiver and TID (up
  to 16, the receiver's maximum A-MPDU length) and b43_dma_tx_ampdu()
  writes them to the ring back to back; b43_ht_ampdu_fixup() turns their
  TX headers into one A-MPDU (first/middle/last, the A-MPDU length and bit
  in the PLCP, L-SIG length of the whole aggregate). At most two
  aggregates per ring are in flight (ampdu_inflight).
- One TX status covers the aggregate; the 64-bit block ack bitmap comes
  in a second status package. Acked frames are reported, the others go
  back to the head of the queue and are re-sent up to 5 times, then
  reported with AMPDU_NO_BACK (mac80211 sends a BAR).
- Block ack window tracking as ath9k does it: per station and TID a
  bitmap of the frames sent and neither acked nor given up, from the
  oldest one. A frame 64 or more beyond that oldest frame is not sent; it
  waits until the old ones are through. Sending beyond the window made
  the receiver flush the older frames it still missed (seen on air), so a
  lost block ack turned into real losses.
- The BCM4331's VI/VO hardware FIFOs never transmit: with QoS (needed by
  mac80211 for HT) all queues use the BE ring on this chip.
- b43_tx_work() peeked at the TX queue without its lock: NULL skb and an
  oops on SMP when VI and VO traffic arrived together. Peek under the lock.
- The TX header fix-up is synced to the device with DMA_TO_DEVICE
  (sync_descbuffer_for_device() is for RX buffers and would discard it).
- A watchdog warns when an aggregate gets no status for a second; in AP
  mode a radio whose beacon counter, or both its RX-start and CRS-glitch
  counters, stand still for 15 s is restarted. (An idle AP on a quiet
  channel can go 15 s without an RX start; its receiver still counts
  hundreds of CRS glitches per second.)
- The ucode's TX header format is only known after the upload: A-MPDU TX
  is turned off again there if the ucode is older than rev 598.
- debugfs ieee80211/phyN/b43_ampdu shows the aggregation counters (write
  to it to reset them).

Module parameters: ht_tx_ampdu (default 1), ampdu_max_frames (1..16),
ampdu_inflight (1 or 2), ampdu_dbg (log the next N aggregates).

Netgear R6400 v1 against an ath11k client, one TX stream, MCS 7: TCP
download 20 -> 46 Mbit/s, upload (ACKs aggregated) 45 -> 75 Mbit/s;
12-cycle soak tests (download/upload/bidirectional/VI-VO/idle, wifi
restarts) clean.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Erik Conijn <egc112@msn.com>
---
diff --git a/drivers/net/wireless/broadcom/b43/b43.h b/drivers/net/wireless/broadcom/b43/b43.h
index 946cfe5..da70c98 100644
--- a/drivers/net/wireless/broadcom/b43/b43.h
+++ b/drivers/net/wireless/broadcom/b43/b43.h
@@ -308,6 +308,8 @@ enum {
 #define B43_SHM_SH_PRSSID		0x0160	/* Probe Response SSID */
 #define B43_SHM_SH_PRSSIDLEN		0x0048	/* Probe Response SSID length */
 #define B43_SHM_SH_PRTLEN		0x004A	/* Probe Response template length */
+#define B43_SHM_SH_WATCHDOG_8TU		0x003C	/* ucode watchdog in 8 TU (A-MPDU RX; 598+ ucode, older: DEFAULTIV) */
+#define B43_SHM_SH_MIMO_MAXSYM		0x00BA	/* max. MIMO RX symbols (A-MPDU RX) */
 #define B43_SHM_SH_PRMAXTIME		0x0074	/* Probe Response max time */
 #define B43_SHM_SH_PRPHYCTL		0x0188	/* Probe Response PHY TX control word */
 /* SHM_SHARED rate tables */
@@ -838,6 +840,13 @@ struct b43_wldev {
 	bool dfq_valid;		/* Directed frame queue valid (IBSS PS mode, ATIM) */
 	bool radio_hw_enable;	/* saved state of radio hardware enabled state */
 	bool qos_enabled;		/* TRUE, if QoS is used. */
+	bool ht_tx_ampdu;		/* TRUE, if A-MPDU TX aggregation is used (HT-PHY). */
+	bool qos_one_fifo;		/* TRUE, if all queues use the BE FIFO (BCM4331). */
+	/* HT-PHY radio hang check: ucode beacon / RX start counters 15 s ago */
+	bool hang_armed;
+	u16 hang_last_bcn;
+	u16 hang_last_rxstrt;
+	u16 hang_last_glitch;
 	bool hwcrypto_enabled;		/* TRUE, if HW crypto acceleration is enabled. */
 	bool use_pio;			/* TRUE if next init should use PIO */
 	int gpiomask;			/* GPIO LED mask as a module parameter */
@@ -898,6 +907,34 @@ struct b43_wldev {
 };
 
 /* Data structure for the WLAN parts (802.11 cores) of the b43 chip. */
+/* A-MPDU TX statistics (HT-PHY), debugfs ieee80211/phyN/b43_ampdu */
+struct b43_ampdu_stats {
+	u32 aggregates;		/* A-MPDUs handed to the hardware */
+	u32 frames;		/* MPDUs in them */
+	u32 size_hist[17];	/* aggregates by MPDU count (index 16: 16+) */
+	u32 statuses;		/* A-MPDU TX status reports handled */
+	u32 no_ba;		/* aggregates without a block ack */
+	u32 acked;		/* MPDUs acknowledged */
+	u32 retried;		/* MPDUs queued again */
+	u32 dropped;		/* MPDUs given up after the retry limit (BAR) */
+	u32 plain_status;	/* plain status for an aggregate's first frame */
+	u32 ignored_status;	/* status for a frame inside an aggregate */
+	u32 broken;		/* status walk stopped on a bad ring entry */
+	u32 inflight_reset;	/* in-flight count found set on an empty ring */
+	u32 stalls;		/* no status for 1 s (warning only) */
+	u32 hangs;		/* radio hangs (no beacon / RX for 15 s): restarted */
+	u32 baw_blocked;	/* aggregate building stopped at the BA window end */
+	u32 baw_reset;		/* BA window blocked with nothing in flight: state reset */
+	u32 rx_giants;		/* RX frames spanning several buffers (dropped) */
+	/* RX path (b43_rx), before mac80211 */
+	u32 rx_garbage;		/* RX buffers with an impossible length */
+	u32 rx_skipped;		/* RX buffers the device did not fill (poison intact) */
+	/* item 2 diagnostics: why frames fail */
+	u32 ack_tries[6];	/* acked frames by earlier driver re-sends (0..5) */
+	u32 notack[4];		/* not acked: no BA / bit 0 in window / behind BA SSN / >= 64 ahead */
+	u32 drop_cause[4];	/* finally dropped, same causes as notack */
+};
+
 struct b43_wl {
 	/* Pointer to the active wireless device on this chip */
 	struct b43_wldev *current_dev;
@@ -960,6 +997,10 @@ struct b43_wl {
 	/* Packet transmit work */
 	struct work_struct tx_work;
 
+	/* A-MPDU TX (HT-PHY): statistics and the lost-status watchdog */
+	struct b43_ampdu_stats ampdu_stats;
+	struct delayed_work ampdu_watchdog;
+
 	/* Queue of packets to be transmitted. */
 	struct sk_buff_head tx_queue[B43_QOS_QUEUE_NUM];
 
diff --git a/drivers/net/wireless/broadcom/b43/dma.c b/drivers/net/wireless/broadcom/b43/dma.c
index 760e91d..a1b2b0f 100644
--- a/drivers/net/wireless/broadcom/b43/dma.c
+++ b/drivers/net/wireless/broadcom/b43/dma.c
@@ -25,6 +25,7 @@
 #include <linux/delay.h>
 #include <linux/skbuff.h>
 #include <linux/etherdevice.h>
+
 #include <linux/slab.h>
 #include <asm/div64.h>
 
@@ -1192,7 +1193,7 @@ struct b43_dmaring *parse_cookie(struct b43_wldev *dev, u16 cookie, int *slot)
 }
 
 static int dma_tx_fragment(struct b43_dmaring *ring,
-			   struct sk_buff *skb)
+			   struct sk_buff *skb, bool kick)
 {
 	const struct b43_dma_ops *ops = ring->ops;
 	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
@@ -1280,8 +1281,10 @@ static int dma_tx_fragment(struct b43_dmaring *ring,
 				B43_SHM_SH_MCASTCOOKIE, cookie);
 	}
 	/* Now transfer the whole frame. */
-	wmb();
-	ops->poke_tx(ring, next_slot(ring, slot));
+	if (kick) {
+		wmb();
+		ops->poke_tx(ring, next_slot(ring, slot));
+	}
 	return 0;
 
 out_unmap_hdr:
@@ -1317,7 +1320,7 @@ static struct b43_dmaring *select_ring_by_priority(struct b43_wldev *dev,
 {
 	struct b43_dmaring *ring;
 
-	if (dev->qos_enabled) {
+	if (dev->qos_enabled && !dev->qos_one_fifo) {
 		/* 0 = highest priority */
 		switch (queue_prio) {
 		default:
@@ -1342,6 +1345,24 @@ static struct b43_dmaring *select_ring_by_priority(struct b43_wldev *dev,
 	return ring;
 }
 
+/* Restart the mac80211 queues of a ring that has room again; with
+ * qos_one_fifo all queues share the BE ring. */
+static void b43_dma_wake_queues(struct b43_wldev *dev, struct b43_dmaring *ring)
+{
+	int q, first = ring->queue_prio, last = ring->queue_prio;
+
+	if (dev->qos_one_fifo) {
+		first = 0;
+		last = B43_QOS_QUEUE_NUM - 1;
+	}
+	for (q = first; q <= last; q++) {
+		if (dev->wl->tx_queue_stopped[q])
+			dev->wl->tx_queue_stopped[q] = false;
+		else
+			b43_wake_queue(dev, q);
+	}
+}
+
 int b43_dma_tx(struct b43_wldev *dev, struct sk_buff *skb)
 {
 	struct b43_dmaring *ring;
@@ -1388,7 +1409,7 @@ int b43_dma_tx(struct b43_wldev *dev, struct sk_buff *skb)
 	 * static, so we don't need to store it per frame. */
 	ring->queue_prio = skb_get_queue_mapping(skb);
 
-	err = dma_tx_fragment(ring, skb);
+	err = dma_tx_fragment(ring, skb, true);
 	if (unlikely(err == -ENOKEY)) {
 		/* Drop this packet, as we don't have the encryption key
 		 * anymore and must not transmit it unencrypted. */
@@ -1416,6 +1437,355 @@ out:
 	return err;
 }
 
+/*
+ * A-MPDU TX (HT-PHY): the frames of one aggregate are written to the ring
+ * back to back and the hardware is kicked once, after their TX headers have
+ * been turned into one A-MPDU (brcmsmac collects them in an ampdu session
+ * in dma_txfast()). At most B43_AMPDU_MAX_INFLIGHT aggregates per ring are
+ * outstanding, which also keeps retransmissions inside the BA window.
+ */
+#define B43_AMPDU_MAX_INFLIGHT	2
+#define B43_AMPDU_RETRY_LIMIT	5	/* brcmsmac AMPDU_DEF_RETRY_LIMIT */
+
+extern int b43_ampdu_dbg;
+extern int b43_ampdu_inflight;
+static inline bool b43_ampdu_dbg_on(void)
+{
+	return b43_ampdu_dbg > 0;
+}
+
+/* Number of frames an A-MPDU may have on this queue now (0 = wait) */
+int b43_dma_tx_ampdu_room(struct b43_wldev *dev, u8 queue_prio)
+{
+	struct b43_dmaring *ring = select_ring_by_priority(dev, queue_prio);
+
+	if (!ring->used_slots && ring->ampdu_inflight) {
+		/* a status went missing, but the ring drained */
+		dev->wl->ampdu_stats.inflight_reset++;
+		b43warn(dev->wl, "A-MPDU TX: %d in flight on empty ring %d, reset\n",
+			ring->ampdu_inflight, ring->index);
+		ring->ampdu_inflight = 0;
+	}
+	if (ring->stopped ||
+	    ring->ampdu_inflight >= clamp(b43_ampdu_inflight, 1,
+					  B43_AMPDU_MAX_INFLIGHT))
+		return 0;
+	return free_slots(ring) / TX_SLOTS_PER_FRAME - 1;
+}
+
+int b43_dma_tx_ampdu_inflight(struct b43_wldev *dev, u8 queue_prio)
+{
+	return select_ring_by_priority(dev, queue_prio)->ampdu_inflight;
+}
+
+/* Returns the number of frames that went out in the A-MPDU */
+int b43_dma_tx_ampdu(struct b43_wldev *dev, struct sk_buff **skbs, int n)
+{
+	struct b43_txhdr *hdrs[B43_AMPDU_BA_WSIZE];
+	dma_addr_t hdr_addr[B43_AMPDU_BA_WSIZE];
+	size_t hdrsize = b43_txhdr_size(dev);
+	struct b43_dmadesc_meta *meta;
+	struct b43_dmaring *ring;
+	int i, err, hslot, sent = 0, last_slot = 0;
+	unsigned int queue = skb_get_queue_mapping(skbs[0]);
+
+	ring = select_ring_by_priority(dev, queue);
+	ring->queue_prio = queue;
+	for (i = 0; i < n && i < B43_AMPDU_BA_WSIZE; i++) {
+		if (free_slots(ring) < TX_SLOTS_PER_FRAME) {
+			ieee80211_free_txskb(dev->wl->hw, skbs[i]);
+			continue;
+		}
+		err = dma_tx_fragment(ring, skbs[i], false);
+		if (unlikely(err)) {
+			if (err != -ENOKEY)
+				b43err(dev->wl, "DMA tx mapping failure\n");
+			ieee80211_free_txskb(dev->wl->hw, skbs[i]);
+			continue;
+		}
+		last_slot = ring->current_slot;
+		hslot = last_slot - 1;
+		if (hslot < 0)
+			hslot += ring->nr_slots;
+		hdrs[sent] = (struct b43_txhdr *)
+			&ring->txhdr_cache[(hslot / TX_SLOTS_PER_FRAME) * hdrsize];
+		ring->ops->idx2desc(ring, hslot, &meta);
+		hdr_addr[sent] = meta->dmaaddr;
+		sent++;
+	}
+	if (!sent)
+		return 0;
+
+	b43_ht_ampdu_fixup(dev, hdrs, sent);
+	{
+		if (b43_ampdu_dbg_on())
+			b43info(dev->wl, "ampdu ring %d n %d cookie0 %04x mac_ctl0 %08x plcp0 %*ph modelen %u inflight %d\n",
+				ring->index, sent, le16_to_cpu(hdrs[0]->format_598.cookie),
+				le32_to_cpu(hdrs[0]->mac_ctl), 6, hdrs[0]->format_598.plcp.raw,
+				le16_to_cpu(hdrs[0]->mimo_modelen), ring->ampdu_inflight);
+	}
+	/* The headers were mapped before the fix-up: write it back. (Not
+	 * sync_descbuffer_for_device(), that one is for RX buffers and
+	 * invalidates the CPU cache.) */
+	for (i = 0; i < sent; i++)
+		dma_sync_single_for_device(ring->dev->dev->dma_dev, hdr_addr[i],
+					   hdrsize, DMA_TO_DEVICE);
+	if (!ring->ampdu_inflight++)
+		ring->ampdu_last = jiffies;
+	dev->wl->ampdu_stats.aggregates++;
+	dev->wl->ampdu_stats.frames += sent;
+	dev->wl->ampdu_stats.size_hist[min(sent, 16)]++;
+	wmb();
+	ring->ops->poke_tx(ring, next_slot(ring, last_slot));
+	ieee80211_queue_delayed_work(dev->wl->hw, &dev->wl->ampdu_watchdog, HZ);
+
+	if (free_slots(ring) < TX_SLOTS_PER_FRAME) {
+		b43_stop_queue(dev, queue);
+		dev->wl->tx_queue_stopped[queue] = true;
+		ring->stopped = true;
+	}
+	return sent;
+}
+
+/*
+ * One TX status covers a whole A-MPDU (brcms_c_ampdu_dotxstatus_complete):
+ * the cookie is the first frame's, the BA starting sequence is in the
+ * status sequence field, the 64-bit BA bitmap is spread over the first
+ * status (bits 0-3) and the second status package (s1/s2). Acked frames are
+ * reported, the others go back to the head of the TX queue until their
+ * retry limit, then mac80211 gets AMPDU_NO_BACK and sends a BAR.
+ */
+void b43_dma_handle_ampdu_txstatus(struct b43_wldev *dev,
+				   const struct b43_txstatus *status)
+{
+	struct b43_wl *wl = dev->wl;
+	struct b43_dmaring *ring;
+	struct b43_dmadesc_meta *meta;
+	struct sk_buff_head requeue;
+	struct ieee80211_sta *sta = NULL;
+	struct b43_sta *bsta = NULL;
+	size_t hdrsize = b43_txhdr_size(dev);
+	/* A plain (non-A-MPDU) status for an aggregate's first frame: an ACK
+	 * acknowledges a single-frame aggregate, otherwise nothing arrived */
+	bool plain_ack = !status->for_ampdu && status->acked;
+	bool ba_recd = status->for_ampdu && status->acked &&
+		       (status->ampdu_s1 & 1);
+	u16 start_seq = status->seq >> 4;
+	u64 bitmap = 0;
+	int slot, firstused, nframes = 0, nacked = 0;
+	bool first = true;
+
+	ring = parse_cookie(dev, status->cookie, &slot);
+	if (unlikely(!ring))
+		return;
+	if (b43_ampdu_dbg_on())
+		b43info(wl, "A-MPDU handler: cookie %04x slot %d for_ampdu %d acked %d\n",
+			status->cookie, slot, status->for_ampdu, status->acked);
+	firstused = ring->current_slot - ring->used_slots + 1;
+	if (firstused < 0)
+		firstused = ring->nr_slots + firstused;
+	if (unlikely(slot != firstused)) {
+		/* the ucode reports the frames of an aggregate it cut short
+		 * separately, before the aggregate's own status: ignore, the
+		 * aggregate status covers them */
+		wl->ampdu_stats.ignored_status++;
+		if (b43_ampdu_dbg_on())
+			b43info(wl, "A-MPDU TX status for slot %d, first used %d: ignored\n",
+				slot, firstused);
+		return;
+	}
+
+	if (ba_recd) {
+		bitmap = status->frame_count & 0xf;
+		bitmap |= (u64)((status->ampdu_s1 >> 1) & 0xf) << 4;
+		bitmap |= (u64)((status->ampdu_s1 >> 8) & 0xffffff) << 8;
+		bitmap |= (u64)status->ampdu_s2 << 32;
+	}
+	__skb_queue_head_init(&requeue);
+
+	rcu_read_lock();
+	while (1) {
+		struct b43_txhdr *txhdr;
+		struct ieee80211_tx_info *info;
+		struct ieee80211_hdr *hdr;
+		struct sk_buff *skb;
+		bool last, acked = false;
+		u16 seq, bindex = 0;
+		u8 tid, *retry = NULL;
+		u32 mac_ctl;
+		int cause;
+
+		/* header slot */
+		ring->ops->idx2desc(ring, slot, &meta);
+		if (unlikely(meta->skb)) {
+			wl->ampdu_stats.broken++;
+			b43warn(wl, "A-MPDU TX status: unexpected skb at header slot %d\n", slot);
+			break;
+		}
+		txhdr = (struct b43_txhdr *)
+			&ring->txhdr_cache[(slot / TX_SLOTS_PER_FRAME) * hdrsize];
+		mac_ctl = le32_to_cpu(txhdr->mac_ctl);
+		last = (mac_ctl & B43_TXH_MAC_AMPDU) == B43_TXH_MAC_AMPDU_LAST ||
+		       !(mac_ctl & B43_TXH_MAC_AMPDU);
+		unmap_descbuffer(ring, meta->dmaaddr, hdrsize, 1);
+		ring->used_slots--;
+
+		/* data slot */
+		slot = next_slot(ring, slot);
+		ring->ops->idx2desc(ring, slot, &meta);
+		skb = meta->skb;
+		if (unlikely(!skb || b43_dma_ptr_is_poisoned(skb))) {
+			wl->ampdu_stats.broken++;
+			b43warn(wl, "A-MPDU TX status: no skb at data slot %d\n", slot);
+			break;
+		}
+		info = IEEE80211_SKB_CB(skb);
+		unmap_descbuffer(ring, meta->dmaaddr, skb->len, 1);
+		kfree(b43_get_priv_tx_info(info)->bouncebuffer);
+		b43_get_priv_tx_info(info)->bouncebuffer = NULL;
+		meta->skb = B43_DMA_PTR_POISON;
+		ring->used_slots--;
+
+		hdr = (struct ieee80211_hdr *)skb->data;
+		seq = le16_to_cpu(hdr->seq_ctrl) >> 4;
+		tid = ieee80211_is_data_qos(hdr->frame_control) ?
+		      ieee80211_get_tid(hdr) : 0;
+		if (first) {
+			first = false;
+			if (wl->vif)
+				sta = ieee80211_find_sta(wl->vif, hdr->addr1);
+			if (sta)
+				bsta = (struct b43_sta *)sta->drv_priv;
+		}
+		if (bsta)
+			retry = &bsta->ampdu_txretry[tid][seq % B43_AMPDU_BA_WSIZE];
+
+		if (ba_recd) {
+			bindex = (seq - start_seq) & 0xfff;
+			acked = bindex < 64 && (bitmap >> bindex) & 1;
+		} else if (plain_ack && last && nframes == 0) {
+			acked = true;
+		}
+		nframes++;
+		cause = !ba_recd ? 0 : bindex < 64 ? 1 : bindex >= 2048 ? 2 : 3;
+		if (acked) {
+			wl->ampdu_stats.acked++;
+			nacked++;
+			if (retry) {
+				wl->ampdu_stats.ack_tries[min_t(u8, *retry, 5)]++;
+				*retry = 0;
+			}
+			if (bsta)
+				b43_baw_done(bsta, tid, seq);
+			info->status.rates[0].count = 1;
+			info->status.rates[1].idx = -1;
+			info->status.rates[1].count = 0;
+			info->flags |= IEEE80211_TX_STAT_ACK |
+				       IEEE80211_TX_STAT_AMPDU;
+			info->status.ampdu_ack_len = 1;
+			info->status.ampdu_len = 1;
+			ieee80211_tx_status_skb(wl->hw, skb);
+		} else if (retry && *retry < B43_AMPDU_RETRY_LIMIT) {
+			wl->ampdu_stats.notack[cause]++;
+			(*retry)++;
+			wl->ampdu_stats.retried++;
+			/* a retransmission: same SN and PN; the block ack
+			 * window keeps it inside the receiver's window */
+			/* the bounce buffer pointer shares the vif's slot */
+			info->control.vif = wl->vif;
+			__skb_queue_tail(&requeue, skb);
+		} else {
+			wl->ampdu_stats.notack[cause]++;
+			if (retry)
+				*retry = 0;
+			wl->ampdu_stats.dropped++;
+			wl->ampdu_stats.drop_cause[cause]++;
+			if (bsta)
+				b43_baw_done(bsta, tid, seq);
+			ieee80211_tx_info_clear_status(info);
+			info->status.ampdu_ack_len = 0;
+			info->status.ampdu_len = 1;
+			info->flags |= IEEE80211_TX_STAT_AMPDU_NO_BACK;
+			ieee80211_tx_status_skb(wl->hw, skb);
+		}
+
+		if (last)
+			break;
+		slot = next_slot(ring, slot);
+	}
+	rcu_read_unlock();
+
+	if (b43_ampdu_dbg_on())
+		b43info(wl, "A-MPDU status: %d frames, %d acked, BA %d plain %d, ssn %u, used %d\n",
+			nframes, nacked, ba_recd, !status->for_ampdu, start_seq,
+			ring->used_slots);
+
+	if (ring->ampdu_stall_warned) {
+		ring->ampdu_stall_warned = false;
+		b43warn(wl, "A-MPDU TX: ring %d moving again after %u ms\n",
+			ring->index, jiffies_to_msecs(jiffies - ring->ampdu_last));
