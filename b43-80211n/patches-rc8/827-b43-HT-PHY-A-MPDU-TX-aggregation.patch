+/* Per-station driver data (ieee80211_sta::drv_priv): A-MPDU TX retries
+ * per TID, indexed by sequence number modulo the BA window (brcmsmac's
+ * scb_ampdu_tid_ini::txretry). */
+#define B43_AMPDU_BA_WSIZE	64
+struct b43_sta {
+	u8 ampdu_txretry[IEEE80211_NUM_TIDS][B43_AMPDU_BA_WSIZE];
+	/* frames sent and not yet acked or given up, as a
+	 * bitmap from the oldest one (baw_start) */
+	u16 baw_start[IEEE80211_NUM_TIDS];
+	u64 baw_map[IEEE80211_NUM_TIDS];
+	bool baw_valid[IEEE80211_NUM_TIDS];
+};
+
+/*
+ * Block ack window as ath9k keeps it: the receiver accepts
+ * sequence numbers from its window start to start + 63, and a frame beyond
+ * that moves its window and flushes every older frame it still misses. So
+ * never send a frame 64 or more beyond the oldest frame that is neither
+ * acked nor given up; new frames wait until the old ones are through.
+ */
+static inline int b43_baw_offset(const struct b43_sta *bsta, u8 tid, u16 sn)
+{
+	tid &= 15;
+	return bsta->baw_valid[tid] ? (sn - bsta->baw_start[tid]) & 0xfff : 0;
+}
+
+static inline void b43_baw_add(struct b43_sta *bsta, u8 tid, u16 sn)
+{
+	int off;
+
+	tid &= 15;
+	if (!bsta->baw_valid[tid]) {
+		bsta->baw_start[tid] = sn;
+		bsta->baw_map[tid] = 0;
+		bsta->baw_valid[tid] = true;
+	}
+	off = (sn - bsta->baw_start[tid]) & 0xfff;
+	if (off < 64)
+		bsta->baw_map[tid] |= 1ULL << off;
+}
+
+static inline void b43_baw_done(struct b43_sta *bsta, u8 tid, u16 sn)
+{
+	int off;
+
+	tid &= 15;
+	if (!bsta->baw_valid[tid])
+		return;
+	off = (sn - bsta->baw_start[tid]) & 0xfff;
+	if (off >= 64)
+		return;
+	bsta->baw_map[tid] &= ~(1ULL << off);
+	while (bsta->baw_map[tid] && !(bsta->baw_map[tid] & 1)) {
+		bsta->baw_map[tid] >>= 1;
+		bsta->baw_start[tid] = (bsta->baw_start[tid] + 1) & 0xfff;
+	}
+	if (!bsta->baw_map[tid])
+		bsta->baw_valid[tid] = false;
+}
