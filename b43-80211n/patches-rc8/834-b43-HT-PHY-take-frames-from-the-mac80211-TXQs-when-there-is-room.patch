 	u32 rx_uflow;		/* RX descriptor underruns: frames dropped */
+	u32 txq_visits;		/* TXQ pull: txq turns */
+	u32 txq_aql_resend;	/* TXQ pull: retry frames sent past AQL */
+	u32 txq_frames;		/* TXQ pull: frames taken from mac80211 */
+	u32 txq_airtime;	/* TXQ pull: TX airtime reported (us) */
