+/* Free an unlocked frame list */
+static void b43_txq_purge(struct ieee80211_hw *hw, struct sk_buff_head *list)
+{
+	struct sk_buff *skb;
+
+	while ((skb = __skb_dequeue(list)))
+		ieee80211_free_txskb(hw, skb);
+}
+
+static struct b43_txq *b43_txq_drv(struct ieee80211_txq *txq)
+{
+	struct b43_txq *bt = (struct b43_txq *)txq->drv_priv;
+
+	if (!bt->init) {
+		__skb_queue_head_init(&bt->retry_q);
+		INIT_LIST_HEAD(&bt->retry_list);
+		bt->txq = txq;
+		bt->init = true;
+	}
+	return bt;
+}
+
+/* Tell mac80211 whether the txq holds frames of a dozing station (TIM) */
+static void b43_txq_report(struct ieee80211_txq *txq, struct b43_txq *bt,
+			   bool asleep)
+{
+	bool held = asleep && !skb_queue_empty(&bt->retry_q);
+
+	if (!txq->sta || txq->tid >= IEEE80211_NUM_TIDS || held == bt->buffered)
+		return;
+	ieee80211_sta_set_buffered(txq->sta, txq->tid, held);
+	bt->buffered = held;
+}
+
+/*
+ * Pull model: frames to send again (no block ack, or held for a dozing
+ * station) go to their txq's retry queue, behind older ones there, and are
+ * sent before anything new of that txq (wl->mutex held, RCU read side).
+ */
+void b43_txq_hold(struct b43_wl *wl, struct ieee80211_sta *sta, u8 tid,
+		  struct sk_buff_head *list)
+{
+	struct b43_sta *bsta = (struct b43_sta *)sta->drv_priv;
+	struct ieee80211_txq *txq;
+	struct b43_txq *bt;
+	struct sk_buff *skb, *pos;
+	bool asleep = READ_ONCE(bsta->asleep);
+	u16 ref;
+
+	if (tid >= IEEE80211_NUM_TIDS || !(txq = sta->txq[tid])) {
+		b43_txq_purge(wl->hw, list);
+		return;
+	}
+	bt = b43_txq_drv(txq);
+	/* frames of this txq still in the driver queue are newer than the
+	 * ones coming back: take them back too, so all go out in order */
+	skb_queue_walk_safe(&wl->tx_queue[txq->ac], skb, pos) {
+		struct ieee80211_hdr *h = (struct ieee80211_hdr *)skb->data;
+
+		if (ieee80211_is_data_qos(h->frame_control) &&
+		    ieee80211_get_tid(h) == tid &&
+		    ether_addr_equal(h->addr1, sta->addr)) {
+			skb_unlink(skb, &wl->tx_queue[txq->ac]);
+			__skb_queue_tail(list, skb);
+		}
+	}
+	/*
+	 * Keep the retry queue in sequence number order: a frame that failed
+	 * again is older than frames of a later aggregate waiting there, and
+	 * the frame at the block ack window start must go out first, or the
+	 * window fills up behind it.
+	 */
+	skb = skb_peek(list);
+	ref = bsta->baw_valid[tid] ? bsta->baw_start[tid] :
+	      le16_to_cpu(((struct ieee80211_hdr *)skb->data)->seq_ctrl) >> 4;
+	while ((skb = __skb_dequeue(list))) {
+		struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+		u16 key = ((le16_to_cpu(hdr->seq_ctrl) >> 4) - ref) & 0xfff;
+		struct sk_buff *after = NULL;
+
+		if (ieee80211_is_data_qos(hdr->frame_control))
+			skb_queue_reverse_walk(&bt->retry_q, pos) {
+				struct ieee80211_hdr *h =
+					(struct ieee80211_hdr *)pos->data;
+
+				if (!ieee80211_is_data_qos(h->frame_control) ||
+				    (((le16_to_cpu(h->seq_ctrl) >> 4) - ref) &
+				     0xfff) <= key) {
+					after = pos;
+					break;
+				}
+			}
+		else
+			after = skb_peek_tail(&bt->retry_q);
+		if (after)
+			__skb_queue_after(&bt->retry_q, after, skb);
+		else
+			__skb_queue_head(&bt->retry_q, skb);
+	}
+	if (!skb_queue_empty(&bt->retry_q) && list_empty(&bt->retry_list))
+		list_add_tail(&bt->retry_list, &wl->txq_retry[txq->ac]);
+	if (asleep)
+		b43_txq_report(txq, bt, true);
+	else
+		ieee80211_schedule_txq(wl->hw, txq);
+}
+
 /* Hold a frame for a dozing station (wl->mutex held, RCU read side) */
 void b43_ps_hold(struct b43_wl *wl, struct ieee80211_sta *sta,
 		 struct sk_buff *skb)
@@ -4111,6 +4237,16 @@ void b43_ps_hold(struct b43_wl *wl, struct ieee80211_sta *sta,
 	/* the bounce buffer pointer shares the vif's slot */
 	info->control.vif = wl->vif;
 
+	if (wl->txq_pull) {
+		struct sk_buff_head one;
+
+		__skb_queue_head_init(&one);
+		__skb_queue_tail(&one, skb);
+		wl->ampdu_stats.ps_held++;
+		b43_txq_hold(wl, sta, b43_ps_tid(skb), &one);
+		return;
+	}
+
 	if (list_empty(&bsta->ps_list))
 		list_add_tail(&bsta->ps_list, &wl->ps_stas);
 	skb_queue_tail(&bsta->psq, skb);
@@ -4227,13 +4363,252 @@ static bool b43_ps_check(struct b43_wl *wl, struct sk_buff_head *q,
 	return held;
 }
 
+/* Send what the driver queue of this mac80211 queue holds (wl->mutex held) */
+static int b43_tx_queue_run(struct b43_wldev *dev, int queue_num)
+{
+	struct b43_wl *wl = dev->wl;
+	struct sk_buff *skb;
+	int err = 0;
+
+	while ((skb = b43_txq_peek(&wl->tx_queue[queue_num]))) {
+		if (unlikely(atomic_read(&wl->ps_dozing)) &&
+		    b43_ps_check(wl, &wl->tx_queue[queue_num], skb))
+			continue;
+		if (dev->ht_tx_ampdu &&
+		    (IEEE80211_SKB_CB(skb)->flags & IEEE80211_TX_CTL_AMPDU) &&
+		    ieee80211_is_data_qos(((struct ieee80211_hdr *)skb->data)->frame_control) &&
+		    b43_ht_ampdu_rate_ok(dev, IEEE80211_SKB_CB(skb))) {
+			err = b43_tx_ampdu(dev, queue_num);
+			if (err == -ENOSPC) {
+				/* wait for TX status; hold mac80211
+				 * back if the queue grows */
+				if (skb_queue_len(&wl->tx_queue[queue_num]) > 64) {
+					wl->tx_queue_stopped[queue_num] = true;
+					b43_stop_queue(dev, queue_num);
+				} else {
+					err = 0;
+				}
+				break;
+			}
+			continue;
+		}
+		skb = skb_dequeue(&wl->tx_queue[queue_num]);
+		if (unlikely(!skb))
+			break;
+		if (b43_using_pio_transfers(dev))
+			err = b43_pio_tx(dev, skb);
+		else
+			err = b43_dma_tx(dev, skb);
+		if (err == -ENOSPC) {
+			wl->tx_queue_stopped[queue_num] = true;
+			b43_stop_queue(dev, queue_num);
+			skb_queue_head(&wl->tx_queue[queue_num], skb);
+			break;
+		}
+		if (unlikely(err))
+			ieee80211_free_txskb(wl->hw, skb);
+		err = 0;
+	}
+
+	if (!err)
+		wl->tx_queue_stopped[queue_num] = false;
+	return err;
+}
+
+/*
+ * Pull model, power save: a PS-Poll or uAPSD trigger releases up to n frames
+ * of the requested TIDs, the frames to send again first, then mac80211's
+ * (RCU read side, wl->mutex held).
+ */
+static void b43_txq_ps_release(struct b43_wl *wl, struct ieee80211_sta *sta,
+			       struct b43_sta *bsta, int n)
+{
+	struct sk_buff_head rel;
+	struct sk_buff *skb;
+	bool uapsd = bsta->ps_release_uapsd, more = bsta->ps_release_more;
+	int tid;
+
+	__skb_queue_head_init(&rel);
+	for (tid = 0; tid < IEEE80211_NUM_TIDS; tid++) {
+		struct ieee80211_txq *txq = sta->txq[tid];
+		struct b43_txq *bt;
+		unsigned long frames = 0;
+
+		if (!txq || !(bsta->ps_release_tids & BIT(tid)))
+			continue;
+		bt = b43_txq_drv(txq);
+		while (skb_queue_len(&rel) < n &&
+		       (skb = __skb_dequeue(&bt->retry_q)))
+			__skb_queue_tail(&rel, skb);
+		while (skb_queue_len(&rel) < n &&
+		       (skb = ieee80211_tx_dequeue_ni(wl->hw, txq)))
+			__skb_queue_tail(&rel, skb);
+		ieee80211_txq_get_depth(txq, &frames, NULL);
+		if (frames || !skb_queue_empty(&bt->retry_q))
+			more = true;
+		b43_txq_report(txq, bt, true);
+	}
+	if (skb_queue_empty(&rel)) {
+		ieee80211_sta_eosp(sta);
+		return;
+	}
+	skb_queue_walk(&rel, skb) {
+		struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+		struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+		bool last = skb_queue_is_last(&rel, skb);
+
+		info->flags |= IEEE80211_TX_CTL_NO_PS_BUFFER;
+		if (!last || more)
+			hdr->frame_control |=
+				cpu_to_le16(IEEE80211_FCTL_MOREDATA);
+		if (!last)
+			continue;
+		info->flags |= IEEE80211_TX_STATUS_EOSP |
+			       IEEE80211_TX_CTL_REQ_TX_STATUS;
+		if (uapsd && ieee80211_is_data_qos(hdr->frame_control))
+			*ieee80211_get_qos_ctl(hdr) |= IEEE80211_QOS_CTL_EOSP;
+	}
+	wl->ampdu_stats.ps_released += skb_queue_len(&rel);
+	b43_ps_requeue(wl, &rel);
+}
+
+/* Pull model: wake-ups, re-sleeps and releases of one station */
+static void b43_txq_ps_iter(void *data, struct ieee80211_sta *sta)
+{
+	struct b43_wl *wl = data;
+	struct b43_sta *bsta = (struct b43_sta *)sta->drv_priv;
+	bool asleep, resleep;
+	int tid, n;
+
+	if (!bsta->ps_init)
+		return;
+	asleep = READ_ONCE(bsta->asleep);
+	resleep = xchg(&bsta->ps_resleep, 0);
+	n = xchg(&bsta->ps_release, 0);
+	for (tid = 0; tid < IEEE80211_NUM_TIDS; tid++) {
+		struct ieee80211_txq *txq = sta->txq[tid];
+		struct b43_txq *bt;
+
+		if (!txq)
+			continue;
+		bt = b43_txq_drv(txq);
+		if (!asleep) {
+			/* awake: mac80211 forgot the buffered TIDs */
+			bt->buffered = false;
+			if (!skb_queue_empty(&bt->retry_q))
+				ieee80211_schedule_txq(wl->hw, txq);
+		} else if (resleep) {
+			bt->buffered = false;
+			b43_txq_report(txq, bt, true);
+		}
+	}
+	if (asleep && n)
+		b43_txq_ps_release(wl, sta, bsta, n);
+}
+
+/*
+ * Pull model: take one aggregate (or two single frames) from the next txq that
+ * mac80211's scheduler hands out, only while the hardware has room and the
+ * driver queue is empty, so the stations take turns per aggregate instead of
+ * waiting behind one shared queue.
+ */
+static void b43_txq_resend(struct b43_wldev *dev, int ac)
+{
+	struct b43_wl *wl = dev->wl;
+	struct b43_txq *bt, *tmp;
+	struct sk_buff *skb;
+	int n;
+
+	list_for_each_entry_safe(bt, tmp, &wl->txq_retry[ac], retry_list) {
+		struct ieee80211_txq *txq = bt->txq;
+
+		if (skb_queue_empty(&bt->retry_q)) {
+			list_del_init(&bt->retry_list);
+			continue;
+		}
+		if (!skb_queue_empty(&wl->tx_queue[ac]) ||
+		    b43_dma_tx_ampdu_room(dev, ac) <= 0)
+			break;
+		/* scheduled by mac80211 as usual, or a dozing station */
+		if (ieee80211_txq_airtime_check(wl->hw, txq) ||
+		    (txq->sta &&
+		     READ_ONCE(((struct b43_sta *)txq->sta->drv_priv)->asleep)))
+			continue;
+		for (n = 0; n < min3(b43_dma_tx_ampdu_room(dev, ac),
+				     B43_AMPDU_MAX_FRAMES,
