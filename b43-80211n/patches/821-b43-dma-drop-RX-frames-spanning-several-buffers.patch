From: Erik Conijn <egc112@msn.com>
Subject: b43: dma: drop RX frames spanning several buffers without losing sync

When a frame is longer than one RX buffer, dma_rx() recycles the buffers
it covers, but leaves the slot pointer one past the last of them; the RX
loop then advances once more. It skips a real frame and, if that slot was
not filled yet, runs past the device's current slot: the ring never gets
back in sync, the interrupt thread spins with wl->mutex held and the
system hangs (on a Netgear R6400 even "reboot -f" blocked).

HT stations may send A-MSDUs of 3839 or 7935 bytes, and b43's RX buffer
is 2390 bytes, so these "giants" do occur. Drop them as brcmsmac does,
buffer by buffer, stop at the last buffer and never pass the device's
current slot. A length that cannot be a frame (> 8192) means the buffer
is not a frame start: drop only that buffer. After 8 such buffers in a
row the ring is out of sync; stop reading it and restart the controller.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Erik Conijn <egc112@msn.com>
---
diff --git a/drivers/net/wireless/broadcom/b43/dma.c b/drivers/net/wireless/broadcom/b43/dma.c
index d842cbd..760e91d 100644
--- a/drivers/net/wireless/broadcom/b43/dma.c
+++ b/drivers/net/wireless/broadcom/b43/dma.c
@@ -1584,7 +1584,7 @@ void b43_dma_handle_txstatus(struct b43_wldev *dev,
 	ieee80211_queue_work(dev->wl->hw, &dev->wl->tx_work);
 }
 
-static void dma_rx(struct b43_dmaring *ring, int *slot)
+static void dma_rx(struct b43_dmaring *ring, int *slot, int current_slot)
 {
 	const struct b43_dma_ops *ops = ring->ops;
 	struct b43_dmadesc_generic *desc;
@@ -1623,31 +1623,45 @@ static void dma_rx(struct b43_dmaring *ring, int *slot)
 		goto drop_recycle_buffer;
 	}
 	if (unlikely(len + ring->frameoffset > ring->rx_buffersize)) {
-		/* The data did not fit into one descriptor buffer
-		 * and is split over multiple buffers.
-		 * This should never happen, as we try to allocate buffers
-		 * big enough. So simply ignore this packet.
-		 */
-		int cnt = 0;
-		s32 tmp = len;
-
-		while (1) {
-			desc = ops->idx2desc(ring, *slot, &meta);
-			/* recycle the descriptor buffer. */
-			b43_poison_rx_buffer(ring, meta->skb);
-			sync_descbuffer_for_device(ring, meta->dmaaddr,
-						   ring->rx_buffersize);
-			*slot = next_slot(ring, *slot);
-			cnt++;
-			tmp -= ring->rx_buffersize;
-			if (tmp <= 0)
-				break;
+		if (len <= 8192) {
+			/*
+			 * A frame spanning several buffers (brcmsmac drops these
+			 * "giants" too): recycle all of them. Stock b43 left the
+			 * slot pointer one past the last buffer, so the RX loop
+			 * skipped a frame and, if that slot was not filled yet,
+			 * ran past the device's slot: the ring never got back in
+			 * sync. Stop at the last buffer and never pass the
+			 * device's current slot.
+			 */
+			int need = DIV_ROUND_UP(len + ring->frameoffset,
+						ring->rx_buffersize);
+			int cnt = 0;
+
+			while (1) {
+				desc = ops->idx2desc(ring, *slot, &meta);
+				b43_poison_rx_buffer(ring, meta->skb);
+				sync_descbuffer_for_device(ring, meta->dmaaddr,
+							   ring->rx_buffersize);
+				if (++cnt >= need ||
+				    next_slot(ring, *slot) == current_slot)
+					break;
+				*slot = next_slot(ring, *slot);
+			}
+			ring->rx_bad = 0;
+			if (net_ratelimit())
+				b43warn(ring->dev->wl, "DMA RX: %u-byte frame over %d of %d buffers dropped\n",
+					len, cnt, need);
+			return;
 		}
-		b43err(ring->dev->wl, "DMA RX buffer too small "
-		       "(len: %u, buffer: %u, nr-dropped: %d)\n",
-		       len, ring->rx_buffersize, cnt);
-		goto drop;
+		/* impossible length: this buffer is not a frame start */
+		if (!ring->rx_bad && net_ratelimit())
+			b43err(ring->dev->wl, "DMA RX: bad frame length %u (buffer %u) at slot %d\n",
+			       len, ring->rx_buffersize, *slot);
+		ring->rx_bad++;
+		dmaaddr = meta->dmaaddr;
+		goto drop_recycle_buffer;
 	}
+	ring->rx_bad = 0;
 
 	dmaaddr = meta->dmaaddr;
 	err = setup_rx_descbuffer(ring, desc, meta, GFP_ATOMIC);
@@ -1661,7 +1675,6 @@ static void dma_rx(struct b43_dmaring *ring, int *slot)
 	skb_pull(skb, ring->frameoffset);
 
 	b43_rx(ring->dev, skb, rxhdr);
-drop:
 	return;
 
 drop_recycle_buffer:
@@ -1696,13 +1709,23 @@ void b43_dma_rx(struct b43_dmaring *ring)
 	int used_slots = 0;
 
 	B43_WARN_ON(ring->tx);
+	if (unlikely(ring->rx_dead))
+		return;		/* out of sync, waiting for the controller restart */
 	current_slot = ops->get_current_rxslot(ring);
 	B43_WARN_ON(!(current_slot >= 0 && current_slot < ring->nr_slots));
 
 	slot = ring->current_slot;
 	for (; slot != current_slot; slot = next_slot(ring, slot)) {
-		dma_rx(ring, &slot);
+		dma_rx(ring, &slot, current_slot);
 		update_max_used_slots(ring, ++used_slots);
+		if (unlikely(ring->rx_bad >= 8)) {
+			ring->rx_dead = true;
+			b43err(ring->dev->wl, "DMA RX ring %d out of sync (%d bad frames in a row), restarting the controller\n",
+			       ring->index, ring->rx_bad);
+			b43_controller_restart(ring->dev, "DMA RX out of sync");
+			slot = next_slot(ring, slot);
+			break;
+		}
 	}
 	wmb();
 	ops->set_current_rxslot(ring, slot);
diff --git a/drivers/net/wireless/broadcom/b43/dma.h b/drivers/net/wireless/broadcom/b43/dma.h
index e86212b..d7f7b9f 100644
--- a/drivers/net/wireless/broadcom/b43/dma.h
+++ b/drivers/net/wireless/broadcom/b43/dma.h
@@ -258,6 +258,9 @@ struct b43_dmaring {
 	/* The QOS priority assigned to this ring. Only used for TX rings.
 	 * This is the mac80211 "queue" value. */
 	u8 queue_prio;
+	/* RX: bad frame lengths in a row; ring given up until the restart */
+	int rx_bad;
+	bool rx_dead;
 	struct b43_wldev *dev;
 #ifdef CPTCFG_B43_DEBUG
 	/* Maximum number of used slots. */
