From: Erik Conijn <egc112@msn.com>
Subject: b43: HT-PHY: RTS/CTS in front of A-MPDUs

Protect aggregates with RTS/CTS as brcms_c_ampdu_finalize() does: the
first MPDU keeps SENDRTS and the RTS NAV (and its fallback) covers the
CTS, the whole A-MPDU and the block ack (brcms_c_compute_rtscts_dur with
ba = true). b43_generate_txhdr() builds the RTS when the first frame asks
for USE_RTS_CTS.

For MCS frames mac80211 leaves rts_cts_rate_idx at 0, i.e. 1 Mbit/s CCK,
which is not even a supported rate in an OFDM-only BSS and makes RTS plus
CTS cost ~680 us; use the fastest basic OFDM rate up to 24 Mbit/s
instead, as brcms_c_rspec_to_rts_rspec maps MCS rates to OFDM.

Module parameter ampdu_rts: -1 (default) RTS only when an aggregate
starts with a re-send, i.e. repeats an attempt that got no block ack (as
minstrel protects its retry stages); 1 always; N > 1 from N bytes on; 0
never. With a client uploading at full speed ~41-47 % of the router's
aggregates (the TCP ACKs) collided and 600-700 frames per 20 s were given
up; with -1: 0 given up, same throughput, the router keeps its share in
bidirectional traffic (RTS always costs it ~10 %).

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Erik Conijn <egc112@msn.com>
---
diff --git a/drivers/net/wireless/broadcom/b43/main.c b/drivers/net/wireless/broadcom/b43/main.c
index 8bdcf2d..4a344cd 100644
--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -126,6 +126,13 @@ MODULE_PARM_DESC(ht_tx_ampdu, "HT-PHY: A-MPDU TX aggregation (1, default) or non
 
 static const struct file_operations b43_ampdu_stats_fops;
 
+/* RTS/CTS in front of A-MPDUs: -1 only when an aggregate starts with a
+ * re-send (as minstrel protects its retry stages), 1 always, N > 1 for
+ * aggregates of at least N bytes, 0 never */
+int b43_ampdu_rts = -1;
+module_param_named(ampdu_rts, b43_ampdu_rts, int, 0644);
+MODULE_PARM_DESC(ampdu_rts, "HT-PHY A-MPDU TX: RTS/CTS in front of aggregates: -1 (default) when the aggregate starts with a re-send, 1 always, N > 1 from N bytes on, 0 never");
+
 /* A-MPDUs per ring handed to the hardware before waiting for a TX status */
 int b43_ampdu_inflight = 2;
 module_param_named(ampdu_inflight, b43_ampdu_inflight, int, 0644);
@@ -3803,7 +3810,7 @@ static int b43_tx_ampdu(struct b43_wldev *dev, int queue_num)
 	u8 tid;
 	u8 ra[ETH_ALEN];
 	int n = 0, room;
-	bool blocked = false;
+	bool blocked = false, first_resend = false;
 
 	if (!skb)
 		return 0;
@@ -3874,6 +3881,8 @@ static int b43_tx_ampdu(struct b43_wldev *dev, int queue_num)
 		if (n && len + roundup(flen, 4) + 4 > max_len)
 			break;
 		len += roundup(flen, 4) + 4;
+		if (!n && bsta)
+			first_resend = bsta->ampdu_txretry[tid][sn % B43_AMPDU_BA_WSIZE] > 0;
 		if (bsta)
 			b43_baw_add(bsta, tid, sn);
 		skbs[n++] = skb_dequeue(q);
@@ -3883,6 +3892,13 @@ static int b43_tx_ampdu(struct b43_wldev *dev, int queue_num)
 		/* window full: wait for the TX status of the frames in
 		 * flight; otherwise everything queued was given up */
 		return blocked ? -ENOSPC : 0;
+	/* b43_generate_txhdr builds the RTS, the fix-up stretches its NAV;
+	 * -1: only to repeat an aggregate that got no block ack (re-sends go
+	 * to the head of the queue), as minstrel uses RTS on retry stages */
+	if ((b43_ampdu_rts > 0 && len >= b43_ampdu_rts) ||
+	    (b43_ampdu_rts < 0 && first_resend))
+		IEEE80211_SKB_CB(skbs[0])->control.rates[0].flags |=
+			IEEE80211_TX_RC_USE_RTS_CTS;
 	b43_dma_tx_ampdu(dev, skbs, n);
 	return 0;
 }
diff --git a/drivers/net/wireless/broadcom/b43/xmit.c b/drivers/net/wireless/broadcom/b43/xmit.c
index c33b179..217f0b0 100644
--- a/drivers/net/wireless/broadcom/b43/xmit.c
+++ b/drivers/net/wireless/broadcom/b43/xmit.c
@@ -263,6 +263,80 @@ bool b43_ht_ampdu_rate_ok(struct b43_wldev *dev,
 	       b43_ht_rate(dev, &info->control.rates[0]);
 }
 
+/*
+ * RTS/CTS rate for an MCS frame: mac80211 leaves rts_cts_rate_idx at 0
+ * (1 Mbit/s CCK, here not even a supported rate), which makes the RTS and
+ * the CTS answer cost ~680 us. Use the fastest basic OFDM rate up to
+ * 24 Mbit/s, as brcms_c_rspec_to_rts_rspec maps MCS rates to OFDM.
+ */
+static struct ieee80211_rate *b43_ht_rts_rate(struct b43_wldev *dev,
+					      struct ieee80211_tx_info *info)
+{
+	struct ieee80211_supported_band *sband =
+		dev->wl->hw->wiphy->bands[NL80211_BAND_2GHZ];
+	struct ieee80211_vif *vif = info->control.vif;
+	u32 basic = vif ? vif->bss_conf.basic_rates : 0;
+	struct ieee80211_rate *best = NULL;
+	int i;
+
+	if (!sband)
+		return NULL;
+	for (i = 0; i < sband->n_bitrates; i++) {
+		struct ieee80211_rate *r = &sband->bitrates[i];
+
+		if (!(basic & BIT(i)) || !b43_is_ofdm_rate(r->hw_value) ||
+		    r->bitrate > 240)
+			continue;
+		if (!best || r->bitrate > best->bitrate)
+			best = r;
+	}
+	return best;
+}
+
+/* OFDM PLCP rate code -> Mbit/s */
+static const u8 b43_ofdm_code_mbps[16] = {
+	[0xB] = 6, [0xF] = 9, [0xA] = 12, [0xE] = 18,
+	[0x9] = 24, [0xD] = 36, [0x8] = 48, [0xC] = 54,
+};
+
+/* Airtime of a legacy control frame (bytes incl. FCS) at the rate of an
+ * RTS PLCP header: OFDM with 6 us signal extension, CCK with the long
+ * preamble (the worst case); a CCK PLCP rate byte is in 100 kbit/s. */
+static unsigned int b43_ctl_us(const struct b43_plcp_hdr6 *plcp, bool ofdm,
+			       unsigned int bytes)
+{
+	if (ofdm) {
+		unsigned int mbps = b43_ofdm_code_mbps[plcp->raw[0] & 0xf] ?: 6;
+
+		return 20 + DIV_ROUND_UP(16 + 8 * bytes + 6, mbps * 4) * 4 + 6;
+	}
+	return 192 + DIV_ROUND_UP(bytes * 8 * 10, plcp->raw[0] ?: 10);
+}
+
+/* Airtime of an HT mixed-mode PPDU, one stream, 20 MHz: L-STF, L-LTF,
+ * L-SIG, HT-SIG, HT-STF and one HT-LTF (36 us), the data symbols (3.6 us
+ * with the short GI) and the 6 us signal extension */
+static unsigned int b43_ht_ppdu_us(u8 mcs, bool sgi, unsigned int len)
+{
+	unsigned int ndbps = b43_ht_mcs_kbps20[mcs & 7] / 250;
+	unsigned int nsym = DIV_ROUND_UP(16 + 8 * len + 6, ndbps);
+
+	return 36 + (sgi ? DIV_ROUND_UP(nsym * 36, 10) : nsym * 4) + 6;
+}
+
+#define B43_SIFS_US	10
+#define B43_BA_US	74	/* compressed BA (32 bytes) at 6 Mbit/s, the slowest answer */
+
+/* NAV of an RTS in front of an A-MPDU (brcms_c_compute_rtscts_dur with
+ * ba = true): SIFS, CTS, SIFS, the A-MPDU, SIFS, the block ack */
+static u16 b43_ampdu_rts_dur(const struct b43_plcp_hdr6 *rts_plcp, bool ofdm,
+			     const u8 *plcp, unsigned int ampdu_len)
+{
+	return 3 * B43_SIFS_US + b43_ctl_us(rts_plcp, ofdm, 14) +
+	       b43_ht_ppdu_us(plcp[0], plcp[3] & B43_HT_PLCP3_SGI, ampdu_len) +
+	       B43_BA_US;
+}
+
 /*
  * Turn the TX headers of n consecutive MPDUs into one A-MPDU, after
  * brcmsmac's brcms_c_ampdu_add_frame() and brcms_c_ampdu_finalize(): mark
@@ -276,6 +350,7 @@ void b43_ht_ampdu_fixup(struct b43_wldev *dev, struct b43_txhdr **hdrs, int n)
 {
 	unsigned int ampdu_len = 0, len = 0;
 	struct b43_txhdr *first = hdrs[0];
+	bool first_rts = false;
 	u8 *plcp;
 	u32 mac_ctl;
 	int i;
@@ -286,6 +361,8 @@ void b43_ht_ampdu_fixup(struct b43_wldev *dev, struct b43_txhdr **hdrs, int n)
 		ampdu_len += roundup(len, 4) + 4;
 
 		mac_ctl = le32_to_cpu(hdrs[i]->mac_ctl);
+		if (i == 0)
+			first_rts = mac_ctl & B43_TXH_MAC_SENDRTS;
 		mac_ctl &= ~(B43_TXH_MAC_AMPDU | B43_TXH_MAC_STMSDU |
 			     B43_TXH_MAC_SENDRTS | B43_TXH_MAC_SENDCTS |
 			     B43_TXH_MAC_USEFBR);
@@ -313,6 +390,25 @@ void b43_ht_ampdu_fixup(struct b43_wldev *dev, struct b43_txhdr **hdrs, int n)
 		cpu_to_le16(b43_ht_lsig_len(first->plcp_fb.raw[0], ampdu_len,
 					    first->plcp_fb.raw[3] & B43_HT_PLCP3_SGI));
 
+	/* ampdu_rts: the RTS b43_generate_txhdr built for the first frame
+	 * protects the whole aggregate (brcms_c_ampdu_finalize) */
+	if (first_rts && dev->fw.hdr_format == B43_FW_HDR_598) {
+		struct ieee80211_rts *rts =
+			(struct ieee80211_rts *)first->format_598.rts_frame;
+		u8 eft = first->extra_ft;
+
+		if (ieee80211_is_rts(rts->frame_control)) {
+			first->mac_ctl |= cpu_to_le32(B43_TXH_MAC_SENDRTS);
+			rts->duration = cpu_to_le16(b43_ampdu_rts_dur(
+				&first->format_598.rts_plcp,
+				(eft & B43_TXH_EFT_RTS) == B43_TXH_EFT_RTS_OFDM,
+				plcp, ampdu_len));
+			first->rts_dur_fb = cpu_to_le16(b43_ampdu_rts_dur(
+				&first->rts_plcp_fb,
+				(eft & B43_TXH_EFT_RTSFB) == B43_TXH_EFT_RTSFB_OFDM,
+				first->plcp_fb.raw, ampdu_len));
+		}
+	}
 }
 
 static u8 b43_calc_fallback_rate(u8 bitrate, int gmode)
@@ -601,6 +697,12 @@ int b43_generate_txhdr(struct b43_wldev *dev,
 		struct ieee80211_rate *rts_cts_rate;
 
 		rts_cts_rate = ieee80211_get_rts_cts_rate(dev->wl->hw, info);
+		if (b43_ht_rate(dev, &rates[0])) {
+			struct ieee80211_rate *ht_rts = b43_ht_rts_rate(dev, info);
+
+			if (ht_rts)
+				rts_cts_rate = ht_rts;
+		}
 
 		rts_rate = rts_cts_rate ? rts_cts_rate->hw_value : B43_CCK_RATE_1MB;
 		rts_rate_ofdm = b43_is_ofdm_rate(rts_rate);
