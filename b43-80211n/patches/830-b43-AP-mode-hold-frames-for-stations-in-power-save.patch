+/*
+ * AP power save. mac80211 buffers new frames for a dozing station itself,
+ * but frames already handed to the driver would go to a station that does
+ * not listen, and mac80211 frees A-MPDU frames given back as filtered. So
+ * they wait in the station's psq: mac80211 learns which TIDs hold frames
+ * (TIM bit), they go back to the head of the TX queue when the station
+ * wakes, and single frames go out for a PS-Poll or uAPSD trigger. Queue
+ * heads are only changed with wl->mutex held (TX work, TX status).
+ */
+
+/* The station of an AP unicast frame if it dozes (RCU read side) */
+bool b43_ps_asleep(struct b43_wl *wl, struct sk_buff *skb,
+		   struct ieee80211_sta **psta)
+{
+	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+	struct ieee80211_sta *sta;
+
+	if (!atomic_read(&wl->ps_dozing) || !wl->vif ||
+	    wl->vif->type != NL80211_IFTYPE_AP ||
+	    is_multicast_ether_addr(hdr->addr1))
+		return false;
+	sta = ieee80211_find_sta(wl->vif, hdr->addr1);
+	if (!sta || !READ_ONCE(((struct b43_sta *)sta->drv_priv)->asleep))
+		return false;
+	*psta = sta;
+	return true;
+}
+
+static u8 b43_ps_tid(struct sk_buff *skb)
+{
+	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+
+	return ieee80211_is_data_qos(hdr->frame_control) ?
+	       ieee80211_get_tid(hdr) : 0;
+}
+
+static u16 b43_ps_queued_tids(struct b43_sta *bsta)
+{
+	struct sk_buff *skb;
+	u16 tids = 0;
+
+	skb_queue_walk(&bsta->psq, skb)
+		tids |= BIT(b43_ps_tid(skb));
+	return tids;
+}
+
+/* Tell mac80211 which TIDs hold frames, for the TIM bit */
+static void b43_ps_report_tids(struct ieee80211_sta *sta, struct b43_sta *bsta)
+{
+	u16 tids = b43_ps_queued_tids(bsta), change = tids ^ bsta->ps_tids;
+	int tid;
+
+	for (tid = 0; change >> tid; tid++)
+		if (change & BIT(tid))
+			ieee80211_sta_set_buffered(sta, tid, tids & BIT(tid));
+	bsta->ps_tids = tids;
+}
+
+/* Hold a frame for a dozing station (wl->mutex held, RCU read side) */
+void b43_ps_hold(struct b43_wl *wl, struct ieee80211_sta *sta,
+		 struct sk_buff *skb)
+{
+	struct b43_sta *bsta = (struct b43_sta *)sta->drv_priv;
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+
+	/* a released frame that found the station asleep again: its
+	 * service period is over */
+	if (info->flags & IEEE80211_TX_STATUS_EOSP)
+		ieee80211_sta_eosp(sta);
+	info->flags &= ~(IEEE80211_TX_CTL_NO_PS_BUFFER |
+			 IEEE80211_TX_STATUS_EOSP);
+	hdr->frame_control &= ~cpu_to_le16(IEEE80211_FCTL_MOREDATA);
+	if (ieee80211_is_data_qos(hdr->frame_control))
+		*ieee80211_get_qos_ctl(hdr) &= ~IEEE80211_QOS_CTL_EOSP;
+	/* the bounce buffer pointer shares the vif's slot */
+	info->control.vif = wl->vif;
+
+	if (list_empty(&bsta->ps_list))
+		list_add_tail(&bsta->ps_list, &wl->ps_stas);
+	skb_queue_tail(&bsta->psq, skb);
+	wl->ampdu_stats.ps_held++;
+	if (!(bsta->ps_tids & BIT(b43_ps_tid(skb)))) {
+		bsta->ps_tids |= BIT(b43_ps_tid(skb));
+		ieee80211_sta_set_buffered(sta, b43_ps_tid(skb), true);
+	}
+}
+
+/* Put frames back at the head of their TX queues, keeping their order */
+static void b43_ps_requeue(struct b43_wl *wl, struct sk_buff_head *list)
+{
+	struct sk_buff *skb;
+
+	while ((skb = __skb_dequeue_tail(list)))
+		skb_queue_head(&wl->tx_queue[skb_get_queue_mapping(skb)], skb);
+}
+
+/* Release up to n held frames for a PS-Poll (one) or a uAPSD trigger */
+static void b43_ps_release(struct b43_wl *wl, struct ieee80211_sta *sta,
+			   struct b43_sta *bsta, int n)
+{
+	struct sk_buff_head rel;
+	struct sk_buff *skb, *tmp;
+	bool uapsd = bsta->ps_release_uapsd;
+
+	__skb_queue_head_init(&rel);
+	skb_queue_walk_safe(&bsta->psq, skb, tmp) {
+		if (skb_queue_len(&rel) >= n)
+			break;
+		if (!(bsta->ps_release_tids & BIT(b43_ps_tid(skb))))
+			continue;
+		skb_unlink(skb, &bsta->psq);
+		__skb_queue_tail(&rel, skb);
+	}
+	if (skb_queue_empty(&rel)) {
+		/* nothing left: end the service period */
+		ieee80211_sta_eosp(sta);
+		return;
+	}
+	skb_queue_walk(&rel, skb) {
+		struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+		struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+		bool last = skb_queue_is_last(&rel, skb);
+
+		info->flags |= IEEE80211_TX_CTL_NO_PS_BUFFER;
+		if (!last || !skb_queue_empty(&bsta->psq) ||
+		    bsta->ps_release_more)
+			hdr->frame_control |=
+				cpu_to_le16(IEEE80211_FCTL_MOREDATA);
+		if (!last)
+			continue;
+		info->flags |= IEEE80211_TX_STATUS_EOSP |
+			       IEEE80211_TX_CTL_REQ_TX_STATUS;
+		if (uapsd && ieee80211_is_data_qos(hdr->frame_control))
+			*ieee80211_get_qos_ctl(hdr) |= IEEE80211_QOS_CTL_EOSP;
+	}
+	wl->ampdu_stats.ps_released += skb_queue_len(&rel);
+	b43_ps_requeue(wl, &rel);
+	b43_ps_report_tids(sta, bsta);
+}
+
+/* Wake-ups and releases (TX work, wl->mutex held) */
+static void b43_ps_work(struct b43_wl *wl)
+{
+	struct b43_sta *bsta, *tmp;
+
+	rcu_read_lock();
+	list_for_each_entry_safe(bsta, tmp, &wl->ps_stas, ps_list) {
+		struct ieee80211_sta *sta =
+			container_of((void *)bsta, struct ieee80211_sta,
+				     drv_priv);
+		int n;
+
+		if (!READ_ONCE(bsta->asleep)) {
+			/* awake: the held frames go out before what
+			 * mac80211 buffered meanwhile */
+			wl->ampdu_stats.ps_resumed += skb_queue_len(&bsta->psq);
+			b43_ps_requeue(wl, &bsta->psq);
+			bsta->ps_tids = 0;
+			list_del_init(&bsta->ps_list);
+			continue;
+		}
+		if (xchg(&bsta->ps_resleep, 0)) {
+			/* mac80211 forgot the buffered TIDs when it woke */
+			bsta->ps_tids = 0;
+			b43_ps_report_tids(sta, bsta);
+		}
+		n = xchg(&bsta->ps_release, 0);
+		if (n)
+			b43_ps_release(wl, sta, bsta, n);
+		if (skb_queue_empty(&bsta->psq))
+			list_del_init(&bsta->ps_list);
+	}
+	rcu_read_unlock();
+}
+
+/* Hold the frame at the queue head if its station dozes (wl->mutex held) */
+static bool b43_ps_check(struct b43_wl *wl, struct sk_buff_head *q,
+			 struct sk_buff *skb)
+{
+	struct ieee80211_sta *sta;
+	bool held = false;
+
+	if (IEEE80211_SKB_CB(skb)->flags & IEEE80211_TX_CTL_NO_PS_BUFFER)
+		return false;
+	rcu_read_lock();
+	if (b43_ps_asleep(wl, skb, &sta)) {
+		b43_ps_hold(wl, sta, skb_dequeue(q));
+		held = true;
+	}
+	rcu_read_unlock();
+	return held;
+}
+
 static void b43_tx_work(struct work_struct *work)
 {
 	struct b43_wl *wl = container_of(work, struct b43_wl, tx_work);
@@ -4017,8 +4217,13 @@ static void b43_tx_work(struct work_struct *work)
 		return;
 	}
 
+	if (!list_empty(&wl->ps_stas))
+		b43_ps_work(wl);
 	for (queue_num = 0; queue_num < B43_QOS_QUEUE_NUM; queue_num++) {
 		while ((skb = b43_txq_peek(&wl->tx_queue[queue_num]))) {
+			if (unlikely(atomic_read(&wl->ps_dozing)) &&
+			    b43_ps_check(wl, &wl->tx_queue[queue_num], skb))
+				continue;
 			if (dev->ht_tx_ampdu &&
 			    (IEEE80211_SKB_CB(skb)->flags & IEEE80211_TX_CTL_AMPDU) &&
 			    ieee80211_is_data_qos(((struct ieee80211_hdr *)skb->data)->frame_control) &&
@@ -5574,8 +5779,78 @@ static void b43_op_sta_notify(struct ieee80211_hw *hw,
 			      struct ieee80211_sta *sta)
 {
 	struct b43_wl *wl = hw_to_b43_wl(hw);
+	struct b43_sta *bsta = (struct b43_sta *)sta->drv_priv;
 
 	B43_WARN_ON(!vif || wl->vif != vif);
+	/* atomic context: flag only, the TX work moves the frames */
+	if (!bsta->ps_init)
+		return;
+	switch (notify_cmd) {
+	case STA_NOTIFY_SLEEP:
+		if (!bsta->asleep)
+			atomic_inc(&wl->ps_dozing);
+		WRITE_ONCE(bsta->ps_resleep, 1);
+		WRITE_ONCE(bsta->asleep, true);
+		break;
+	case STA_NOTIFY_AWAKE:
+		if (bsta->asleep)
+			atomic_dec(&wl->ps_dozing);
+		WRITE_ONCE(bsta->asleep, false);
+		break;
+	}
+	ieee80211_queue_work(hw, &wl->tx_work);
+}
+
+static void b43_op_release_buffered_frames(struct ieee80211_hw *hw,
+					   struct ieee80211_sta *sta,
+					   u16 tids, int num_frames,
+					   enum ieee80211_frame_release_type reason,
+					   bool more_data)
+{
+	struct b43_wl *wl = hw_to_b43_wl(hw);
+	struct b43_sta *bsta = (struct b43_sta *)sta->drv_priv;
+
+	if (!bsta->ps_init || skb_queue_empty_lockless(&bsta->psq)) {
+		ieee80211_sta_eosp(sta);
+		return;
+	}
+	bsta->ps_release_tids = tids;
+	bsta->ps_release_uapsd = reason == IEEE80211_FRAME_RELEASE_UAPSD;
+	bsta->ps_release_more = more_data;
+	/* pairs with the xchg() in b43_ps_work() */
+	smp_store_release(&bsta->ps_release, num_frames);
+	ieee80211_queue_work(hw, &wl->tx_work);
+}
+
+static int b43_op_sta_add(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+			  struct ieee80211_sta *sta)
+{
+	struct b43_sta *bsta = (struct b43_sta *)sta->drv_priv;
+
+	/* added again by a mac80211 reconfiguration: keep the state */
+	if (bsta->ps_init)
+		return 0;
+	skb_queue_head_init(&bsta->psq);
+	INIT_LIST_HEAD(&bsta->ps_list);
+	bsta->ps_init = true;
+	return 0;
+}
+
+static int b43_op_sta_remove(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+			     struct ieee80211_sta *sta)
+{
+	struct b43_wl *wl = hw_to_b43_wl(hw);
+	struct b43_sta *bsta = (struct b43_sta *)sta->drv_priv;
+
+	mutex_lock(&wl->mutex);
+	if (bsta->asleep)
+		atomic_dec(&wl->ps_dozing);
+	bsta->asleep = false;
+	bsta->ps_init = false;
+	list_del_init(&bsta->ps_list);
+	ieee80211_purge_tx_queue(hw, &bsta->psq);
+	mutex_unlock(&wl->mutex);
+	return 0;
 }
 
 static void b43_op_sw_scan_start_notifier(struct ieee80211_hw *hw,
@@ -5742,6 +6017,9 @@ static const struct ieee80211_ops b43_hw_ops = {
 	.stop			= b43_op_stop,
 	.set_tim		= b43_op_beacon_set_tim,
 	.sta_notify		= b43_op_sta_notify,
+	.release_buffered_frames = b43_op_release_buffered_frames,
+	.sta_add		= b43_op_sta_add,
+	.sta_remove		= b43_op_sta_remove,
 	.sw_scan_start		= b43_op_sw_scan_start_notifier,
 	.sw_scan_complete	= b43_op_sw_scan_complete_notifier,
 	.get_survey		= b43_op_get_survey,
@@ -6175,6 +6453,7 @@ static struct b43_wl *b43_wireless_init(struct b43_bus_dev *dev)
 		skb_queue_head_init(&wl->tx_queue[queue_num]);
 		wl->tx_queue_stopped[queue_num] = false;
 	}
+	INIT_LIST_HEAD(&wl->ps_stas);
 
 	snprintf(chip_name, ARRAY_SIZE(chip_name),
 		 (dev->chip_id > 0x9999) ? "%d" : "%04X", dev->chip_id);
