diff --git a/drivers/net/wireless/broadcom/b43/xmit.h b/drivers/net/wireless/broadcom/b43/xmit.h
index b162712..5c509a0 100644
--- a/drivers/net/wireless/broadcom/b43/xmit.h
+++ b/drivers/net/wireless/broadcom/b43/xmit.h
@@ -237,6 +237,21 @@ struct b43_sta {
 	u16 baw_start[IEEE80211_NUM_TIDS];
 	u64 baw_map[IEEE80211_NUM_TIDS];
 	bool baw_valid[IEEE80211_NUM_TIDS];
+	/* AP power save: while the station dozes its frames wait in psq
+	 * (mac80211 frees A-MPDU frames that come back filtered); the
+	 * station is on wl->ps_stas while psq holds frames. asleep and
+	 * ps_release are set from sta_notify/release_buffered_frames, which
+	 * run in atomic context; the TX work does the queue handling. */
+	bool ps_init;			/* psq/ps_list set up (sta_add) */
+	bool asleep;
+	int ps_resleep;			/* dozed again: report the TIDs anew */
+	u16 ps_tids;			/* TIDs reported to mac80211 as buffered */
+	int ps_release;			/* frames to release (PS-Poll/uAPSD) */
+	u16 ps_release_tids;
+	bool ps_release_uapsd;
+	bool ps_release_more;
+	struct sk_buff_head psq;
+	struct list_head ps_list;
 };
 
 /*
