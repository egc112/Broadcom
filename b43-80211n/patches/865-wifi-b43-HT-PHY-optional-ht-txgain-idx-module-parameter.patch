From e7888c9202cc1f16a1df9be579d2f78178ab88f8 Mon Sep 17 00:00:00 2001
From: Erik Conijn <egc112@msn.com>
Date: Sun, 25 Oct 2026 14:16:01 +0100
Subject: [PATCH] wifi: b43: HT-PHY: optional ht_txgain_idx module parameter

On boards with an external front end the HT-PHY uses a static TX gain
index instead of the TX power control loop: 24 with BFL_HGPA, else 16.
Add the ht_txgain_idx module parameter to override that choice, e.g. a
higher index for less power at close range: 0..127 selects the index,
-1 the TX power control loop and -2 (the default) the automatic choice.
A lower index than the automatic one gives more power than the board
was measured with; stay at or above it. The value is taken at the next
PHY init (wifi restart).

For our own builds; not meant for upstream, which does not want new
module parameters.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Erik Conijn <egc112@msn.com>
---
 drivers/net/wireless/broadcom/b43/phy_ht.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/net/wireless/broadcom/b43/phy_ht.c b/drivers/net/wireless/broadcom/b43/phy_ht.c
index f7fc178..53afd23 100644
--- a/drivers/net/wireless/broadcom/b43/phy_ht.c
+++ b/drivers/net/wireless/broadcom/b43/phy_ht.c
@@ -39,11 +39,19 @@ static bool b43_phy_ht_ext_fem(struct b43_wldev *dev)
  * Use 24 with BFL_HGPA, else 16, i.e. about four steps above the measured
  * edge on both boards. Elsewhere the loop stays on: on an Apple BCM4331
  * card, with an external PA but neither flag, it holds the SPROM target
- * power.
+ * power. The ht_txgain_idx module parameter overrides the choice, e.g. a
+ * higher index for less power at close range; it takes effect at the next
+ * PHY init (wifi restart).
  */
+static int modparam_ht_txgain_idx = -2;
+module_param_named(ht_txgain_idx, modparam_ht_txgain_idx, int, 0644);
+MODULE_PARM_DESC(ht_txgain_idx, "HT-PHY: static TX gain index 0..127 instead of the TX power control loop; -2 = automatic (default), -1 = power control loop");
+
 static int b43_phy_ht_txgain_idx(struct b43_wldev *dev)
 {
-	if (!b43_phy_ht_ext_fem(dev))
+	if (modparam_ht_txgain_idx >= 0 && modparam_ht_txgain_idx < 128)
+		return modparam_ht_txgain_idx;
+	if (modparam_ht_txgain_idx == -1 || !b43_phy_ht_ext_fem(dev))
 		return -1;
 
 	return (dev->dev->bus_sprom->boardflags_lo & B43_BFL_HGPA) ? 24 : 16;
