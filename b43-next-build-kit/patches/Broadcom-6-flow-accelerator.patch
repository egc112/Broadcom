++/* ---------- tables ---------- */
++
++/* OR val (width <= 32 bits) into the entry at bit pos (e[0] = bits 31:0) */
++static void fa_put_bits(u32 *e, unsigned int pos, unsigned int width, u32 val)
++{
++	u64 v = (u64)(width < 32 ? val & (BIT(width) - 1) : val) << (pos % 32);
++
++	e[pos / 32] |= lower_32_bits(v);
++	if (pos % 32 + width > 32)
++		e[pos / 32 + 1] |= upper_32_bits(v);
++}
++
++static u32 fa_get_bits(const u32 *e, unsigned int pos, unsigned int width)
++{
++	u64 v = e[pos / 32];
++
++	if (pos % 32 + width > 32)
++		v |= (u64)e[pos / 32 + 1] << 32;
++	v >>= pos % 32;
++	return width < 32 ? v & (BIT(width) - 1) : lower_32_bits(v);
++}
++
++static void fa_put_mac(u32 *e, unsigned int pos, const u8 *mac)
++{
++	u64 v = ether_addr_to_u64(mac);
++
++	fa_put_bits(e, pos, 32, lower_32_bits(v));
++	fa_put_bits(e, pos + 32, 16, upper_32_bits(v));
++}
++
++/* CTF_FA_WAR777_ON/OFF: on the A2 revision of the BCM4707 family (except
++ * BCM47094) Broadcom lowers the hardware queue threshold and waits 1 ms
++ * before it accesses a table. Here that is done once per locked operation
++ * (a flow add, removal, counter read or flush) rather than per access: the
++ * threshold stays low for all accesses in between.
++ */
++static void bgmac_fa_war777(struct bgmac *bgmac, bool on)
++{
++	u32 val;
++
++	if (!bgmac->fa->war777)
++		return;
++
++	val = fa_read(bgmac, FA_CONTROL) & ~FA_CTL_HWQ_THRESHOLD;
++	if (!on)
++		val |= FIELD_PREP(FA_CTL_HWQ_THRESHOLD, FA_HWQ_THRESHOLD_DEFAULT);
++	fa_write(bgmac, FA_CONTROL, val);
++	if (on)
++		usleep_range(1000, 1500);
++}
++
++/* fa->lock for an operation that accesses the tables */
++static void bgmac_fa_lock(struct bgmac *bgmac)
++{
++	mutex_lock(&bgmac->fa->lock);
++	bgmac_fa_war777(bgmac, true);
++}
++
++static void bgmac_fa_unlock(struct bgmac *bgmac)
++{
++	bgmac_fa_war777(bgmac, false);
++	mutex_unlock(&bgmac->fa->lock);
++}
++
++static int bgmac_fa_tbl_wait(struct bgmac *bgmac)
++{
++	u32 val;
++	int err;
++
++	err = read_poll_timeout_atomic(fa_read, val,
++				       !(val & FA_DBG_MEM_ACC_BUSY),
++				       1, 10000, false, bgmac, FA_DBG_STATUS);
++	if (err)
++		dev_err(bgmac->dev, "flow accelerator: table access timed out\n");
++	return err;
++}
++
++static int bgmac_fa_tbl_read(struct bgmac *bgmac, int tbl, int idx, u32 *d,
++			     int n)
++{
++	int i, err;
++
++	fa_write(bgmac, FA_MEM_ACC_CTL, FA_MEM_ACC_READ |
++		 FIELD_PREP(FA_MEM_ACC_TABLE, tbl) |
++		 FIELD_PREP(FA_MEM_ACC_INDEX, idx));
++	err = bgmac_fa_tbl_wait(bgmac);
++	if (!err) {
++		/* as CTF_FA_MACC_RD: one read of word 0 first, without it
++		 * the words returned lag one access behind
++		 */
++		fa_read(bgmac, FA_MEM_ACC_DATA(0));
++		for (i = n - 1; i >= 0; i--)
++			d[i] = fa_read(bgmac, FA_MEM_ACC_DATA(i));
++		err = bgmac_fa_tbl_wait(bgmac);
++	}
++
++	return err;
++}
++
++static int bgmac_fa_tbl_write(struct bgmac *bgmac, int tbl, int idx,
++			      const u32 *d, int n)
++{
++	int i, err;
++
++	fa_write(bgmac, FA_MEM_ACC_CTL, FIELD_PREP(FA_MEM_ACC_TABLE, tbl) |
++		 FIELD_PREP(FA_MEM_ACC_INDEX, idx));
++	/* word 0 last: it starts the write */
++	for (i = n - 1; i >= 0; i--)
++		fa_write(bgmac, FA_MEM_ACC_DATA(i), d[i]);
++	err = bgmac_fa_tbl_wait(bgmac);
++
++	return err;
++}
++
++/* The software hash (fa_crc_ccitt()): CRC-ITU-T over 7 zero bits, the
++ * source and destination address, a TCP bit and the source and
++ * destination port; the low 8 bits select a bucket of four entries.
++ */
++static int bgmac_fa_bucket(const struct bgmac_fa_tuple *t)
++{
++	u8 key[13] = {};
++	int i;
++
++	memcpy(&key[1], &t->sip, 4);
++	memcpy(&key[5], &t->dip, 4);
++	memcpy(&key[9], &t->sport, 2);
++	memcpy(&key[11], &t->dport, 2);
++	for (i = 0; i < 8; i++)
++		key[i] = (key[i] << 1) | (key[i + 1] >> 7);
++	key[8] = (key[8] << 1) | (t->proto == IPPROTO_TCP);
++
++	return (crc_itu_t(0, key, sizeof(key)) & 0xff) * FA_FLOW_BUCKET;
++}
++
++/* ---------- next hops and pools, shared and refcounted ---------- */
++
++static int bgmac_fa_next_hop_get(struct bgmac *bgmac, const u8 *mac,
++				 struct dsa_port *dp)
++{
++	struct bgmac_fa *fa = bgmac->fa;
++	struct bgmac_fa_next_hop *nh;
++	u32 d[FA_NEXT_HOP_WORDS] = {};
++	int i, free = -1, err;
++
++	for (i = 0; i < FA_NEXT_HOPS; i++) {
++		nh = &fa->next_hop[i];
++		if (nh->refs && nh->dp == dp && ether_addr_equal(nh->mac, mac)) {
++			nh->refs++;
++			return i;
++		}
++		if (!nh->refs && free < 0)
++			free = i;
++	}
++	if (free < 0)
++		return -ENOSPC;
++
++	/* Ethernet, no tag, destination address */
++	fa_put_bits(d, FA_NH_TAG_OP, 2, FA_NH_TAG_NONE);
++	fa_put_mac(d, FA_NH_DA, mac);
++	err = bgmac_fa_tbl_write(bgmac, FA_TBL_NEXT_HOP, free, d,
++				 FA_NEXT_HOP_WORDS);
++	if (err)
++		return err;
++
++	nh = &fa->next_hop[free];
++	ether_addr_copy(nh->mac, mac);
++	nh->dp = dp;
++	nh->refs = 1;
++	nh->fdb = false;
++
++	/* The FA hands its output to the switch with a tag that leaves the
++	 * forwarding to the switch's address table. DSA keeps learning off
++	 * on standalone ports, so without an entry for the next hop the
++	 * switch floods the frame to all ports of the VLAN.
++	 */
++	if (!dsa_port_bridge_dev_get(dp) && dp->ds->ops->port_fdb_add) {
++		struct dsa_db db = { .type = DSA_DB_PORT, .dp = dp };
++
++		err = dp->ds->ops->port_fdb_add(dp->ds, dp->index, mac, 0, db);
++		if (err)
++			netdev_warn(bgmac->net_dev,
++				    "flow accelerator: no switch FDB entry for %pM on port %d: %d\n",
++				    mac, dp->index, err);
++		else
++			nh->fdb = true;
++	}
++
++	return free;
++}
++
++static void bgmac_fa_next_hop_put(struct bgmac *bgmac, int i)
++{
++	struct bgmac_fa_next_hop *nh = &bgmac->fa->next_hop[i];
++	u32 d[FA_NEXT_HOP_WORDS] = {};
++
++	if (--nh->refs)
++		return;
++
++	bgmac_fa_tbl_write(bgmac, FA_TBL_NEXT_HOP, i, d, FA_NEXT_HOP_WORDS);
++	if (nh->fdb) {
++		struct dsa_port *dp = nh->dp;
++		struct dsa_db db = { .type = DSA_DB_PORT, .dp = dp };
++
++		dp->ds->ops->port_fdb_del(dp->ds, dp->index, nh->mac, 0, db);
++		nh->fdb = false;
++	}
++	nh->dp = NULL;
++}
++
++static int bgmac_fa_pool_get(struct bgmac *bgmac, const u8 *mac, bool external)
++{
++	struct bgmac_fa *fa = bgmac->fa;
++	struct bgmac_fa_pool *pool;
++	u32 d[FA_POOL_WORDS] = {};
++	int i, free = -1, err;
++
++	for (i = 0; i < FA_POOLS; i++) {
++		pool = &fa->pool[i];
++		if (pool->refs && pool->external == external &&
++		    ether_addr_equal(pool->mac, mac)) {
++			pool->refs++;
++			return i;
++		}
++		if (!pool->refs && free < 0)
++			free = i;
++	}
++	if (free < 0)
++		return -ENOSPC;
++
++	fa_put_bits(d, FA_POOL_EXTERNAL, 1, external);
++	fa_put_mac(d, FA_POOL_SA, mac);
++	err = bgmac_fa_tbl_write(bgmac, FA_TBL_POOL, free, d, FA_POOL_WORDS);
++	if (err)
++		return err;
++
++	pool = &fa->pool[free];
++	ether_addr_copy(pool->mac, mac);
++	pool->external = external;
++	pool->refs = 1;
++
++	return free;
++}
++
++static void bgmac_fa_pool_put(struct bgmac *bgmac, int i)
++{
++	u32 d[FA_POOL_WORDS] = {};
++
++	if (--bgmac->fa->pool[i].refs)
++		return;
++
++	bgmac_fa_tbl_write(bgmac, FA_TBL_POOL, i, d, FA_POOL_WORDS);
++}
++
++/* ---------- flow_rule parsing ---------- */
++
++struct bgmac_fa_rule {
++	struct bgmac_fa_tuple t;
++	u8 eth[2 * ETH_ALEN];		/* destination, source after the mangles */
++	__be32 nat_ip;
++	__be16 nat_port;
++	bool snat, dnat;		/* neither: routing only */
++	struct dsa_port *out;
++};
++
++/* a user port of the switch behind this conduit */
++static struct dsa_port *bgmac_fa_user_port(struct bgmac *bgmac,
++					   const struct net_device *dev)
++{
++#if IS_ENABLED(CONFIG_NET_DSA)
++	struct dsa_port *cpu_dp = bgmac->net_dev->dsa_ptr;
++	struct dsa_port *dp;
++
++	if (!dev || !netdev_uses_dsa(bgmac->net_dev))
++		return NULL;
++
++	list_for_each_entry(dp, &cpu_dp->dst->ports, list)
++		if (dsa_port_is_user(dp) && dp->user == dev &&
++		    dp->cpu_dp == cpu_dp)
++			return dp;
++#endif
++	return NULL;
++}
++
++static void bgmac_fa_mangle_eth(const struct flow_action_entry *act, u8 *eth)
++{
++	void *dest = eth + act->mangle.offset;
++	const void *src = &act->mangle.val;
++
++	if (act->mangle.offset > 8)
++		return;
++
++	if (act->mangle.mask == 0xffff) {
++		src += 2;
++		dest += 2;
++	}
++
++	memcpy(dest, src, act->mangle.mask ? 2 : 4);
++}
++
++static int bgmac_fa_parse(struct bgmac *bgmac, struct flow_cls_offload *f,
++			  struct bgmac_fa_rule *r)
++{
++	struct flow_rule *rule = flow_cls_offload_flow_rule(f);
++	struct flow_action_entry *act;
++	bool snat_port = false, dnat_port = false;
++	struct net_device *out = NULL;
++	int i;
++
++	memset(r, 0, sizeof(*r));
++
++	if (!flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_META) ||
++	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CONTROL) ||
++	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_BASIC) ||
++	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IPV4_ADDRS) ||
++	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS) ||
++	    flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_VLAN) ||
++	    flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CVLAN))
++		return -EOPNOTSUPP;
++
++	{
++		struct flow_match_meta m;
++		struct net_device *in;
++		bool ours;
++
++		flow_rule_match_meta(rule, &m);
++		rcu_read_lock();
++		in = dev_get_by_index_rcu(&init_net, m.key->ingress_ifindex);
++		ours = bgmac_fa_user_port(bgmac, in);
++		rcu_read_unlock();
++		if (!ours)
++			return -EOPNOTSUPP;
++	}
++	{
++		struct flow_match_control m;
++
++		flow_rule_match_control(rule, &m);
++		if (m.key->addr_type != FLOW_DISSECTOR_KEY_IPV4_ADDRS ||
++		    m.mask->flags)
++			return -EOPNOTSUPP;
++	}
++	{
++		struct flow_match_basic m;
++
++		flow_rule_match_basic(rule, &m);
++		r->t.proto = m.key->ip_proto;
++		if (r->t.proto != IPPROTO_TCP && r->t.proto != IPPROTO_UDP)
++			return -EOPNOTSUPP;
++	}
++	{
++		struct flow_match_ipv4_addrs m;
++
++		flow_rule_match_ipv4_addrs(rule, &m);
++		r->t.sip = m.key->src;
++		r->t.dip = m.key->dst;
++	}
++	{
++		struct flow_match_ports m;
++
++		flow_rule_match_ports(rule, &m);
++		r->t.sport = m.key->src;
++		r->t.dport = m.key->dst;
++	}
++
++	flow_action_for_each(i, act, &rule->action) {
++		switch (act->id) {
++		case FLOW_ACTION_MANGLE:
++			switch (act->mangle.htype) {
++			case FLOW_ACT_MANGLE_HDR_TYPE_ETH:
++				bgmac_fa_mangle_eth(act, r->eth);
++				break;
++			case FLOW_ACT_MANGLE_HDR_TYPE_IP4:
++				if (act->mangle.offset == offsetof(struct iphdr, saddr))
++					r->snat = true;
++				else if (act->mangle.offset == offsetof(struct iphdr, daddr))
++					r->dnat = true;
++				else
++					return -EOPNOTSUPP;
++				r->nat_ip = (__force __be32)act->mangle.val;
++				break;
++			case FLOW_ACT_MANGLE_HDR_TYPE_TCP:
++			case FLOW_ACT_MANGLE_HDR_TYPE_UDP: {
++				u32 val = ntohl(act->mangle.val);
++
++				if (act->mangle.offset)
++					return -EOPNOTSUPP;
++				if (act->mangle.mask == ~htonl(0xffff)) {
++					dnat_port = true;
++					r->nat_port = htons(val & 0xffff);
++				} else {
++					snat_port = true;
++					r->nat_port = htons(val >> 16);
++				}
++				break;
++			}
++			default:
++				return -EOPNOTSUPP;
++			}
++			break;
++		case FLOW_ACTION_REDIRECT:
++			out = act->dev;
++			break;
++		case FLOW_ACTION_CSUM:
++		case FLOW_ACTION_PRIORITY:
++			break;
++		default:	/* VLAN, PPPoE: not supported */
++			return -EOPNOTSUPP;
++		}
++	}
++
++	/* One kind of NAT at most: the entry overwrites the source or the
++	 * destination, address and port together.
++	 */
++	if (r->snat && r->dnat)
++		return -EOPNOTSUPP;
++	if ((snat_port && !r->snat) || (dnat_port && !r->dnat))
++		return -EOPNOTSUPP;
++	if (!snat_port && !dnat_port)
++		r->nat_port = r->snat ? r->t.sport : r->t.dport;
++	if (!r->snat && !r->dnat)
++		r->nat_port = 0;
++
++	if (!is_valid_ether_addr(r->eth) ||
++	    !is_valid_ether_addr(r->eth + ETH_ALEN))
++		return -EINVAL;
++
++	r->out = bgmac_fa_user_port(bgmac, out);
++	if (!r->out)
++		return -EOPNOTSUPP;
++
++	return 0;
++}
++
++/* ---------- flows ---------- */
++
++static struct bgmac_fa_flow *bgmac_fa_flow_find(struct bgmac_fa *fa,
++						unsigned long cookie)
++{
++	struct bgmac_fa_flow *flow;
++
++	hash_for_each_possible(fa->flows, flow, node, cookie)
++		if (flow->cookie == cookie)
++			return flow;
++	return NULL;
++}
++
++static bool bgmac_fa_tuple_offloaded(struct bgmac_fa *fa,
++				     const struct bgmac_fa_tuple *t)
++{
++	struct bgmac_fa_flow *flow;
++	int bkt;
++
++	hash_for_each(fa->flows, bkt, flow, node)
++		if (flow->t.sip == t->sip && flow->t.dip == t->dip &&
++		    flow->t.sport == t->sport && flow->t.dport == t->dport &&
++		    flow->t.proto == t->proto)
++			return true;
++	return false;
++}
++
++static int bgmac_fa_free_slots(struct bgmac_fa *fa, int base)
++{
++	int i, n = 0;
++
++	for (i = 0; i < FA_FLOW_BUCKET; i++)
++		n += !test_bit(base + i, fa->used);
++	return n;
++}
++
++/* The flowtable offloads the two directions of a connection separately,
++ * and tries again only when both were refused. So refuse this direction
++ * too when the other one will not fit: then the whole connection stays in
++ * software for now, instead of one direction for good.
++ */
++static bool bgmac_fa_reply_fits(struct bgmac_fa *fa,
++				const struct bgmac_fa_rule *r, int base)
++{
++	struct bgmac_fa_tuple rt = { .proto = r->t.proto };
++	int rbase;
++
++	if (r->dnat) {		/* reply: from the NAT address and port */
++		rt.sip = r->nat_ip;
++		rt.sport = r->nat_port;
++		rt.dip = r->t.sip;
++		rt.dport = r->t.sport;
++	} else if (r->snat) {	/* reply: to the NAT address and port */
++		rt.sip = r->t.dip;
++		rt.sport = r->t.dport;
++		rt.dip = r->nat_ip;
++		rt.dport = r->nat_port;
++	} else {
++		rt.sip = r->t.dip;
++		rt.sport = r->t.dport;
++		rt.dip = r->t.sip;
++		rt.dport = r->t.sport;
++	}
++
++	if (bgmac_fa_tuple_offloaded(fa, &rt))
++		return true;
++
++	rbase = bgmac_fa_bucket(&rt);
++	return bgmac_fa_free_slots(fa, rbase) >= (rbase == base ? 2 : 1);
++}
++
++static int bgmac_fa_flow_add(struct bgmac *bgmac, struct flow_cls_offload *f,
++			     struct bgmac_fa_block *block)
++{
++	struct bgmac_fa *fa = bgmac->fa;
++	u32 e[FA_FLOW_WORDS] = {};
++	struct bgmac_fa_flow *flow;
++	struct bgmac_fa_rule r;
++	int base, i, err;
++	u32 action = 0;
++
++	if (!fa->active)
++		return -EOPNOTSUPP;
++	if (bgmac_fa_flow_find(fa, f->cookie))
++		return -EEXIST;
++
++	err = bgmac_fa_parse(bgmac, f, &r);
++	if (err)
++		return err;
++
++	base = bgmac_fa_bucket(&r.t);
++	for (i = 0; i < FA_FLOW_BUCKET; i++)
++		if (!test_bit(base + i, fa->used))
++			break;
++	if (i == FA_FLOW_BUCKET || !bgmac_fa_reply_fits(fa, &r, base))
++		return -ENOSPC;
++
++	flow = kzalloc(sizeof(*flow), GFP_KERNEL);
++	if (!flow)
++		return -ENOMEM;
++
++	flow->cookie = f->cookie;
++	flow->block = block;
++	flow->t = r.t;
++	flow->idx = base + i;
++	flow->lastused = jiffies;
++
++	flow->next_hop = bgmac_fa_next_hop_get(bgmac, r.eth, r.out);
++	if (flow->next_hop < 0) {
++		err = flow->next_hop;
++		goto free;
++	}
++
++	/* fa_napt_add(): the external pool entry, except for NAT of the
++	 * destination
++	 */
++	flow->pool = bgmac_fa_pool_get(bgmac, r.eth + ETH_ALEN, !r.dnat);
++	if (flow->pool < 0) {
++		err = flow->pool;
++		goto put_next_hop;
++	}
++
++	if (r.snat || r.dnat) {
++		action = FA_FLOW_ACT_OVRW_IP;
++		if (r.nat_port != (r.dnat ? r.t.dport : r.t.sport))
++			action |= FA_FLOW_ACT_OVRW_PORT;
++	}
++
++	fa_put_bits(e, FA_FLOW_ACTION, 2, action);
++	fa_put_bits(e, FA_FLOW_POOL, 2, flow->pool);
++	fa_put_bits(e, FA_FLOW_NEXT_HOP, 7, flow->next_hop);
++	fa_put_bits(e, FA_FLOW_NAT_IP, 32, ntohl(r.nat_ip));
++	fa_put_bits(e, FA_FLOW_NAT_PORT, 16, ntohs(r.nat_port));
++	fa_put_bits(e, FA_FLOW_DPORT, 16, ntohs(r.t.dport));
++	fa_put_bits(e, FA_FLOW_SPORT, 16, ntohs(r.t.sport));
++	fa_put_bits(e, FA_FLOW_TCP, 1, r.t.proto == IPPROTO_TCP);
++	fa_put_bits(e, FA_FLOW_DIP, 32, ntohl(r.t.dip));
++	fa_put_bits(e, FA_FLOW_SIP, 32, ntohl(r.t.sip));
++	fa_put_bits(e, FA_FLOW_OVRW_DEST, 1, r.dnat);
++	fa_put_bits(e, FA_FLOW_VALID, 1, 1);
++	fa_put_bits(e, FA_FLOW_IPV4, 1, 1);
++
++	err = bgmac_fa_tbl_write(bgmac, FA_TBL_FLOW, flow->idx, e,
++				 FA_FLOW_WORDS);
++	if (err)
++		goto put_pool;
++
++	set_bit(flow->idx, fa->used);
++	hash_add(fa->flows, &flow->node, flow->cookie);
++
++	return 0;
++
++put_pool:
++	bgmac_fa_pool_put(bgmac, flow->pool);
++put_next_hop:
++	bgmac_fa_next_hop_put(bgmac, flow->next_hop);
++free:
++	kfree(flow);
++	return err;
++}
++
++static void bgmac_fa_flow_remove(struct bgmac *bgmac, struct bgmac_fa_flow *flow)
++{
++	u32 e[FA_FLOW_WORDS];
++
++	/* _fa_napt_del(): clear the valid bit, keep the rest */
++	if (!bgmac_fa_tbl_read(bgmac, FA_TBL_FLOW, flow->idx, e, FA_FLOW_WORDS)) {
++		e[FA_FLOW_VALID / 32] &= ~BIT(FA_FLOW_VALID % 32);
++		bgmac_fa_tbl_write(bgmac, FA_TBL_FLOW, flow->idx, e,
++				   FA_FLOW_WORDS);
++	}
++
++	clear_bit(flow->idx, bgmac->fa->used);
++	bgmac_fa_pool_put(bgmac, flow->pool);
++	bgmac_fa_next_hop_put(bgmac, flow->next_hop);
++	hash_del(&flow->node);
++	kfree(flow);
++}
++
++static int bgmac_fa_flow_del(struct bgmac *bgmac, struct flow_cls_offload *f)
++{
++	struct bgmac_fa_flow *flow = bgmac_fa_flow_find(bgmac->fa, f->cookie);
++
++	if (!flow)
++		return -ENOENT;
++
++	bgmac_fa_flow_remove(bgmac, flow);
++	return 0;
++}
++
++static int bgmac_fa_flow_stats(struct bgmac *bgmac, struct flow_cls_offload *f)
++{
++	struct bgmac_fa_flow *flow = bgmac_fa_flow_find(bgmac->fa, f->cookie);
++	u32 e[FA_FLOW_WORDS], hits, delta;
++
++	if (!flow)
++		return -ENOENT;
++
++	if (bgmac_fa_tbl_read(bgmac, FA_TBL_FLOW, flow->idx, e, FA_FLOW_WORDS))
++		return -EIO;
++
++	hits = fa_get_bits(e, FA_FLOW_HITS, 32);
++	delta = hits - flow->hits;
++	flow->hits = hits;
++	if (delta)
++		flow->lastused = jiffies;
++
++	flow_stats_update(&f->stats, 0, delta, 0, flow->lastused,
++			  FLOW_ACTION_HW_STATS_IMMEDIATE);
++	return 0;
++}
++
++/* all flows (block NULL), or those of one flowtable block */
++static void bgmac_fa_flush(struct bgmac *bgmac, struct bgmac_fa_block *block)
++{
++	struct bgmac_fa *fa = bgmac->fa;
++	struct bgmac_fa_flow *flow;
++	struct hlist_node *tmp;
++	int bkt;
++
++	lockdep_assert_held(&fa->lock);
++
++	hash_for_each_safe(fa->flows, bkt, tmp, flow, node)
++		if (!block || flow->block == block)
++			bgmac_fa_flow_remove(bgmac, flow);
++}
++
++static int bgmac_fa_block_cb(enum tc_setup_type type, void *type_data,
++			     void *cb_priv)
++{
++	struct bgmac_fa_block *block = cb_priv;
++	struct bgmac *bgmac = block->bgmac;
++	struct flow_cls_offload *f = type_data;
++	int err;
++
++	if (type != TC_SETUP_CLSFLOWER)
++		return -EOPNOTSUPP;
++
++	bgmac_fa_lock(bgmac);
++	switch (f->command) {
++	case FLOW_CLS_REPLACE:
++		if (tc_can_offload(bgmac->net_dev))
++			err = bgmac_fa_flow_add(bgmac, f, block);
++		else
++			err = -EOPNOTSUPP;
++		break;
++	case FLOW_CLS_DESTROY:
++		err = bgmac_fa_flow_del(bgmac, f);
++		break;
++	case FLOW_CLS_STATS:
++		err = bgmac_fa_flow_stats(bgmac, f);
++		break;
++	default:
++		err = -EOPNOTSUPP;
++	}
++	bgmac_fa_unlock(bgmac);
++
++	return err;
++}
++
++static void bgmac_fa_block_release(void *cb_priv)
++{
++	kfree(cb_priv);
++}
++
++/*
++ * nf_tables unbinds a flowtable block when the ruleset changes, and only
++ * tears the flowtable's connections down later, when no driver is bound
++ * to it any more: this driver never gets FLOW_CLS_DESTROY for them. So
++ * remove a block's flows on its last unbind, or a firewall reload would
++ * leave them forwarding outside the new ruleset. A reload binds the new
++ * block before it unbinds the old one, hence per block.
++ */
++static int bgmac_fa_setup_block(struct bgmac *bgmac,
++				struct flow_block_offload *f)
++{
++	struct bgmac_fa *fa = bgmac->fa;
++	struct flow_block_cb *block_cb;
++	struct bgmac_fa_block *block;
++
++	if (f->binder_type != FLOW_BLOCK_BINDER_TYPE_CLSACT_INGRESS)
++		return -EOPNOTSUPP;
++
++	f->driver_block_list = &fa->block_cb_list;
++
++	switch (f->command) {
++	case FLOW_BLOCK_BIND:
++		block_cb = flow_block_cb_lookup(f->block, bgmac_fa_block_cb,
++						bgmac);
++		if (block_cb) {
++			flow_block_cb_incref(block_cb);
++			return 0;
++		}
++
++		block = kzalloc(sizeof(*block), GFP_KERNEL);
++		if (!block)
++			return -ENOMEM;
++		block->bgmac = bgmac;
++
++		block_cb = flow_block_cb_alloc(bgmac_fa_block_cb, bgmac, block,
++					       bgmac_fa_block_release);
++		if (IS_ERR(block_cb)) {
++			kfree(block);
++			return PTR_ERR(block_cb);
++		}
++
++		flow_block_cb_incref(block_cb);
++		flow_block_cb_add(block_cb, f);
++		list_add_tail(&block_cb->driver_list, &fa->block_cb_list);
++		return 0;
++	case FLOW_BLOCK_UNBIND:
++		block_cb = flow_block_cb_lookup(f->block, bgmac_fa_block_cb,
++						bgmac);
++		if (!block_cb)
++			return -ENOENT;
++
++		if (!flow_block_cb_decref(block_cb)) {
++			bgmac_fa_lock(bgmac);
++			bgmac_fa_flush(bgmac, flow_block_cb_priv(block_cb));
++			bgmac_fa_unlock(bgmac);
++			flow_block_cb_remove(block_cb, f);
++			list_del(&block_cb->driver_list);
++		}
++		return 0;
++	default:
++		return -EOPNOTSUPP;
++	}
++}
++
++static int bgmac_fa_setup_tc(struct bgmac *bgmac, enum tc_setup_type type,
++			     void *type_data)
++{
++	if (type != TC_SETUP_FT)
++		return -EOPNOTSUPP;
++
++	return bgmac_fa_setup_block(bgmac, type_data);
++}
++
++/* ---------- open / stop ---------- */
++
+ static bool bgmac_fa_wanted(struct bgmac *bgmac)
+ {
+ #if IS_ENABLED(CONFIG_NET_DSA)
+@@ -183,38 +1064,59 @@ static bool bgmac_fa_wanted(struct bgmac
+ 
+ static int bgmac_fa_open(struct bgmac *bgmac)
+ {
++	struct bgmac_fa *fa = bgmac->fa;
+ 	int err;
+ 
+ 	if (!bgmac_fa_wanted(bgmac)) {
+ 		/* back out of the path if an earlier open put it there */
+-		if (!bgmac->fa->normal)
++		if (!fa->normal)
+ 			return 0;
+ 		err = bgmac_fa_bypass(bgmac);
+ 		if (!err)
+-			bgmac->fa->normal = false;
++			fa->normal = false;
+ 		return err;
+ 	}
+ 
+-	if (!bcma_core_is_enabled(bgmac->fa->core)) {
++	if (!bcma_core_is_enabled(fa->core)) {
+ 		dev_err(bgmac->dev, "flow accelerator: GMAC3 core is not enabled\n");
+ 		return -ENODEV;
+ 	}
+ 
++	/* this also empties the tables: stop has dropped their flows */
+ 	err = bgmac_fa_normal(bgmac);
+ 	if (err)
+ 		return err;
+ 
+-	if (!bgmac->fa->normal)
++	if (!fa->normal)
+ 		dev_info(bgmac->dev, "flow accelerator in the path (prepended tag)\n");
+-	bgmac->fa->normal = true;
++	fa->normal = true;
++
++	mutex_lock(&fa->lock);
++	fa->active = true;
++	mutex_unlock(&fa->lock);
+ 
+ 	return 0;
+ }
+ 
++/* The next open initialises the tables again, and may take the FA out of
++ * the path: drop all flows. Connections the flowtable still counts as
++ * offloaded go back to software, and are offloaded again from there.
++ */
++static void bgmac_fa_stop(struct bgmac *bgmac)
++{
++	struct bgmac_fa *fa = bgmac->fa;
++
++	bgmac_fa_lock(bgmac);
++	fa->active = false;
++	bgmac_fa_flush(bgmac, NULL);
++	bgmac_fa_unlock(bgmac);
++}
++
+ /* Called for GMAC2 of a Northstar SoC; the FA is in its path to port 8 */
+ void bgmac_fa_probe(struct bgmac *bgmac)
+ {
+ 	struct bcma_device *core = bgmac->bcma.core;
++	struct bcma_chipinfo *ci = &core->bus->chipinfo;
+ 	struct bcma_device *gmac3;
+ 	struct bgmac_fa *fa;
+ 
+@@ -227,8 +1129,15 @@ void bgmac_fa_probe(struct bgmac *bgmac)
+ 		return;
+ 
+ 	fa->core = gmac3;
++	fa->war777 = ci->rev == 2 && ci->id != BCMA_CHIP_ID_BCM47094;
++	mutex_init(&fa->lock);
++	hash_init(fa->flows);
++	INIT_LIST_HEAD(&fa->block_cb_list);
++
+ 	bgmac->fa = fa;
+ 	bgmac->fa_open = bgmac_fa_open;
++	bgmac->fa_stop = bgmac_fa_stop;
++	bgmac->fa_setup_tc = bgmac_fa_setup_tc;
+ }
+ EXPORT_SYMBOL_GPL(bgmac_fa_probe);
+ 
+--- a/drivers/net/ethernet/broadcom/bgmac.c
++++ b/drivers/net/ethernet/broadcom/bgmac.c
+@@ -1212,6 +1212,9 @@ static int bgmac_stop(struct net_device
+ {
+ 	struct bgmac *bgmac = netdev_priv(net_dev);
+ 
++	if (bgmac->fa_stop)
++		bgmac->fa_stop(bgmac);
++
+ 	netif_carrier_off(net_dev);
+ 
+ 	phy_stop(net_dev->phydev);
+@@ -1262,6 +1265,17 @@ static int bgmac_change_mtu(struct net_d
+ 	return 0;
+ }
+ 
++static int bgmac_setup_tc(struct net_device *net_dev, enum tc_setup_type type,
++			  void *type_data)
++{
++	struct bgmac *bgmac = netdev_priv(net_dev);
++
++	if (!bgmac->fa_setup_tc)
++		return -EOPNOTSUPP;
++
++	return bgmac->fa_setup_tc(bgmac, type, type_data);
++}
++
+ static const struct net_device_ops bgmac_netdev_ops = {
+ 	.ndo_open		= bgmac_open,
+ 	.ndo_stop		= bgmac_stop,
+@@ -1271,6 +1285,7 @@ static const struct net_device_ops bgmac
+ 	.ndo_validate_addr	= eth_validate_addr,
+ 	.ndo_eth_ioctl           = phy_do_ioctl_running,
+ 	.ndo_change_mtu		= bgmac_change_mtu,
++	.ndo_setup_tc		= bgmac_setup_tc,
+ };
+ 
+ /**************************************************
+@@ -1545,6 +1560,11 @@ int bgmac_enet_probe(struct bgmac *bgmac
+ 	net_dev->features = NETIF_F_SG | NETIF_F_IP_CSUM | NETIF_F_IPV6_CSUM;
+ 	net_dev->hw_features = net_dev->features;
+ 	net_dev->vlan_features = net_dev->features;
++	/* flowtable offload through the flow accelerator */
++	if (bgmac->fa_setup_tc) {
++		net_dev->features |= NETIF_F_HW_TC;
++		net_dev->hw_features |= NETIF_F_HW_TC;
++	}
+ 
+ 	/* Omit FCS from max MTU size */
+ 	net_dev->max_mtu = BGMAC_RX_MAX_FRAME_SIZE - ETH_FCS_LEN;
+--- a/drivers/net/ethernet/broadcom/bgmac.h
++++ b/drivers/net/ethernet/broadcom/bgmac.h
+@@ -499,6 +499,9 @@ struct bgmac {
+ 	/* optional: the flow accelerator in front of this MAC (bgmac-fa.c) */
+ 	struct bgmac_fa *fa;
+ 	int (*fa_open)(struct bgmac *bgmac);
++	void (*fa_stop)(struct bgmac *bgmac);
++	int (*fa_setup_tc)(struct bgmac *bgmac, enum tc_setup_type type,
++			   void *type_data);
+ };
+ 
+ struct bgmac *bgmac_alloc(struct device *dev);
diff --git a/target/linux/bcm53xx/patches-6.18/725-net-dsa-tag_brcm-leave-frames-from-another-CPU-port-to-the-bridge.patch b/target/linux/bcm53xx/patches-6.18/725-net-dsa-tag_brcm-leave-frames-from-another-CPU-port-to-the-bridge.patch
new file mode 100644
index 0000000000..89fbfd5b51
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/725-net-dsa-tag_brcm-leave-frames-from-another-CPU-port-to-the-bridge.patch
@@ -0,0 +1,42 @@
+From 5f14bf1210958c0af39fa30930484164503e0022 Mon Sep 17 00:00:00 2001
+From: Erik Conijn <egc112@msn.com>
+Date: Sat, 14 Nov 2026 13:51:39 +0100
+Subject: [PATCH] net: dsa: tag_brcm: leave frames from another CPU port to the
+ bridge
+
+A b53 switch forwards the frames of a user port only to that port's own
+CPU port: with several CPU ports, the port based VLAN of a user port
+holds just that one. A frame that arrives through another CPU port was
+sent there by a rule that replaced its destination, such as the CFP
+redirect that b53 uses for the Northstar flow accelerator. The switch
+has not forwarded it to the other ports, so do not set
+offload_fwd_mark: the bridge forwards it in software.
+
+Linksys EA6900, with the traps to port 5 of the following b53 patches,
+between hosts on lan1 and lan2 of the same bridge: 5 of 5 pings with
+TTL 1 answered, and 10 TCP connections closed without a retransmission,
+their FIN and RST frames arriving through port 5.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Erik Conijn <egc112@msn.com>
+---
+ net/dsa/tag_brcm.c | 8 +++++++-
+ 1 file changed, 7 insertions(+), 1 deletion(-)
+
+--- a/net/dsa/tag_brcm.c
++++ b/net/dsa/tag_brcm.c
+@@ -187,7 +187,13 @@ static struct sk_buff *brcm_tag_rcv_ll(s
+ 	/* Remove Broadcom tag and update checksum */
+ 	skb_pull_rcsum(skb, BRCM_TAG_LEN);
+ 
+-	if (likely(!is_link_local_ether_addr(eth_hdr(skb)->h_dest)))
++	/* The switch forwards a user port's frames to its own CPU port only.
++	 * One that arrives through another CPU port was redirected there by
++	 * a classification rule instead of being forwarded, so leave it to
++	 * the bridge.
++	 */
++	if (likely(!is_link_local_ether_addr(eth_hdr(skb)->h_dest)) &&
++	    likely(dsa_user_to_port(skb->dev)->cpu_dp == dev->dsa_ptr))
+ 		dsa_default_offload_fwd_mark(skb);
+ 
+ 	return skb;
diff --git a/target/linux/bcm53xx/patches-6.18/726-net-dsa-b53-trap-TTL-1-frames-from-the-Northstar-flow-accelerator.patch b/target/linux/bcm53xx/patches-6.18/726-net-dsa-b53-trap-TTL-1-frames-from-the-Northstar-flow-accelerator.patch
new file mode 100644
index 0000000000..bd3292277c
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/726-net-dsa-b53-trap-TTL-1-frames-from-the-Northstar-flow-accelerator.patch
@@ -0,0 +1,388 @@
+From 37ecb183e672954ad39c04c3c684efd475d6c8a1 Mon Sep 17 00:00:00 2001
+From: Erik Conijn <egc112@msn.com>
+Date: Sat, 14 Nov 2026 13:44:04 +0100
+Subject: [PATCH] net: dsa: b53: trap TTL 1 frames from the Northstar flow
+ accelerator
+
+The flow accelerator in front of port 8 of the BCM5301x switches
+forwards the frames of the flows it holds without the host seeing them.
+It decrements the TTL and drops a frame whose TTL runs out, so a frame
+with TTL 1 in an offloaded flow gets no ICMP time exceeded message from
+the router.
+
+Use the CFP to redirect IPv4 frames with TTL 0 or 1 from the user ports
+behind the accelerator to another CPU port, where the host forwards them.
+The rule is on while the conduit of that CPU port is operational and
+port 8 uses the prepended tag, which is when the accelerator is in the
+path. It follows changes of the tag protocol and user ports that move to
+another CPU port; DSA updates cpu_dp only after port_change_conduit, so
+the moving port is passed in. Bring the trap conduit up when a user port
+behind the accelerator opens, as DSA does with the port's own conduit.
+
+Prefer port 8 as the default CPU port on BCM5301x too, as on BCM58xx, so
+that describing the trap port changes nothing else. No Northstar board
+in the tree describes both port 5 and port 8 as CPU ports.
+
+Linksys EA6900 (BCM4708), TCP flow from a LAN host held by the
+accelerator (4 entries), then 5 segments with TTL 1:
+
+                   ICMP time exceeded   frames on the trap port
+  without traps            0                     0
+  with traps               4 (rate limit)       17
+
+TCP throughput through the accelerator stays at 941 Mbit/s.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Erik Conijn <egc112@msn.com>
+---
+ drivers/net/dsa/b53/b53_common.c | 222 ++++++++++++++++++++++++++++++-
+ drivers/net/dsa/b53/b53_priv.h   |   7 +
+ drivers/net/dsa/b53/b53_regs.h   |  42 ++++++
+ 3 files changed, 268 insertions(+), 3 deletions(-)
+
+--- a/drivers/net/dsa/b53/b53_common.c
++++ b/drivers/net/dsa/b53/b53_common.c
+@@ -31,6 +31,7 @@
+ #include <linux/etherdevice.h>
+ #include <linux/if_bridge.h>
+ #include <linux/if_vlan.h>
++#include <linux/iopoll.h>
+ #include <net/dsa.h>
+ 
+ #include "b53_regs.h"
+@@ -593,6 +594,212 @@ static bool b53_has_flow_accelerator(str
+ 	       (dev->core_rev >= 3 || of_machine_is_compatible("brcm,bcm47094"));
+ }
+ 
++/* Bit of a port in the CFP port maps: ports 0 to 5, 7 and 8 */
++static u16 b53_cfp_port_bit(int port)
++{
++	return port > 5 ? BIT(port - 1) : BIT(port);
++}
++
++static u32 b53_cfp_acc(struct b53_device *dev)
++{
++	u32 val;
++
++	b53_read32(dev, B53_CFP_TCAM_PAGE, B53_CFP_ACC, &val);
++	return val;
++}
++
++static int b53_cfp_op(struct b53_device *dev, int index, u32 op)
++{
++	u32 val;
++
++	b53_write32(dev, B53_CFP_TCAM_PAGE, B53_CFP_ACC,
++		    index << CFP_ACC_ADDR_S | op | CFP_ACC_OP_STR_DONE);
++	return readx_poll_timeout(b53_cfp_acc, dev, val,
++				  !(val & CFP_ACC_OP_STR_DONE), 10, 1000);
++}
++
++static int b53_cfp_write_tcam(struct b53_device *dev, int index,
++			      const u32 *data, const u32 *mask)
++{
++	int i;
++
++	for (i = 0; i < B53_CFP_NUM_KEY_REGS; i++) {
++		b53_write32(dev, B53_CFP_TCAM_PAGE, B53_CFP_DATA(i), data[i]);
++		b53_write32(dev, B53_CFP_TCAM_PAGE, B53_CFP_MASK(i), mask[i]);
++	}
++
++	return b53_cfp_op(dev, index, CFP_ACC_RAM_TCAM | CFP_ACC_OP_WRITE);
++}
++
++/* Rule @index of slice 0: send the frames that match @data and @mask to
++ * the ports in @map (a CFP port map) instead of their ARL destination
++ */
++static int b53_cfp_redirect(struct b53_device *dev, int index,
++			    const u32 *data, const u32 *mask, u16 map)
++{
++	int err;
++
++	b53_write32(dev, B53_CFP_TCAM_PAGE, B53_CFP_ACT_POL_DATA0,
++		    CFP_ACT_POL0_REP_ARL | map << CFP_ACT_POL0_DST_MAP_S |
++		    CFP_ACT_POL0_BYP_ALL);
++	b53_write32(dev, B53_CFP_TCAM_PAGE, B53_CFP_ACT_POL_DATA1,
++		    CFP_ACT_POL1_REP_ARL | map << CFP_ACT_POL1_DST_MAP_S);
++	err = b53_cfp_op(dev, index, CFP_ACC_RAM_ACT_POL | CFP_ACC_OP_WRITE);
++	if (err)
++		return err;
++
++	return b53_cfp_write_tcam(dev, index, data, mask);
++}
++
++/* The CFP rules for the flow accelerator, from the first one on */
++enum {
++	B53_FA_TRAP_TTL,
++	B53_FA_TRAP_NUM,
++};
++
++static int b53_fa_trap_set(struct b53_device *dev, u16 src, u16 map)
++{
++	u32 data[B53_CFP_NUM_KEY_REGS] = { CFP_DATA0_SLICE_VALID };
++	u32 mask[B53_CFP_NUM_KEY_REGS] = {
++		CFP_DATA0_SLICE_VALID | CFP_DATA0_SLICE_ID_MASK
++	};
++	int err;
++
++	/* IPv4 from the ports in @src: the source port map key matches
++	 * the ports that the mask leaves out
++	 */
++	mask[6] = CFP_DATA6_L3_FRAMING_MASK;
++	mask[7] = 0xff & ~src;
++
++	/* TTL 0 or 1, which the flow accelerator drops after its decrement
++	 * instead of leaving the ICMP time exceeded message to the host.
++	 * The TTL range field (bits 4:3) holds 0 for TTL 0, 1 for TTL 1,
++	 * 2 for TTL 2 to 254 and 3 for TTL 255 (measured on a BCM4708), so
++	 * a clear bit 4 matches exactly TTL 0 and 1.
++	 */
++	mask[6] |= CFP_DATA6_TTL_RANGE_HIGH;
++	err = b53_cfp_redirect(dev, B53_FA_TRAP_TTL, data, mask, map);
++	mask[6] &= ~CFP_DATA6_TTL_RANGE_HIGH;
++
++	return err;
++}
++
++static void b53_fa_trap_clear(struct b53_device *dev)
++{
++	static const u32 zero[B53_CFP_NUM_KEY_REGS];
++	int i;
++
++	b53_write8(dev, B53_CFP_PAGE, B53_CFP_CTRL, 0);
++	for (i = 0; i < B53_FA_TRAP_NUM; i++)
++		b53_cfp_write_tcam(dev, i, zero, zero);
++	dev->fa_trap_ports = 0;
++}
++
++/* The flow accelerator in front of port 8 forwards the frames of the
++ * flows it holds without the host seeing them, and cannot handle some of
++ * them. With another CPU port up, redirect those frames there from the
++ * user ports that use port 8, so that the host handles them. The tagger
++ * leaves them to the bridge, as they arrive through a CPU port other than
++ * their port's own.
++ *
++ * @port is about to move to CPU port @cpu, or -1.
++ */
++static void b53_fa_trap_update(struct b53_device *dev, int port, int cpu)
++{
++	struct dsa_switch *ds = dev->ds;
++	struct dsa_port *dp;
++	int trap = -1, err;
++	u16 src = 0;
++
++	if (b53_has_flow_accelerator(dev) &&
++	    dev->tag_protocol == DSA_TAG_PROTO_BRCM_PREPEND) {
++		dsa_switch_for_each_cpu_port(dp, ds) {
++			if (dp->index != B53_CPU_PORT &&
++			    dev->cpu_ports_up & BIT(dp->index)) {
++				trap = dp->index;
++				break;
++			}
++		}
++	}
++
++	if (trap >= 0) {
++		dsa_switch_for_each_user_port(dp, ds) {
++			if ((dp->index == port ? cpu : dp->cpu_dp->index) ==
++			    B53_CPU_PORT)
++				src |= b53_cfp_port_bit(dp->index);
++		}
++	}
++
++	if (src == dev->fa_trap_ports && (!src || trap == dev->fa_trap_port))
++		return;
++
++	b53_fa_trap_clear(dev);
++	if (!src) {
++		dev_info(ds->dev, "flow accelerator traps off\n");
++		return;
++	}
++
++	err = b53_fa_trap_set(dev, src, b53_cfp_port_bit(trap));
++	if (err) {
++		dev_err(ds->dev, "flow accelerator traps: %pe\n", ERR_PTR(err));
++		b53_fa_trap_clear(dev);
++		return;
++	}
++
++	b53_write8(dev, B53_CFP_PAGE, B53_CFP_CTRL, src);
++	dev->fa_trap_port = trap;
++	dev->fa_trap_ports = src;
++	dev_info(ds->dev, "flow accelerator traps to port %d\n", trap);
++}
++
++/* Bring up the conduit that takes the traps when a user port behind the
++ * flow accelerator opens, as DSA brings up the port's own conduit
++ */
++static void b53_fa_trap_open(struct b53_device *dev, int port)
++{
++	struct dsa_switch *ds = dev->ds;
++	struct net_device *conduit;
++	struct dsa_port *cpu_dp;
++	int err;
++
++	ASSERT_RTNL();
++
++	if (!b53_has_flow_accelerator(dev) ||
++	    dev->tag_protocol != DSA_TAG_PROTO_BRCM_PREPEND ||
++	    dsa_to_port(ds, port)->cpu_dp->index != B53_CPU_PORT)
++		return;
++
++	dsa_switch_for_each_cpu_port(cpu_dp, ds) {
++		if (cpu_dp->index == B53_CPU_PORT)
++			continue;
++
++		conduit = cpu_dp->conduit;
++		if (conduit->flags & IFF_UP)
++			return;
++
++		err = dev_open(conduit, NULL);
++		if (err)
++			dev_warn(ds->dev, "flow accelerator traps: %s: %pe\n",
++				 conduit->name, ERR_PTR(err));
++		return;
++	}
++}
++
++static void b53_conduit_state_change(struct dsa_switch *ds,
++				     const struct net_device *conduit,
++				     bool operational)
++{
++	struct b53_device *dev = ds->priv;
++	u16 bit = BIT(conduit->dsa_ptr->index);
++
++	if (operational)
++		dev->cpu_ports_up |= bit;
++	else
++		dev->cpu_ports_up &= ~bit;
++
++	b53_fa_trap_update(dev, -1, -1);
++}
++
+ static int b53_port_change_conduit(struct dsa_switch *ds, int port,
+ 				   struct net_device *conduit,
+ 				   struct netlink_ext_ack *extack)
+@@ -610,17 +817,21 @@ static int b53_port_change_conduit(struc
+ 	pvlan |= BIT(conduit->dsa_ptr->index);
+ 	b53_write16(dev, B53_PVLAN_PAGE, B53_PVLAN_PORT_MASK(port), pvlan);
+ 
++	b53_fa_trap_update(dev, port, conduit->dsa_ptr->index);
++
+ 	return 0;
+ }
+ 
+-/* Keep port 8 as the default CPU port of BCM58xx when another one is
+- * described: ports can move to it with port_change_conduit
++/* Keep port 8 as the default CPU port of BCM5301x and BCM58xx when
++ * another one is described: ports can move to it with
++ * port_change_conduit, and on BCM5301x it can take the flow accelerator
++ * traps
+  */
+ static struct dsa_port *b53_preferred_default_local_cpu_port(struct dsa_switch *ds)
+ {
+ 	struct b53_device *dev = ds->priv;
+ 
+-	if (dev->chip_id == BCM58XX_DEVICE_ID &&
++	if ((is5301x(dev) || dev->chip_id == BCM58XX_DEVICE_ID) &&
+ 	    dsa_is_cpu_port(ds, B53_CPU_PORT))
+ 		return dsa_to_port(ds, B53_CPU_PORT);
+ 
+@@ -784,6 +995,8 @@ int b53_enable_port(struct dsa_switch *d
+ 	if (dev->ports[port].eee.eee_enabled)
+ 		b53_eee_enable_set(ds, port, true);
+ 
++	b53_fa_trap_open(dev, port);
++
+ 	return 0;
+ }
+ EXPORT_SYMBOL(b53_enable_port);
+@@ -2644,6 +2857,8 @@ static int b53_change_tag_protocol(struc
+ 	dsa_switch_for_each_cpu_port(cpu_dp, ds)
+ 		b53_brcm_hdr_setup(ds, cpu_dp->index);
+ 
++	b53_fa_trap_update(dev, -1, -1);
++
+ 	return 0;
+ }
+ 
+@@ -2815,6 +3030,7 @@ static const struct dsa_switch_ops b53_s
+ 	.get_tag_protocol	= b53_get_tag_protocol,
+ 	.change_tag_protocol	= b53_change_tag_protocol,
+ 	.preferred_default_local_cpu_port = b53_preferred_default_local_cpu_port,
++	.conduit_state_change	= b53_conduit_state_change,
+ 	.port_change_conduit	= b53_port_change_conduit,
+ 	.setup			= b53_setup,
+ 	.teardown		= b53_teardown,
+--- a/drivers/net/dsa/b53/b53_priv.h
++++ b/drivers/net/dsa/b53/b53_priv.h
+@@ -177,6 +177,13 @@ struct b53_device {
+ 	unsigned int num_ports;
+ 	struct b53_port *ports;
+ 
++	/* CPU ports whose conduit is operational, and the flow accelerator
++	 * traps: their CPU port and the ports they apply to (none if 0)
++	 */
++	u16 cpu_ports_up;
++	int fa_trap_port;
++	u16 fa_trap_ports;
++
+ 	struct b53_pcs pcs[B53_N_PCS];
+ };
+ 
+--- a/drivers/net/dsa/b53/b53_regs.h
++++ b/drivers/net/dsa/b53/b53_regs.h
+@@ -57,6 +57,9 @@
+ /* EEE Control Registers Page */
+ #define B53_EEE_PAGE			0x92
+ 
++/* CFP TCAM and Action/Policy RAM Access Page */
++#define B53_CFP_TCAM_PAGE		0xa0
++
+ /* CFP Configuration Registers Page */
+ #define B53_CFP_PAGE			0xa1
+ 
+@@ -601,4 +604,43 @@
+ /* CFP Control Register with ports map (8 bit) */
+ #define B53_CFP_CTRL			0x00
+ 
++/* User Defined Field 0 of slice 0 for IPv4 frames (8 bit) */
++#define B53_CFP_UDF_0_A_0		0x10
++#define   CFP_UDF_OFFSET_MASK		0x1f	/* in 16 bit words */
++#define   CFP_UDF_EOL3			(3 << 5) /* from the end of L3 */
++
++/*************************************************************************
++ * CFP TCAM and Action/Policy RAM Access Page Registers
++ *************************************************************************/
++
++/* CFP Access Register (32 bit) */
++#define B53_CFP_ACC			0x00
++#define   CFP_ACC_OP_STR_DONE		BIT(0)
++#define   CFP_ACC_OP_WRITE		(2 << 1)
++#define   CFP_ACC_RAM_TCAM		(1 << 10)
++#define   CFP_ACC_RAM_ACT_POL		(2 << 10)
++#define   CFP_ACC_ADDR_S		16
++
++/* CFP TCAM Data and Mask Registers (32 bit) */
++#define B53_CFP_DATA(i)			(0x10 + 4 * (i))
++#define B53_CFP_MASK(i)			(0x30 + 4 * (i))
++#define   CFP_DATA0_SLICE_VALID		0x3
++#define   CFP_DATA0_SLICE_ID_MASK	(0x3 << 2)
++#define   CFP_DATA0_UDF_A0_S		8
++#define   CFP_DATA5_UDF_VALID_0		BIT(24)
++#define   CFP_DATA6_TTL_RANGE_HIGH	BIT(4)	/* TTL 0 or 1 if clear */
++#define   CFP_DATA6_IP_PROTO_S		8
++#define   CFP_DATA6_IP_PROTO_MASK	(0xff << 8)
++#define   CFP_DATA6_L3_FRAMING_MASK	(0x3 << 24) /* 0: IPv4 */
++#define B53_CFP_NUM_KEY_REGS		8
++
++/* CFP Action/Policy Data Registers (32 bit) */
