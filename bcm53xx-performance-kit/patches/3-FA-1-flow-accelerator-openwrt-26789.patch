+ {
+ 	return -EOPNOTSUPP;
+ }
++
++static inline int b53_fa_pvid(struct dsa_switch *ds, int port)
++{
++	return -EOPNOTSUPP;
++}
++
++static inline bool b53_fa_vlan_ok(struct dsa_switch *ds, int port, u16 vid)
++{
++	return false;
++}
+ #endif
+ 
