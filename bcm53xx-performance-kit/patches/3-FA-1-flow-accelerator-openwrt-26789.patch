+ #else
+ static inline bool b53_fa_trap_active(struct dsa_switch *ds, int port)
+ {
+@@ -39,6 +40,11 @@ static inline bool b53_fa_vlan_ok(struct
+ {
+ 	return false;
+ }
++
++static inline int b53_fa_port_map(struct dsa_switch *ds, int port)
++{
++	return -EOPNOTSUPP;
++}
