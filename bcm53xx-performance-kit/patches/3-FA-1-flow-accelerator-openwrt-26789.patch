+@@ -18,6 +18,7 @@ bool b53_fa_trap_active(struct dsa_switc
+ int b53_fa_vlan(struct dsa_switch *ds, int port, u16 vid, bool add);
+ int b53_fa_pvid(struct dsa_switch *ds, int port);
+ bool b53_fa_vlan_ok(struct dsa_switch *ds, int port, u16 vid);
