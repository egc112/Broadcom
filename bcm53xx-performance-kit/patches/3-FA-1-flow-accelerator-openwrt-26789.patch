diff --git a/target/linux/bcm53xx/base-files/usr/libexec/platform/packet-steering.sh b/target/linux/bcm53xx/base-files/usr/libexec/platform/packet-steering.sh
index ea0894d58b..73756d4d52 100755
--- a/target/linux/bcm53xx/base-files/usr/libexec/platform/packet-steering.sh
+++ b/target/linux/bcm53xx/base-files/usr/libexec/platform/packet-steering.sh
@@ -4,9 +4,27 @@ packet_steering="$(uci -q get network.@globals[0].packet_steering)"
 flow_offloading="$(uci -q get firewall.@defaults[0].flow_offloading)"
 flow_offloading_hw="$(uci -q get firewall.@defaults[0].flow_offloading_hw)"
 
+# DSA puts its sysfs group on each conduit. With the flow accelerator the
+# switch has two, the traps' and the traffic's: take the one that the user
+# ports hang off, the conduit with the most interfaces linked to it
+conduit=eth0
+users=0
+for d in /sys/class/net/*/dsa; do
+	[ -d "$d" ] || continue
+	dev="${d%/dsa}"
+	dev="${dev##*/}"
+	ifindex="$(cat /sys/class/net/$dev/ifindex)"
+	n=0
+	for l in /sys/class/net/*/iflink; do
+		[ "${l%/iflink}" = "/sys/class/net/$dev" ] && continue
+		[ "$(cat "$l")" = "$ifindex" ] && n=$((n + 1))
+	done
+	[ $n -gt $users ] && conduit="$dev" users=$n
+done
+
 [ "$packet_steering" != 1 ] && {
 	echo 0 > /sys/class/net/br-lan/queues/rx-0/rps_cpus
-	echo 0 > /sys/class/net/eth0/queues/rx-0/rps_cpus
+	echo 0 > /sys/class/net/$conduit/queues/rx-0/rps_cpus
 	exit 0
 }
 
@@ -29,13 +47,13 @@ esac
 if [ ${flow_offloading_hw:-0} -gt 0 ]; then
 	# HW offloading
 	echo 0 > /sys/class/net/br-lan/queues/rx-0/rps_cpus
-	echo 0 > /sys/class/net/eth0/queues/rx-0/rps_cpus
+	echo 0 > /sys/class/net/$conduit/queues/rx-0/rps_cpus
 elif [ ${flow_offloading:-0} -gt 0 ]; then
 	# SW offloading
 	# br-lan setup doesn't seem to matter for offloading case
-	echo 2 > /sys/class/net/eth0/queues/rx-0/rps_cpus
+	echo 2 > /sys/class/net/$conduit/queues/rx-0/rps_cpus
 else
 	# Default
 	echo 2 > /sys/class/net/br-lan/queues/rx-0/rps_cpus
-	echo 0 > /sys/class/net/eth0/queues/rx-0/rps_cpus
+	echo 0 > /sys/class/net/$conduit/queues/rx-0/rps_cpus
 fi
diff --git a/target/linux/bcm53xx/patches-6.18/080-v7.4-net-ethernet-bgmac-preserve-forced-2.5-Gbps-link-speed.patch b/target/linux/bcm53xx/patches-6.18/080-v7.4-net-ethernet-bgmac-preserve-forced-2.5-Gbps-link-speed.patch
new file mode 100644
index 0000000000..71125c04b5
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/080-v7.4-net-ethernet-bgmac-preserve-forced-2.5-Gbps-link-speed.patch
@@ -0,0 +1,62 @@
+From d4f3d2c04624854d27aa948cd7bfc9d946faaac5 Mon Sep 17 00:00:00 2001
+From: Florian Fainelli <florian.fainelli@broadcom.com>
+Date: Thu, 29 Oct 2026 14:15:39 -0700
+Subject: [PATCH] net: ethernet: bgmac: preserve forced 2.5 Gbps link speed
+
+Northstar and Northstar Plus use a 2.5 Gbps internal link between the
+AMAC and the switch.  BGMAC_FEAT_FORCE_SPEED_2500 makes bgmac_miiconfig()
+configure that speed, but bgmac_adjust_link() subsequently replaces it
+with the synthetic fixed PHY's 1 Gbps speed.
+
+Use the forced speed when processing link changes so the MAC remains at
+2.5 Gbps.  Together with configuring the switch IMP port for its 2 Gbps
+mode, this eliminates the output queue discards that caused approximately
+1000 TCP retransmissions per second during an iperf3 transmit test.
+
+Restrict the platform forced-speed flag to Northstar Plus using the SoC
+compatible, since Hurricane2 shares the AMAC compatible. Other platform
+AMACs without a phy-handle must continue following the fixed PHY speed.
+The BCMA path already selects the flag only for the Northstar family.
+
+Fixes: f6a95a24957a ("net: ethernet: bgmac: Add platform device support")
+Signed-off-by: Florian Fainelli <florian.fainelli@broadcom.com>
+Reviewed-by: Simon Horman <horms@kernel.org>
+Link: https://patch.msgid.link/20261029211540.4123250-2-florian.fainelli@broadcom.com
+Signed-off-by: Paolo Abeni <pabeni@redhat.com>
+---
+ drivers/net/ethernet/broadcom/bgmac-platform.c | 3 ++-
+ drivers/net/ethernet/broadcom/bgmac.c          | 8 ++++++--
+ 2 files changed, 8 insertions(+), 3 deletions(-)
+
+--- a/drivers/net/ethernet/broadcom/bgmac-platform.c
++++ b/drivers/net/ethernet/broadcom/bgmac-platform.c
+@@ -243,7 +243,8 @@ static int bgmac_probe(struct platform_d
+ 		bgmac->phy_connect = platform_phy_connect;
+ 	} else {
+ 		bgmac->phy_connect = bgmac_phy_connect_direct;
+-		bgmac->feature_flags |= BGMAC_FEAT_FORCE_SPEED_2500;
++		if (of_machine_is_compatible("brcm,nsp"))
++			bgmac->feature_flags |= BGMAC_FEAT_FORCE_SPEED_2500;
+ 	}
+ 
+ 	return bgmac_enet_probe(bgmac);
+--- a/drivers/net/ethernet/broadcom/bgmac.c
++++ b/drivers/net/ethernet/broadcom/bgmac.c
+@@ -1415,11 +1415,15 @@ void bgmac_adjust_link(struct net_device
+ {
+ 	struct bgmac *bgmac = netdev_priv(net_dev);
+ 	struct phy_device *phy_dev = net_dev->phydev;
++	int speed = phy_dev->speed;
+ 	bool update = false;
+ 
++	if (bgmac->feature_flags & BGMAC_FEAT_FORCE_SPEED_2500)
++		speed = SPEED_2500;
++
+ 	if (phy_dev->link) {
+-		if (phy_dev->speed != bgmac->mac_speed) {
+-			bgmac->mac_speed = phy_dev->speed;
++		if (speed != bgmac->mac_speed) {
++			bgmac->mac_speed = speed;
+ 			update = true;
+ 		}
+ 
diff --git a/target/linux/bcm53xx/patches-6.18/081-v7.4-net-dsa-b53-restore-the-NSP-IMP-port-2-Gbps-mode.patch b/target/linux/bcm53xx/patches-6.18/081-v7.4-net-dsa-b53-restore-the-NSP-IMP-port-2-Gbps-mode.patch
new file mode 100644
index 0000000000..bbb358cff6
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/081-v7.4-net-dsa-b53-restore-the-NSP-IMP-port-2-Gbps-mode.patch
@@ -0,0 +1,45 @@
+From 41af38324341df9d769641d6485abb67fd5209ed Mon Sep 17 00:00:00 2001
+From: Florian Fainelli <florian.fainelli@broadcom.com>
+Date: Thu, 29 Oct 2026 14:15:40 -0700
+Subject: [PATCH] net: dsa: b53: restore the NSP IMP port 2 Gbps mode
+
+The Northstar Plus IMP port uses the switch's proprietary 2 Gbps mode for
+its internal link to the AMAC.  Its fixed-link description reports 1 Gbps,
+so applying that speed clears PORT_OVERRIDE_SPEED_2000M and leaves the two
+ends of the internal link configured at different speeds.
+
+Force the 2 Gbps mode and flow control for BCM5301x and NSP CPU ports.  The
+mismatch caused switch output queue discards on both copper and SerDes
+ports, with one discard for every TCP retransmission.  With both ends
+restored to their high-speed modes, iperf3 reports no retransmissions.
+
+Fixes: b6a8a5477fe9 ("net: dsa: b53: fix resetting speed and pause on forced link")
+Signed-off-by: Florian Fainelli <florian.fainelli@broadcom.com>
+Reviewed-by: Simon Horman <horms@kernel.org>
+Link: https://patch.msgid.link/20261029211540.4123250-3-florian.fainelli@broadcom.com
+Signed-off-by: Paolo Abeni <pabeni@redhat.com>
+---
+ drivers/net/dsa/b53/b53_common.c | 12 +++++++++---
+ 1 file changed, 9 insertions(+), 3 deletions(-)
+
+--- a/drivers/net/dsa/b53/b53_common.c
++++ b/drivers/net/dsa/b53/b53_common.c
+@@ -1642,9 +1642,15 @@ static void b53_phylink_mac_link_up(stru
+ 	}
+ 
+ 	if (mode == MLO_AN_FIXED) {
+-		/* Force flow control on BCM5301x's CPU port */
+-		if (is5301x(dev) && dsa_is_cpu_port(ds, port))
+-			tx_pause = rx_pause = true;
++		/* Force flow control and 2Gbits/sec on BCM5301x and NSP CPU
++		 * ports
++		 */
++		if ((is5301x(dev) || dev->chip_id == BCM58XX_DEVICE_ID) &&
++		    dsa_is_cpu_port(ds, port)) {
++			tx_pause = true;
++			rx_pause = true;
++			speed = 2000;
++		}
+ 
+ 		b53_force_port_config(dev, port, speed, duplex,
+ 				      tx_pause, rx_pause);
diff --git a/target/linux/bcm53xx/patches-6.18/376-ARM-dts-BCM5301X-use-IMP0-port-8-as-the-CPU-port.patch b/target/linux/bcm53xx/patches-6.18/376-ARM-dts-BCM5301X-use-IMP0-port-8-as-the-CPU-port.patch
new file mode 100644
index 0000000000..66090cecaa
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/376-ARM-dts-BCM5301X-use-IMP0-port-8-as-the-CPU-port.patch
@@ -0,0 +1,1305 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Semih Baskan <strst.gs@gmail.com>
+Date: Tue, 13 Oct 2026 00:00:00 +0300
+Subject: [PATCH] ARM: dts: BCM5301X: use IMP0 port 8 as the CPU port
+
+The switch blocks of most BCM5301X boards in tree make port 5 (on some
+boards 7) the CPU port and leave port 8, the IMP0 management port,
+disabled. The switch sends frames it cannot place, such as a tagged
+frame whose VID is missing from the VLAN table, only toward the
+management port. With port 8 disabled those frames are dropped, so on a
+standalone port a VLAN tagged uplink, for example a tagged PPPoE WAN,
+never comes up.
+
+Make port 8 the only CPU port on the 30 boards below and disable the
+old CPU port, the layout bcm47094-netgear-r8500.dts already uses. Where
+the old conduit stays enabled, it sits behind its disabled port and
+carries no traffic.
+
+gmac2 needs its own MAC cell. Without one bgmac takes et2macaddr from
+nvram, which most of these CFEs do not set, and otherwise a random
+address on every boot. gmac2 gets a cell on 27 boards:
+
+- The MR26 and MR32 move their cell from gmac0 to gmac2.
+- The EA6300 V1, RT-AC87U, the four Luxul boards and the K3 point gmac2
+  at their existing et0macaddr or et1macaddr node, index 0. On the
+  RT-AC3100, RT-AC3200, RT-AC5300 and RT-AC88U gmac2 already had a cell
+  with index 2 (1 on the RT-AC88U); it drops to 0, which is also the
+  address the vendor firmware gives gmac2.
+- Twelve boards get a new brcm,nvram node with an et0macaddr cell,
+  the address the old conduit read from nvram.
+- The Archer C5 V2 and C9 V1 have no nvram partition. gmac2 reads the
+  label MAC from their default-mac partition: a 32-bit length of 6,
+  then the MAC at offset 8, the layout the vendor firmware reads.
+
+The SR400ac and the R7900 get no cell, and bgmac reads et2macaddr from
+nvram; on the Tenda AC9 port 8 is gmac0, which reads et0macaddr.
+
+If a new node does not start on the nvram header, brcm_nvram fails to
+probe and gmac2 waits for its cell forever, so the board has no
+conduit. Each offset comes from that model where a read exists:
+
+Board          Node                    Source
+RT-N18U        NAND 0x80000 0x180000   partition table on the unit
+RT-AC56U       NAND 0x80000 0x180000   OpenWrt boot log
+RT-AC68U       NAND 0x80000 0x180000   OpenWrt boot log
+R6250 V1       NAND 0x80000 0x180000   OpenWrt boot log
+R6300 V2       NAND 0x80000 0x180000   OpenWrt boot log
+R7000          NAND 0x80000 0x180000   OpenWrt boot log and /proc/mtd
+R6400 V1       NAND 0x80000 0x180000   R6250 V1, R6300 V2, R7000
+EA6500 V2      NAND 0x80000 0x100000   /proc/mtd of the EA6700
+WZR-600DHP2    NAND 0xa0000 0x160000   CFE "show devices" on a unit
+WZR-900DHP     NAND 0xa0000 0x160000   LEDE boot log
+WZR-1750DHP    NOR  0xf0000 0x10000    dump of a unit, FLSH at 0xf0000
+WXR-1900DHP    NOR  0x70000 0x10000    OpenWrt boot log
+
+The EA6500 V2 has no log of its own. The EA6700 is the same board apart
+from the LEDs, and its /proc/mtd matches the CFE layout in the Linksys
+GPL. The R6400 V1 has no log of its own. The three Netgear NAND boards
+above, on the same vendor firmware base, all keep nvram at that
+offset. The two NOR nodes sit in the serial flash window, as the Luxul
+nodes in tree do.
+
+Board                     CPU port          Conduit
+Asus RT-AC56U             5 -> 8            eth0 -> eth2
+Asus RT-AC68U             5 -> 8            eth0 -> eth2
+Asus RT-AC3100            5, 7, 8 -> 8      eth0 -> eth2
+Asus RT-AC3200            5, 7, 8 -> 8      eth0 -> eth2
+Asus RT-AC5300            5, 7, 8 -> 8      eth0 -> eth2
+Asus RT-AC87U             7 -> 8            eth1 -> eth2
+Asus RT-AC88U             7, 8 -> 8         eth0 -> eth1
+Asus RT-N18U              5 -> 8            eth0 -> eth2
+Buffalo WZR-600DHP2       5 -> 8            eth0 -> eth2
+Buffalo WZR-900DHP        5 -> 8            eth0 -> eth2
+Buffalo WZR-1750DHP       5 -> 8            eth0 -> eth2
+Buffalo WXR-1900DHP       5 -> 8            eth0 -> eth2
+Linksys EA6300 V1         5 -> 8            eth0 -> eth2
+Linksys EA6500 V2         5 -> 8            eth0 -> eth2
+Luxul ABR-4500 V1         5 -> 8            eth0 -> eth2
+Luxul XAP-1610 V1         5 -> 8            eth0 -> eth2
+Luxul XBR-4500 V1         5 -> 8            eth0 -> eth2
+Luxul XWR-3150 V1         5 -> 8            eth0 -> eth2
+Meraki MR26               5 -> 8            eth0 -> eth0
+Meraki MR32               5 -> 8            eth0 -> eth0
+Netgear R6250 V1          5 -> 8            eth0 -> eth2
+Netgear R6300 V2          5 -> 8            eth0 -> eth2
+Netgear R6400 V1          5 -> 8            eth0 -> eth2
+Netgear R7000             5 -> 8            eth0 -> eth2
+Netgear R7900             none -> 8         none -> eth2
+Phicomm K3                5 -> 8            eth0 -> eth2
+SmartRG SR400ac           5 -> 8            eth0 -> eth2
+Tenda AC9                 5, 8 -> 8         eth1 -> eth0
+TP-Link Archer C5 V2      5 -> 8            eth0 -> eth2
+TP-Link Archer C9 V1      5 -> 8            eth0 -> eth2
+
+Where more than one CPU port was enabled, DSA picked the first one. With
+gmac0 disabled on the RT-AC88U, its gmac2 is eth1. The MR26 and MR32
+enable only gmac2, which keeps the conduit at eth0. The R7900 had no DSA
+ports before, since its switch was never enabled. On the Tenda AC9
+(BCM53573) port 8 is wired to gmac0. The RT-AC87U also moves its QTN link
+to port 5, where the Quantenna chip is wired, and disables the unused
+port 4. The R6400 V2 device tree includes the R6400 V1 file and gets the
+same change.
+
+Tested only on an Asus RT-N18U (BCM53011 rev 5) on the 6.18 kernel,
+across two boots, with a second router as the tagged-link peer and PPPoE
+concentrator. The conduit comes up as eth2 with et0macaddr on both boots,
+eth0 stays present and idle, and lan1 to lan4 and wan keep their names and
+the brcm tagging. The switch selects IMP0 as its management port, so the
+frames it steers there, the tagged miss path included, now end at the CPU
+port. Tagged reception on the standalone wan works with nothing in the
+VLAN table: wan.60 exchanges pings with the peer. A PPPoE session over
+wan.35 establishes with the default route on pppoe-wan. Untagged traffic
+on wan and bridged LAN traffic work, a bridge VLAN under vlan_filtering 1
+programs the table as before, and management over br-lan survived the
+flash. The known trade-off was measured as well: after the wan.60 upper is
+deleted, VID-60 frames still reach the CPU, because the miss path now ends
+at the CPU port.
+
+Signed-off-by: Semih Baskan <strst.gs@gmail.com>
