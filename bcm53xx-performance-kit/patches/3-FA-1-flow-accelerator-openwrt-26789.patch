+  * CFP TCAM and Action/Policy RAM Access Page Registers
diff --git a/target/linux/bcm53xx/patches-6.18/728-net-dsa-b53-trap-IPv6-for-the-Northstar-flow-accelerator.patch b/target/linux/bcm53xx/patches-6.18/728-net-dsa-b53-trap-IPv6-for-the-Northstar-flow-accelerator.patch
new file mode 100644
index 0000000000..5627a1e1f4
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/728-net-dsa-b53-trap-IPv6-for-the-Northstar-flow-accelerator.patch
@@ -0,0 +1,201 @@
+From c871187e7201cec95bfc5d1bab11fe8efb6933ab Mon Sep 17 00:00:00 2001
+From: Erik Conijn <egc112@msn.com>
+Date: Sat, 14 Nov 2026 14:12:04 +0100
+Subject: [PATCH] net: dsa: b53: trap IPv6 for the Northstar flow accelerator
+
+The flow accelerator in front of port 8 can forward IPv6 as well, but it
+has no hop limit check: it forwards a frame with hop limit 1 as hop
+limit 0. Its driver can only use it for IPv6 while the switch keeps
+those frames away from it.
+
+Let the TTL rule match IPv6 with hop limit 0 or 1 too, and add the TCP
+FIN and RST rules for IPv6, with the user defined field of the IPv6
+frames at the same offset. Tell the driver of the accelerator whether
+the traps are on for a port with b53_fa_trap_active().
+
+Linksys EA6900 (BCM4708), TCP flow from a LAN host held by the
+accelerator, then 5 segments with hop limit 1: 4 ICMPv6 time exceeded
+messages (rate limit), the frames arriving on the trap port. After an
+iperf3 test the entries of its IPv6 connections are gone within 1 s,
+after a FIN as after an RST.
+
+Assisted-by: Claude:claude-fable-5-2
+Signed-off-by: Erik Conijn <egc112@msn.com>
+---
+ drivers/net/dsa/b53/b53_common.c | 78 ++++++++++++++++++++++----------
+ drivers/net/dsa/b53/b53_regs.h   |  5 ++
+ include/linux/dsa/b53.h          | 24 ++++++++++
+ 3 files changed, 83 insertions(+), 24 deletions(-)
+ create mode 100644 include/linux/dsa/b53.h
+
+--- a/drivers/net/dsa/b53/b53_common.c
++++ b/drivers/net/dsa/b53/b53_common.c
+@@ -18,6 +18,7 @@
+  */
+ 
+ #include <linux/delay.h>
++#include <linux/dsa/b53.h>
+ #include <linux/export.h>
+ #include <linux/gpio.h>
+ #include <linux/kernel.h>
+@@ -695,6 +696,8 @@ enum {
+ 	B53_FA_TRAP_TTL,
+ 	B53_FA_TRAP_FIN,
+ 	B53_FA_TRAP_RST,
++	B53_FA_TRAP_FIN6,
++	B53_FA_TRAP_RST6,
+ 	B53_FA_TRAP_NUM,
+ };
+ 
+@@ -704,23 +707,23 @@ static int b53_fa_trap_set(struct b53_de
+ 	u32 mask[B53_CFP_NUM_KEY_REGS] = {
+ 		CFP_DATA0_SLICE_VALID | CFP_DATA0_SLICE_ID_MASK
+ 	};
+-	int err;
++	int err, v6;
+ 
+-	/* IPv4 from the ports in @src: the source port map key matches
+-	 * the ports that the mask leaves out
++	/* From the ports in @src: the source port map key matches the
++	 * ports that the mask leaves out
+ 	 */
+-	mask[6] = CFP_DATA6_L3_FRAMING_MASK;
+ 	mask[7] = 0xff & ~src;
+ 
+-	/* TTL 0 or 1, which the flow accelerator drops after its decrement
+-	 * instead of leaving the ICMP time exceeded message to the host.
+-	 * The TTL range field (bits 4:3) holds 0 for TTL 0, 1 for TTL 1,
+-	 * 2 for TTL 2 to 254 and 3 for TTL 255 (measured on a BCM4708), so
+-	 * a clear bit 4 matches exactly TTL 0 and 1.
++	/* IPv4 and IPv6 with TTL or hop limit 0 or 1. The flow accelerator
++	 * drops such an IPv4 frame after its decrement instead of leaving
++	 * the ICMP time exceeded message to the host, and forwards an IPv6
++	 * one with hop limit 0. The TTL range field (bits 4:3) holds 0 for
++	 * TTL 0, 1 for TTL 1, 2 for TTL 2 to 254 and 3 for TTL 255
++	 * (measured on a BCM4708), so a clear bit 4 matches exactly TTL 0
++	 * and 1.
+ 	 */
+-	mask[6] |= CFP_DATA6_TTL_RANGE_HIGH;
++	mask[6] = CFP_DATA6_L3_FRAMING_NOT_IP | CFP_DATA6_TTL_RANGE_HIGH;
+ 	err = b53_cfp_redirect(dev, B53_FA_TRAP_TTL, data, mask, map);
+-	mask[6] &= ~CFP_DATA6_TTL_RANGE_HIGH;
+ 	if (err)
+ 		return err;
+ 
+@@ -730,22 +733,36 @@ static int b53_fa_trap_set(struct b53_de
+ 	 */
+ 	b53_write8(dev, B53_CFP_PAGE, B53_CFP_UDF_0_A_0,
+ 		   CFP_UDF_EOL3 | B53_CFP_UDF_TCP_FLAGS);
++	b53_write8(dev, B53_CFP_PAGE, B53_CFP_UDF_0_B_0,
++		   CFP_UDF_EOL3 | B53_CFP_UDF_TCP_FLAGS);
+ 	data[5] = CFP_DATA5_UDF_VALID_0;
+ 	mask[5] = CFP_DATA5_UDF_VALID_0;
+-	data[6] = IPPROTO_TCP << CFP_DATA6_IP_PROTO_S;
+-	mask[6] |= CFP_DATA6_IP_PROTO_MASK;
++	mask[6] = CFP_DATA6_L3_FRAMING_MASK | CFP_DATA6_IP_PROTO_MASK;
+ 
+-	data[0] |= CFP_UDF_TCP_FIN << CFP_DATA0_UDF_A0_S;
+-	mask[0] |= CFP_UDF_TCP_FIN << CFP_DATA0_UDF_A0_S;
+-	err = b53_cfp_redirect(dev, B53_FA_TRAP_FIN, data, mask, map);
+-	data[0] &= ~(CFP_UDF_TCP_FIN << CFP_DATA0_UDF_A0_S);
+-	mask[0] &= ~(CFP_UDF_TCP_FIN << CFP_DATA0_UDF_A0_S);
+-	if (err)
+-		return err;
++	for (v6 = 0; v6 <= 1; v6++) {
++		data[6] = IPPROTO_TCP << CFP_DATA6_IP_PROTO_S |
++			  (v6 ? CFP_DATA6_L3_FRAMING_IP6 : 0);
++
++		data[0] = CFP_DATA0_SLICE_VALID |
++			  CFP_UDF_TCP_FIN << CFP_DATA0_UDF_A0_S;
++		mask[0] |= data[0];
++		err = b53_cfp_redirect(dev, v6 ? B53_FA_TRAP_FIN6 :
++				       B53_FA_TRAP_FIN, data, mask, map);
++		mask[0] &= ~(CFP_UDF_TCP_FIN << CFP_DATA0_UDF_A0_S);
++		if (err)
++			return err;
++
++		data[0] = CFP_DATA0_SLICE_VALID |
++			  CFP_UDF_TCP_RST << CFP_DATA0_UDF_A0_S;
++		mask[0] |= data[0];
++		err = b53_cfp_redirect(dev, v6 ? B53_FA_TRAP_RST6 :
++				       B53_FA_TRAP_RST, data, mask, map);
++		mask[0] &= ~(CFP_UDF_TCP_RST << CFP_DATA0_UDF_A0_S);
++		if (err)
++			return err;
++	}
+ 
+-	data[0] |= CFP_UDF_TCP_RST << CFP_DATA0_UDF_A0_S;
+-	mask[0] |= CFP_UDF_TCP_RST << CFP_DATA0_UDF_A0_S;
+-	return b53_cfp_redirect(dev, B53_FA_TRAP_RST, data, mask, map);
++	return 0;
+ }
+ 
+ static void b53_fa_trap_clear(struct b53_device *dev)
+@@ -3188,6 +3205,19 @@ static const struct dsa_switch_ops b53_s
+ 	.port_change_mtu	= b53_change_mtu,
+ };
+ 
++/* For the driver of the flow accelerator in front of port 8: are the
++ * frames that it cannot handle trapped for @port? Without the traps it
++ * forwards IPv6 frames with hop limit 1.
++ */
++bool b53_fa_trap_active(struct dsa_switch *ds, int port)
++{
++	struct b53_device *dev = ds->priv;
++
++	return ds->ops == &b53_switch_ops &&
++	       READ_ONCE(dev->fa_trap_ports) & b53_cfp_port_bit(port);
++}
++EXPORT_SYMBOL(b53_fa_trap_active);
++
+ static const struct b53_arl_ops b53_arl_ops_25 = {
+ 	.arl_read_entry = b53_arl_read_entry_25,
+ 	.arl_write_entry = b53_arl_write_entry_25,
+--- a/drivers/net/dsa/b53/b53_regs.h
++++ b/drivers/net/dsa/b53/b53_regs.h
+@@ -612,6 +612,9 @@
+ #define   CFP_UDF_TCP_FIN		BIT(0)	/* in the flags word */
+ #define   CFP_UDF_TCP_RST		BIT(2)
+ 
++/* The same for IPv6 frames (8 bit) */
++#define B53_CFP_UDF_0_B_0		0x40
++
+ /*************************************************************************
+  * CFP TCAM and Action/Policy RAM Access Page Registers
+  *************************************************************************/
+@@ -635,6 +638,8 @@
+ #define   CFP_DATA6_IP_PROTO_S		8
+ #define   CFP_DATA6_IP_PROTO_MASK	(0xff << 8)
+ #define   CFP_DATA6_L3_FRAMING_MASK	(0x3 << 24) /* 0: IPv4 */
++#define   CFP_DATA6_L3_FRAMING_IP6	BIT(24)
++#define   CFP_DATA6_L3_FRAMING_NOT_IP	BIT(25)	/* IPv4 or IPv6 if clear */
+ #define B53_CFP_NUM_KEY_REGS		8
+ 
+ /* CFP Action/Policy Data Registers (32 bit) */
+--- /dev/null
++++ b/include/linux/dsa/b53.h
+@@ -0,0 +1,24 @@
++/* SPDX-License-Identifier: ISC */
++/*
++ * B53 switch driver: interface for the driver of the flow accelerator
++ * in front of port 8 of the BCM5301x switches
++ */
++
++#ifndef _LINUX_DSA_B53_H
++#define _LINUX_DSA_B53_H
++
++#include <linux/kconfig.h>
++#include <linux/types.h>
++
++struct dsa_switch;
++
++#if IS_REACHABLE(CONFIG_B53)
++bool b53_fa_trap_active(struct dsa_switch *ds, int port);
++#else
++static inline bool b53_fa_trap_active(struct dsa_switch *ds, int port)
++{
++	return false;
++}
++#endif
++
++#endif /* _LINUX_DSA_B53_H */
diff --git a/target/linux/bcm53xx/patches-6.18/729-net-bgmac-offload-IPv6-flows-to-the-Northstar-flow-accelerator.patch b/target/linux/bcm53xx/patches-6.18/729-net-bgmac-offload-IPv6-flows-to-the-Northstar-flow-accelerator.patch
new file mode 100644
index 0000000000..6824eb8432
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/729-net-bgmac-offload-IPv6-flows-to-the-Northstar-flow-accelerator.patch
@@ -0,0 +1,463 @@
+From 0feddab655459d3c808d39e4fad72142d6489af8 Mon Sep 17 00:00:00 2001
+From: Erik Conijn <egc112@msn.com>
+Date: Sat, 14 Nov 2026 16:51:38 +0100
+Subject: [PATCH] net: bgmac: offload IPv6 flows to the Northstar flow
+ accelerator
+
+The flow accelerator can forward IPv6, which Broadcom's driver does not
+use: fa_napt_add() refuses it. The registers for the IPv6 next header
+values and a second valid bit in the flow entry show that the hardware
+has it, and the dump code of that driver reads such a flow from two
+entries. The rest was measured on a BCM4708 (Linksys EA6900):
+
+- The hash is that of IPv4 with 128-bit addresses. The accelerator puts
+  the flow id in the tag of the frames it does not forward: 68 of 68
+  flows match.
+- A flow takes two entries. The first has the fields of an IPv4 entry,
+  with the ports and the TCP bit 96 bits up and the valid bit at bit
+  244; the second has the destination and the source address. Changing
+  any one field gives no hits.
+- The accelerator only finds such a pair at the first or the third entry
+  of a bucket, so a bucket holds two IPv6 flows at most. Let an IPv4
+  flow prefer an entry whose neighbour is in use.
+- It decrements the hop limit, but does not check it: hop limit 1 leaves
+  as 0.
+
+So offload routed IPv6 TCP and UDP, and only while the switch traps hop
+limit 1 in front of the accelerator (b53_fa_trap_active()). The trap
+goes when its conduit goes down, without a word to this driver, so check
+again when the flowtable asks for the counters of a flow, and take the
+flow out then. IPv6 with NAT stays in software: those fields are not
+known.
+
+The entry with the addresses has source address bits where an IPv4 entry
+has its valid bit and the bit that tells it is one. Refuse a flow whose
+source address sets both; no global unicast address does.
+
+EA6900, iperf3 TCP between a LAN host and a host on the WAN side, up and
+down in Mbit/s, and the idle time of the router's two cores:
+
+                          IPv6                 IPv4
+  software flowtable      629 (up only)        456 / 535, 50 %
+  flow accelerator        928 / 928, 95-100 %  941 / 941, 95 %
+
+16 parallel IPv6 connections: 34 flows in the accelerator, 928 Mbit/s,
+none left 3 s after the test. With the trap conduit taken down during a
+test the IPv6 flows left the accelerator within 1 s and went on in
+software.
+
+Assisted-by: Claude:claude-fable-5-2
+Signed-off-by: Erik Conijn <egc112@msn.com>
+---
+ drivers/net/ethernet/broadcom/bgmac-fa.c | 215 ++++++++++++++++++-----
+ 1 file changed, 173 insertions(+), 42 deletions(-)
+
+--- a/drivers/net/ethernet/broadcom/bgmac-fa.c
++++ b/drivers/net/ethernet/broadcom/bgmac-fa.c
+@@ -39,6 +39,13 @@
+  * that its hash selects. The FA decrements the TTL, rewrites the MAC
+  * addresses and, for NAT, the address and port, and sends the frame back
+  * to the switch. It counts hits per entry, not bytes.
++ *
++ * It forwards routed IPv6 TCP and UDP as well, which Broadcom's driver
++ * does not use: the hash over the wider addresses, the format of the two
++ * entries that such a flow takes, and where in a bucket the FA looks for
++ * them were measured on a BCM4708. The FA has no hop limit check, it
++ * forwards hop limit 1 as 0. So it only gets IPv6 flows while the switch
++ * traps those frames in front of it (see b53_fa_trap_active()).
+  */
+ 
+ #include <linux/bcma/bcma.h>
+@@ -47,7 +54,9 @@
+ #include <linux/etherdevice.h>
+ #include <linux/hashtable.h>
+ #include <linux/iopoll.h>
++#include <linux/dsa/b53.h>
+ #include <linux/ip.h>
++#include <linux/ipv6.h>
+ #include <linux/module.h>
+ #include <linux/slab.h>
+ #include <net/dsa.h>
+@@ -130,6 +139,14 @@
+ #define FA_FLOW_VALID			212
+ #define FA_FLOW_IPV4			255
+ 
++/* IPv6 flow entry: these fields as above, the addresses in the next entry
++ * (destination in bits 0 to 127, source above it)
++ */
++#define FA_FLOW6_DPORT			191	/* 16 bits */
++#define FA_FLOW6_SPORT			207	/* 16 bits */
++#define FA_FLOW6_TCP			223
++#define FA_FLOW6_VALID			244
++
+ /* next hop entry */
+ #define FA_NH_TAG_OP			1	/* 2 bits */
+ #define  FA_NH_TAG_NONE			2
+@@ -140,9 +157,11 @@
+ #define FA_POOL_SA			1	/* 48 bits */
+ 
+ struct bgmac_fa_tuple {
+-	__be32 sip, dip;
++	struct in6_addr sip6, dip6;	/* IPv6 */
++	__be32 sip, dip;		/* IPv4 */
+ 	__be16 sport, dport;
+ 	u8 proto;
++	bool v6;
+ };
+ 
+ struct bgmac_fa_next_hop {
+@@ -168,7 +187,8 @@ struct bgmac_fa_flow {
+ 	unsigned long cookie;
+ 	struct bgmac_fa_block *block;
+ 	struct bgmac_fa_tuple t;
+-	int idx, next_hop, pool;
++	struct dsa_port *in;		/* ingress port */
++	int idx, next_hop, pool;	/* IPv6: entries idx and idx + 1 */
+ 	u32 hits;			/* last read from the entry */
+ 	u64 lastused;
+ };
+@@ -394,22 +414,30 @@ static int bgmac_fa_tbl_write(struct bgm
+ 
+ /* The software hash (fa_crc_ccitt()): CRC-ITU-T over 7 zero bits, the
+  * source and destination address, a TCP bit and the source and
+- * destination port; the low 8 bits select a bucket of four entries.
++ * destination port; the low 8 bits select a bucket of four entries. For
++ * IPv6 the same with 128-bit addresses (measured against the flow ids
++ * that the FA puts in the tag of the frames it does not forward).
+  */
+ static int bgmac_fa_bucket(const struct bgmac_fa_tuple *t)
+ {
+-	u8 key[13] = {};
++	int len = t->v6 ? 33 : 9;	/* up to the TCP bit */
++	u8 key[37] = {};
+ 	int i;
+ 
+-	memcpy(&key[1], &t->sip, 4);
+-	memcpy(&key[5], &t->dip, 4);
+-	memcpy(&key[9], &t->sport, 2);
+-	memcpy(&key[11], &t->dport, 2);
+-	for (i = 0; i < 8; i++)
++	if (t->v6) {
++		memcpy(&key[1], &t->sip6, 16);
++		memcpy(&key[17], &t->dip6, 16);
++	} else {
++		memcpy(&key[1], &t->sip, 4);
++		memcpy(&key[5], &t->dip, 4);
++	}
++	memcpy(&key[len], &t->sport, 2);
++	memcpy(&key[len + 2], &t->dport, 2);
++	for (i = 0; i < len - 1; i++)
+ 		key[i] = (key[i] << 1) | (key[i + 1] >> 7);
+-	key[8] = (key[8] << 1) | (t->proto == IPPROTO_TCP);
++	key[len - 1] = (key[len - 1] << 1) | (t->proto == IPPROTO_TCP);
+ 
+-	return (crc_itu_t(0, key, sizeof(key)) & 0xff) * FA_FLOW_BUCKET;
++	return (crc_itu_t(0, key, len + 4) & 0xff) * FA_FLOW_BUCKET;
+ }
+ 
+ /* ---------- next hops and pools, shared and refcounted ---------- */
+@@ -539,7 +567,7 @@ struct bgmac_fa_rule {
+ 	__be32 nat_ip;
+ 	__be16 nat_port;
+ 	bool snat, dnat;		/* neither: routing only */
+-	struct dsa_port *out;
++	struct dsa_port *in, *out;
+ };
+ 
+ /* a user port of the switch behind this conduit */
+@@ -591,7 +619,6 @@ static int bgmac_fa_parse(struct bgmac *
+ 	if (!flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_META) ||
+ 	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CONTROL) ||
+ 	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_BASIC) ||
+-	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IPV4_ADDRS) ||
+ 	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS) ||
+ 	    flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_VLAN) ||
+ 	    flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CVLAN))
+@@ -600,22 +627,26 @@ static int bgmac_fa_parse(struct bgmac *
+ 	{
+ 		struct flow_match_meta m;
+ 		struct net_device *in;
+-		bool ours;
+ 
+ 		flow_rule_match_meta(rule, &m);
+ 		rcu_read_lock();
+ 		in = dev_get_by_index_rcu(&init_net, m.key->ingress_ifindex);
+-		ours = bgmac_fa_user_port(bgmac, in);
++		r->in = bgmac_fa_user_port(bgmac, in);
+ 		rcu_read_unlock();
+-		if (!ours)
++		if (!r->in)
+ 			return -EOPNOTSUPP;
+ 	}
+ 	{
+ 		struct flow_match_control m;
+ 
+ 		flow_rule_match_control(rule, &m);
+-		if (m.key->addr_type != FLOW_DISSECTOR_KEY_IPV4_ADDRS ||
+-		    m.mask->flags)
++		if (m.mask->flags)
++			return -EOPNOTSUPP;
++		if (m.key->addr_type == FLOW_DISSECTOR_KEY_IPV6_ADDRS)
++			r->t.v6 = true;
++		else if (m.key->addr_type != FLOW_DISSECTOR_KEY_IPV4_ADDRS)
++			return -EOPNOTSUPP;
++		if (!flow_rule_match_key(rule, m.key->addr_type))
+ 			return -EOPNOTSUPP;
+ 	}
+ 	{
+@@ -626,7 +657,13 @@ static int bgmac_fa_parse(struct bgmac *
+ 		if (r->t.proto != IPPROTO_TCP && r->t.proto != IPPROTO_UDP)
+ 			return -EOPNOTSUPP;
+ 	}
+-	{
++	if (r->t.v6) {
++		struct flow_match_ipv6_addrs m;
++
++		flow_rule_match_ipv6_addrs(rule, &m);
++		r->t.sip6 = m.key->src;
++		r->t.dip6 = m.key->dst;
++	} else {
+ 		struct flow_match_ipv4_addrs m;
+ 
+ 		flow_rule_match_ipv4_addrs(rule, &m);
+@@ -687,6 +724,22 @@ static int bgmac_fa_parse(struct bgmac *
+ 		}
+ 	}
+ 
++	/* IPv6 is routed only (its NAT mangles were refused above), and
++	 * needs the switch to trap hop limit 1 in front of the FA
++	 */
++	if (r->t.v6 && !b53_fa_trap_active(r->in->ds, r->in->index))
++		return -EOPNOTSUPP;
++
++	/* The entry with the addresses of an IPv6 flow has the source
++	 * address where an IPv4 entry has its valid bit and the bit that
++	 * tells it is one. It must not look like a valid IPv4 entry; no
++	 * global unicast address has the upper bit set.
++	 */
++	if (r->t.v6 &&
++	    ntohl(r->t.sip6.s6_addr32[0]) & BIT(FA_FLOW_IPV4 % 32) &&
++	    ntohl(r->t.sip6.s6_addr32[1]) & BIT(FA_FLOW_VALID % 32))
++		return -EOPNOTSUPP;
++
+ 	/* One kind of NAT at most: the entry overwrites the source or the
+ 	 * destination, address and port together.
+ 	 */
+@@ -729,18 +782,57 @@ static bool bgmac_fa_tuple_offloaded(str
+ 	struct bgmac_fa_flow *flow;
+ 	int bkt;
+ 
+-	hash_for_each(fa->flows, bkt, flow, node)
+-		if (flow->t.sip == t->sip && flow->t.dip == t->dip &&
+-		    flow->t.sport == t->sport && flow->t.dport == t->dport &&
+-		    flow->t.proto == t->proto)
++	hash_for_each(fa->flows, bkt, flow, node) {
++		if (flow->t.v6 != t->v6 || flow->t.proto != t->proto ||
++		    flow->t.sport != t->sport || flow->t.dport != t->dport)
++			continue;
++		if (t->v6 ? ipv6_addr_equal(&flow->t.sip6, &t->sip6) &&
++			    ipv6_addr_equal(&flow->t.dip6, &t->dip6) :
++			    flow->t.sip == t->sip && flow->t.dip == t->dip)
+ 			return true;
++	}
+ 	return false;
+ }
+ 
+-static int bgmac_fa_free_slots(struct bgmac_fa *fa, int base)
++/* An IPv6 flow takes two entries, and the FA only finds such a pair at
++ * the first or the third entry of a bucket (measured). An IPv4 flow takes
++ * one: prefer an entry whose neighbour is in use, as that costs no pair.
++ * Returns the offset in the bucket, or -1.
++ */
++static int bgmac_fa_pick(struct bgmac_fa *fa, int base, bool v6)
++{
++	int i, any = -1;
++
++	if (v6) {
++		for (i = 0; i < FA_FLOW_BUCKET; i += 2)
++			if (!test_bit(base + i, fa->used) &&
++			    !test_bit(base + i + 1, fa->used))
++				return i;
++		return -1;
++	}
++
++	for (i = 0; i < FA_FLOW_BUCKET; i++) {
++		if (test_bit(base + i, fa->used))
++			continue;
++		if (test_bit(base + (i ^ 1), fa->used))
++			return i;
++		if (any < 0)
++			any = i;
++	}
++	return any;
++}
++
++/* how many more flows of this kind fit in the bucket */
++static int bgmac_fa_room(struct bgmac_fa *fa, int base, bool v6)
+ {
+ 	int i, n = 0;
+ 
++	if (v6)
++		return (!test_bit(base, fa->used) &&
++			!test_bit(base + 1, fa->used)) +
++		       (!test_bit(base + 2, fa->used) &&
++			!test_bit(base + 3, fa->used));
++
+ 	for (i = 0; i < FA_FLOW_BUCKET; i++)
+ 		n += !test_bit(base + i, fa->used);
+ 	return n;
+@@ -754,7 +846,7 @@ static int bgmac_fa_free_slots(struct bg
+ static bool bgmac_fa_reply_fits(struct bgmac_fa *fa,
+ 				const struct bgmac_fa_rule *r, int base)
+ {
+-	struct bgmac_fa_tuple rt = { .proto = r->t.proto };
++	struct bgmac_fa_tuple rt = { .proto = r->t.proto, .v6 = r->t.v6 };
+ 	int rbase;
+ 
+ 	if (r->dnat) {		/* reply: from the NAT address and port */
+@@ -769,8 +861,10 @@ static bool bgmac_fa_reply_fits(struct b
+ 		rt.dport = r->nat_port;
+ 	} else {
+ 		rt.sip = r->t.dip;
++		rt.sip6 = r->t.dip6;
+ 		rt.sport = r->t.dport;
+ 		rt.dip = r->t.sip;
++		rt.dip6 = r->t.sip6;
+ 		rt.dport = r->t.sport;
+ 	}
+ 
+@@ -778,14 +872,14 @@ static bool bgmac_fa_reply_fits(struct b
+ 		return true;
+ 
+ 	rbase = bgmac_fa_bucket(&rt);
+-	return bgmac_fa_free_slots(fa, rbase) >= (rbase == base ? 2 : 1);
++	return bgmac_fa_room(fa, rbase, rt.v6) >= (rbase == base ? 2 : 1);
+ }
+ 
+ static int bgmac_fa_flow_add(struct bgmac *bgmac, struct flow_cls_offload *f,
+ 			     struct bgmac_fa_block *block)
+ {
+ 	struct bgmac_fa *fa = bgmac->fa;
+-	u32 e[FA_FLOW_WORDS] = {};
++	u32 e[FA_FLOW_WORDS] = {}, addr[FA_FLOW_WORDS];
+ 	struct bgmac_fa_flow *flow;
+ 	struct bgmac_fa_rule r;
+ 	int base, i, err;
+@@ -801,10 +895,8 @@ static int bgmac_fa_flow_add(struct bgma
+ 		return err;
+ 
+ 	base = bgmac_fa_bucket(&r.t);
+-	for (i = 0; i < FA_FLOW_BUCKET; i++)
+-		if (!test_bit(base + i, fa->used))
+-			break;
+-	if (i == FA_FLOW_BUCKET || !bgmac_fa_reply_fits(fa, &r, base))
++	i = bgmac_fa_pick(fa, base, r.t.v6);
++	if (i < 0 || !bgmac_fa_reply_fits(fa, &r, base))
+ 		return -ENOSPC;
+ 
+ 	flow = kzalloc(sizeof(*flow), GFP_KERNEL);
+@@ -814,6 +906,7 @@ static int bgmac_fa_flow_add(struct bgma
+ 	flow->cookie = f->cookie;
+ 	flow->block = block;
+ 	flow->t = r.t;
++	flow->in = r.in;
+ 	flow->idx = base + i;
+ 	flow->lastused = jiffies;
+ 
+@@ -841,16 +934,33 @@ static int bgmac_fa_flow_add(struct bgma
+ 	fa_put_bits(e, FA_FLOW_ACTION, 2, action);
+ 	fa_put_bits(e, FA_FLOW_POOL, 2, flow->pool);
+ 	fa_put_bits(e, FA_FLOW_NEXT_HOP, 7, flow->next_hop);
+-	fa_put_bits(e, FA_FLOW_NAT_IP, 32, ntohl(r.nat_ip));
+-	fa_put_bits(e, FA_FLOW_NAT_PORT, 16, ntohs(r.nat_port));
+-	fa_put_bits(e, FA_FLOW_DPORT, 16, ntohs(r.t.dport));
+-	fa_put_bits(e, FA_FLOW_SPORT, 16, ntohs(r.t.sport));
+-	fa_put_bits(e, FA_FLOW_TCP, 1, r.t.proto == IPPROTO_TCP);
+-	fa_put_bits(e, FA_FLOW_DIP, 32, ntohl(r.t.dip));
+-	fa_put_bits(e, FA_FLOW_SIP, 32, ntohl(r.t.sip));
+-	fa_put_bits(e, FA_FLOW_OVRW_DEST, 1, r.dnat);
+-	fa_put_bits(e, FA_FLOW_VALID, 1, 1);
+-	fa_put_bits(e, FA_FLOW_IPV4, 1, 1);
++	if (r.t.v6) {
++		fa_put_bits(e, FA_FLOW6_DPORT, 16, ntohs(r.t.dport));
++		fa_put_bits(e, FA_FLOW6_SPORT, 16, ntohs(r.t.sport));
++		fa_put_bits(e, FA_FLOW6_TCP, 1, r.t.proto == IPPROTO_TCP);
++		fa_put_bits(e, FA_FLOW6_VALID, 1, 1);
++
++		/* the addresses first: the valid bit is in the other entry */
++		for (i = 0; i < 4; i++) {
++			addr[3 - i] = ntohl(r.t.dip6.s6_addr32[i]);
++			addr[7 - i] = ntohl(r.t.sip6.s6_addr32[i]);
++		}
++		err = bgmac_fa_tbl_write(bgmac, FA_TBL_FLOW, flow->idx + 1,
++					 addr, FA_FLOW_WORDS);
++		if (err)
++			goto put_pool;
++	} else {
++		fa_put_bits(e, FA_FLOW_NAT_IP, 32, ntohl(r.nat_ip));
++		fa_put_bits(e, FA_FLOW_NAT_PORT, 16, ntohs(r.nat_port));
++		fa_put_bits(e, FA_FLOW_DPORT, 16, ntohs(r.t.dport));
++		fa_put_bits(e, FA_FLOW_SPORT, 16, ntohs(r.t.sport));
++		fa_put_bits(e, FA_FLOW_TCP, 1, r.t.proto == IPPROTO_TCP);
++		fa_put_bits(e, FA_FLOW_DIP, 32, ntohl(r.t.dip));
++		fa_put_bits(e, FA_FLOW_SIP, 32, ntohl(r.t.sip));
++		fa_put_bits(e, FA_FLOW_OVRW_DEST, 1, r.dnat);
++		fa_put_bits(e, FA_FLOW_VALID, 1, 1);
++		fa_put_bits(e, FA_FLOW_IPV4, 1, 1);
++	}
+ 
+ 	err = bgmac_fa_tbl_write(bgmac, FA_TBL_FLOW, flow->idx, e,
+ 				 FA_FLOW_WORDS);
+@@ -858,6 +968,8 @@ static int bgmac_fa_flow_add(struct bgma
+ 		goto put_pool;
+ 
+ 	set_bit(flow->idx, fa->used);
++	if (r.t.v6)
++		set_bit(flow->idx + 1, fa->used);
+ 	hash_add(fa->flows, &flow->node, flow->cookie);
+ 
+ 	return 0;
+@@ -873,16 +985,24 @@ free:
+ 
+ static void bgmac_fa_flow_remove(struct bgmac *bgmac, struct bgmac_fa_flow *flow)
+ {
++	int valid = flow->t.v6 ? FA_FLOW6_VALID : FA_FLOW_VALID;
+ 	u32 e[FA_FLOW_WORDS];
+ 
+ 	/* _fa_napt_del(): clear the valid bit, keep the rest */
+ 	if (!bgmac_fa_tbl_read(bgmac, FA_TBL_FLOW, flow->idx, e, FA_FLOW_WORDS)) {
+-		e[FA_FLOW_VALID / 32] &= ~BIT(FA_FLOW_VALID % 32);
++		e[valid / 32] &= ~BIT(valid % 32);
+ 		bgmac_fa_tbl_write(bgmac, FA_TBL_FLOW, flow->idx, e,
+ 				   FA_FLOW_WORDS);
+ 	}
+ 
+ 	clear_bit(flow->idx, bgmac->fa->used);
++	if (flow->t.v6) {
++		/* the address entry may become an IPv4 flow's: clean */
++		memset(e, 0, sizeof(e));
++		bgmac_fa_tbl_write(bgmac, FA_TBL_FLOW, flow->idx + 1, e,
++				   FA_FLOW_WORDS);
++		clear_bit(flow->idx + 1, bgmac->fa->used);
++	}
+ 	bgmac_fa_pool_put(bgmac, flow->pool);
+ 	bgmac_fa_next_hop_put(bgmac, flow->next_hop);
+ 	hash_del(&flow->node);
+@@ -908,6 +1028,17 @@ static int bgmac_fa_flow_stats(struct bg
+ 	if (!flow)
+ 		return -ENOENT;
+ 
++	/* The hop limit trap goes when its conduit goes down, without a
++	 * word to this driver. The flowtable asks for the counters of a
++	 * flow every few seconds: take the flow out here, it goes on in
++	 * software.
++	 */
++	if (flow->t.v6 &&
++	    !b53_fa_trap_active(flow->in->ds, flow->in->index)) {
++		bgmac_fa_flow_remove(bgmac, flow);
++		return -ENOENT;
++	}
++
+ 	if (bgmac_fa_tbl_read(bgmac, FA_TBL_FLOW, flow->idx, e, FA_FLOW_WORDS))
+ 		return -EIO;
+ 
diff --git a/target/linux/bcm53xx/patches-6.18/730-net-dsa-b53-keep-VLAN-members-for-the-Northstar-flow-accelerator.patch b/target/linux/bcm53xx/patches-6.18/730-net-dsa-b53-keep-VLAN-members-for-the-Northstar-flow-accelerator.patch
new file mode 100644
index 0000000000..000c60b338
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/730-net-dsa-b53-keep-VLAN-members-for-the-Northstar-flow-accelerator.patch
@@ -0,0 +1,256 @@
+From 99a88f2dbe68a49f3a68d57ab6be5974082c89ef Mon Sep 17 00:00:00 2001
+From: Erik Conijn <egc112@msn.com>
+Date: Sat, 14 Nov 2026 15:21:39 +0100
+Subject: [PATCH] net: dsa: b53: keep VLAN members for the Northstar flow
+ accelerator
+
+The flow accelerator of the BCM470x/5301x sends the frames that it
+forwards back into the switch on port 8. When the egress port is an
+802.1Q upper of a user port, such as wan.10 for a WAN behind a tagged
+uplink, the accelerator adds the tag, and the frame goes through the
+VLAN lookup of the switch. The host's own frames do not: they carry a
+Broadcom tag that names the egress port.
+
+This driver writes the VLAN table only while VLAN filtering is on. The
+upper of a standalone port is no member of any VLAN, so the switch drops
+every frame that the accelerator forwards towards it. Measured on a
+BCM4708 (Linksys EA6900): the entry for VLAN 10 read back as 0x00000000,
+and the frames the accelerator found showed up as discards on port 8.
+
+Add b53_fa_vlan() for the accelerator's driver. It keeps the egress port
+and port 8 as tagged members of the VLAN while the accelerator has a
+next hop that adds that tag, and takes them out again with the last one.
+These members are kept apart from the bridge's, in fa_members, and are
+written along with them on every change of the entry, so that neither
+removes the other. With VLAN filtering off the entry holds only these
+members, and b53_configure_vlan() puts them back after it clears the
+table.
+
+The accelerator's driver calls this from its flow work, without the
+RTNL lock, so the table access gets a mutex of its own.
+
+EA6900, WAN on wan.10 behind a switch port tagged with VLAN 10: the
+entry for VLAN 10 reads 0x00000101 (ports 0 and 8, tagged) while flows
+are in the accelerator, and 0x00000000 again after the last one; the
+entry of VLAN 1 is not touched. TCP through the accelerator in Mbit/s,
+up / down: IPv4 939 / 935, IPv6 925 / 920 (941 / 941 and 928 / 928
+without the VLAN).
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Erik Conijn <egc112@msn.com>
+---
+ drivers/net/dsa/b53/b53_common.c | 81 ++++++++++++++++++++++++++++----
+ drivers/net/dsa/b53/b53_priv.h   |  2 +
+ include/linux/dsa/b53.h          |  8 ++++
+ 3 files changed, 82 insertions(+), 9 deletions(-)
+
+--- a/drivers/net/dsa/b53/b53_common.c
++++ b/drivers/net/dsa/b53/b53_common.c
+@@ -252,15 +252,19 @@ static int b53_do_vlan_op(struct b53_dev
+ 	return -EIO;
+ }
+ 
+-static void b53_set_vlan_entry(struct b53_device *dev, u16 vid,
+-			       struct b53_vlan *vlan)
++/* with dev->vlan_mutex held */
++static void __b53_set_vlan_entry(struct b53_device *dev, u16 vid,
++				 struct b53_vlan *vlan)
+ {
++	/* the flow accelerator's members are in the table whatever else is */
++	u16 members = vlan->members | dev->vlans[vid].fa_members;
++
+ 	if (is5325(dev)) {
+ 		u32 entry = 0;
+ 
+-		if (vlan->members) {
++		if (members) {
+ 			entry = ((vlan->untag & VA_UNTAG_MASK_25) <<
+-				 VA_UNTAG_S_25) | vlan->members;
++				 VA_UNTAG_S_25) | members;
+ 			if (dev->core_rev >= 3)
+ 				entry |= VA_VALID_25_R4 | vid << VA_VID_HIGH_S;
+ 			else
+@@ -273,9 +277,9 @@ static void b53_set_vlan_entry(struct b5
+ 	} else if (is5365(dev)) {
+ 		u16 entry = 0;
+ 
+-		if (vlan->members)
++		if (members)
+ 			entry = ((vlan->untag & VA_UNTAG_MASK_65) <<
+-				 VA_UNTAG_S_65) | vlan->members | VA_VALID_65;
++				 VA_UNTAG_S_65) | members | VA_VALID_65;
+ 
+ 		b53_write16(dev, B53_VLAN_PAGE, B53_VLAN_WRITE_65, entry);
+ 		b53_write16(dev, B53_VLAN_PAGE, B53_VLAN_TABLE_ACCESS_65, vid |
+@@ -283,18 +287,28 @@ static void b53_set_vlan_entry(struct b5
+ 	} else {
+ 		b53_write16(dev, B53_ARLIO_PAGE, dev->vta_regs[1], vid);
+ 		b53_write32(dev, B53_ARLIO_PAGE, dev->vta_regs[2],
+-			    (vlan->untag << VTE_UNTAG_S) | vlan->members);
++			    (vlan->untag << VTE_UNTAG_S) | members);
+ 
+ 		b53_do_vlan_op(dev, VTA_CMD_WRITE);
+ 	}
+ 
+ 	dev_dbg(dev->ds->dev, "VID: %d, members: 0x%04x, untag: 0x%04x\n",
+-		vid, vlan->members, vlan->untag);
++		vid, members, vlan->untag);
++}
++
++static void b53_set_vlan_entry(struct b53_device *dev, u16 vid,
++			       struct b53_vlan *vlan)
++{
++	mutex_lock(&dev->vlan_mutex);
++	__b53_set_vlan_entry(dev, vid, vlan);
++	mutex_unlock(&dev->vlan_mutex);
+ }
+ 
+ static void b53_get_vlan_entry(struct b53_device *dev, u16 vid,
+ 			       struct b53_vlan *vlan)
+ {
++	mutex_lock(&dev->vlan_mutex);
++
+ 	if (is5325(dev)) {
+ 		u32 entry = 0;
+ 
+@@ -329,6 +343,8 @@ static void b53_get_vlan_entry(struct b5
+ 		vlan->untag = (entry >> VTE_UNTAG_S) & VTE_MEMBERS;
+ 		vlan->valid = true;
+ 	}
++
++	mutex_unlock(&dev->vlan_mutex);
+ }
+ 
+ static void b53_set_eap_mode(struct b53_device *dev, int port, int mode)
+@@ -1296,7 +1312,9 @@ int b53_configure_vlan(struct dsa_switch
+ 		for (i = def_vid; i < dev->num_vlans; i++)
+ 			b53_set_vlan_entry(dev, i, &vl);
+ 	} else {
++		mutex_lock(&dev->vlan_mutex);
+ 		b53_do_vlan_op(dev, VTA_CMD_CLEAR);
++		mutex_unlock(&dev->vlan_mutex);
+ 	}
+ 
+ 	b53_enable_vlan(dev, -1, dev->vlan_enabled, dev->vlan_filtering);
+@@ -1327,7 +1345,7 @@ int b53_configure_vlan(struct dsa_switch
+ 		for (vid = def_vid + 1; vid < dev->num_vlans; vid++) {
+ 			v = &dev->vlans[vid];
+ 
+-			if (!v->members)
++			if (!v->members && !v->fa_members)
+ 				continue;
+ 
+ 			b53_set_vlan_entry(dev, vid, v);
+@@ -1340,6 +1358,13 @@ int b53_configure_vlan(struct dsa_switch
+ 					    B53_VLAN_PORT_DEF_TAG(i),
+ 					    dev->ports[i].pvid);
+ 		}
++	} else {
++		struct b53_vlan none = {};
++
++		/* the flow accelerator's VLANs, see b53_fa_vlan() */
++		for (vid = def_vid + 1; vid < dev->num_vlans; vid++)
++			if (dev->vlans[vid].fa_members)
++				b53_set_vlan_entry(dev, vid, &none);
+ 	}
+ 
+ 	return 0;
+@@ -3218,6 +3243,43 @@ bool b53_fa_trap_active(struct dsa_switc
+ }
+ EXPORT_SYMBOL(b53_fa_trap_active);
+ 
++/* For the driver of the flow accelerator: the frames that it forwards
++ * come back into the switch on port 8, with the tag of an 802.1Q upper
++ * of their egress port pushed, and go through the VLAN lookup, unlike the
++ * host's own frames, which name their egress port. This driver writes
++ * the VLAN table only while VLAN filtering is on, and the upper of a
++ * standalone port is no member of a VLAN at all: the frames would be
++ * dropped. Keep @port and port 8 in the table as tagged members of @vid,
++ * until the driver takes them out again.
++ */
++int b53_fa_vlan(struct dsa_switch *ds, int port, u16 vid, bool add)
++{
++	struct b53_device *dev = ds->priv;
++	struct b53_vlan none = {};
++	struct b53_vlan *vl;
++
++	if (ds->ops != &b53_switch_ops)
++		return -EOPNOTSUPP;
++	if (!vid || vid >= dev->num_vlans)
++		return -EINVAL;
++
++	vl = &dev->vlans[vid];
++
++	mutex_lock(&dev->vlan_mutex);
++	if (add) {
++		vl->fa_members |= BIT(port) | BIT(B53_CPU_PORT);
++	} else {
++		vl->fa_members &= ~BIT(port);
++		if (vl->fa_members == BIT(B53_CPU_PORT))
++			vl->fa_members = 0;
++	}
++	__b53_set_vlan_entry(dev, vid, dev->vlan_filtering ? vl : &none);
++	mutex_unlock(&dev->vlan_mutex);
++
++	return 0;
++}
++EXPORT_SYMBOL(b53_fa_vlan);
++
+ static const struct b53_arl_ops b53_arl_ops_25 = {
+ 	.arl_read_entry = b53_arl_read_entry_25,
+ 	.arl_write_entry = b53_arl_write_entry_25,
+@@ -3704,6 +3766,7 @@ struct b53_device *b53_switch_alloc(stru
+ 	mutex_init(&dev->reg_mutex);
+ 	mutex_init(&dev->stats_mutex);
+ 	mutex_init(&dev->arl_mutex);
++	mutex_init(&dev->vlan_mutex);
+ 
+ 	return dev;
+ }
+--- a/drivers/net/dsa/b53/b53_priv.h
++++ b/drivers/net/dsa/b53/b53_priv.h
+@@ -126,6 +126,7 @@ struct b53_port {
+ struct b53_vlan {
+ 	u16 members;
+ 	u16 untag;
++	u16 fa_members;		/* tagged, for the flow accelerator */
+ 	bool valid;
+ };
+ 
+@@ -137,6 +138,7 @@ struct b53_device {
+ 	struct mutex reg_mutex;
+ 	struct mutex stats_mutex;
+ 	struct mutex arl_mutex;
++	struct mutex vlan_mutex;	/* VLAN table access */
+ 	const struct b53_io_ops *ops;
+ 	const struct b53_arl_ops *arl_ops;
+ 
+--- a/include/linux/dsa/b53.h
++++ b/include/linux/dsa/b53.h
+@@ -7,6 +7,7 @@
+ #ifndef _LINUX_DSA_B53_H
+ #define _LINUX_DSA_B53_H
+ 
++#include <linux/errno.h>
+ #include <linux/kconfig.h>
+ #include <linux/types.h>
+ 
+@@ -14,11 +15,18 @@ struct dsa_switch;
+ 
+ #if IS_REACHABLE(CONFIG_B53)
+ bool b53_fa_trap_active(struct dsa_switch *ds, int port);
++int b53_fa_vlan(struct dsa_switch *ds, int port, u16 vid, bool add);
+ #else
+ static inline bool b53_fa_trap_active(struct dsa_switch *ds, int port)
+ {
+ 	return false;
+ }
++
++static inline int b53_fa_vlan(struct dsa_switch *ds, int port, u16 vid,
++			      bool add)
++{
++	return -EOPNOTSUPP;
++}
+ #endif
+ 
+ #endif /* _LINUX_DSA_B53_H */
diff --git a/target/linux/bcm53xx/patches-6.18/731-net-bgmac-offload-flows-over-802.1Q-uppers-to-the-flow-accelerator.patch b/target/linux/bcm53xx/patches-6.18/731-net-bgmac-offload-flows-over-802.1Q-uppers-to-the-flow-accelerator.patch
new file mode 100644
index 0000000000..ea573bfcda
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/731-net-bgmac-offload-flows-over-802.1Q-uppers-to-the-flow-accelerator.patch
@@ -0,0 +1,287 @@
+From b0ad87931a15789e7c55fba586316ef983602325 Mon Sep 17 00:00:00 2001
+From: Erik Conijn <egc112@msn.com>
+Date: Sat, 14 Nov 2026 16:51:38 +0100
+Subject: [PATCH] net: bgmac: offload flows over 802.1Q uppers to the flow
+ accelerator
+
+The flowtable describes a flow towards an 802.1Q upper of a user port
+with a VLAN_PUSH action, and a flow from one with a match on the VLAN
+key and a VLAN_POP action. The accelerator can do both: a next hop adds
+an 802.1Q tag (tag operation 1, with the TCI at bit 3 of the entry) or
+removes one (operation 2, the same as for an untagged next hop), and the
+accelerator finds a flow in a tagged frame as it does in an untagged
+one; it does not look at the tag.
+
+So offload flows with one 802.1Q tag: the VLAN ID becomes part of the
+next hop and of its static FDB entry, and the switch keeps the egress
+port and port 8 in the VLAN through b53_fa_vlan() while a next hop adds
+the tag. A flow that comes with a tag must have it removed, and a flow
+may not have its tag replaced: the accelerator was not measured doing
+that. 802.1ad and a second tag stay in software. The priority bits of
+the pushed tag are 0, as they are on the software path.
+
+EA6900, WAN on wan.10 behind a switch port tagged with VLAN 10, iperf3
+TCP between a LAN host and a host on the WAN side, in Mbit/s, with the
+idle time of the router's two cores:
+
+                          up    down
+  IPv4                    939   935    99 %
+  IPv6                    925   920    99-100 %
+
+- The switch traps also catch the tagged frames from the WAN, and these
+  reach Linux through wan.10. A UDP flow in the accelerator, 12 packets
+  with TTL 1 among 24 with TTL 64 sent from the WAN side: the LAN host
+  got the 24, the sender 12 ICMPv6 time exceeded for IPv6 and 8 ICMP
+  time exceeded for IPv4 (the rest held back by the ICMP rate limit).
+  A ping with TTL 1 to the router's WAN address is answered. From the
+  LAN, TCP segments with TTL 1 in a flow in the accelerator get their
+  time exceeded (4 of 4, IPv4 and IPv6), and a FIN or an RST takes
+  the flow out of the accelerator within 1 s.
+- A firewall reload 8 s into a test: IPv4 937 on average, IPv6 with 4
+  connections 924, with its 8 flows back in the accelerator within 2 s.
+- Untagged traffic between two LAN ports is not affected.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Erik Conijn <egc112@msn.com>
+---
+ drivers/net/ethernet/broadcom/bgmac-fa.c | 107 +++++++++++++++++++----
+ 1 file changed, 92 insertions(+), 15 deletions(-)
+
+--- a/drivers/net/ethernet/broadcom/bgmac-fa.c
++++ b/drivers/net/ethernet/broadcom/bgmac-fa.c
+@@ -38,7 +38,9 @@
+  * Each direction is one entry of the flow table, in one of the four slots
+  * that its hash selects. The FA decrements the TTL, rewrites the MAC
+  * addresses and, for NAT, the address and port, and sends the frame back
+- * to the switch. It counts hits per entry, not bytes.
++ * to the switch. It counts hits per entry, not bytes. Towards an 802.1Q
++ * upper of a user port it adds the VLAN tag, and it takes the tag off a
++ * frame that comes from one.
+  *
+  * It forwards routed IPv6 TCP and UDP as well, which Broadcom's driver
+  * does not use: the hash over the wider addresses, the format of the two
+@@ -53,6 +55,7 @@
+ #include <linux/crc-itu-t.h>
+ #include <linux/etherdevice.h>
+ #include <linux/hashtable.h>
++#include <linux/if_vlan.h>
+ #include <linux/iopoll.h>
+ #include <linux/dsa/b53.h>
+ #include <linux/ip.h>
+@@ -149,7 +152,9 @@
+ 
+ /* next hop entry */
+ #define FA_NH_TAG_OP			1	/* 2 bits */
+-#define  FA_NH_TAG_NONE			2
++#define  FA_NH_TAG_CTAG			1	/* 802.1Q tag with the TCI */
++#define  FA_NH_TAG_NONE			2	/* untagged, also removes one */
++#define FA_NH_VLAN_TCI			3	/* 16 bits */
+ #define FA_NH_DA			19	/* 48 bits */
+ 
+ /* pool entry */
+@@ -167,6 +172,7 @@ struct bgmac_fa_tuple {
+ struct bgmac_fa_next_hop {
+ 	u8 mac[ETH_ALEN];
+ 	struct dsa_port *dp;		/* egress port */
++	u16 vid;			/* VLAN tag to add, or 0 */
+ 	int refs;
+ 	bool fdb;			/* static switch FDB entry added for it */
+ };
+@@ -442,8 +448,22 @@ static int bgmac_fa_bucket(const struct
+ 
+ /* ---------- next hops and pools, shared and refcounted ---------- */
+ 
++/* another next hop that adds this VLAN tag towards this port */
++static bool bgmac_fa_vlan_in_use(struct bgmac_fa *fa,
++				 const struct bgmac_fa_next_hop *nh)
++{
++	int i;
++
++	for (i = 0; i < FA_NEXT_HOPS; i++)
++		if (&fa->next_hop[i] != nh && fa->next_hop[i].refs &&
++		    fa->next_hop[i].dp == nh->dp &&
++		    fa->next_hop[i].vid == nh->vid)
++			return true;
++	return false;
++}
++
+ static int bgmac_fa_next_hop_get(struct bgmac *bgmac, const u8 *mac,
+-				 struct dsa_port *dp)
++				 struct dsa_port *dp, u16 vid)
+ {
+ 	struct bgmac_fa *fa = bgmac->fa;
+ 	struct bgmac_fa_next_hop *nh;
+@@ -452,7 +472,8 @@ static int bgmac_fa_next_hop_get(struct
+ 
+ 	for (i = 0; i < FA_NEXT_HOPS; i++) {
+ 		nh = &fa->next_hop[i];
+-		if (nh->refs && nh->dp == dp && ether_addr_equal(nh->mac, mac)) {
++		if (nh->refs && nh->dp == dp && nh->vid == vid &&
++		    ether_addr_equal(nh->mac, mac)) {
+ 			nh->refs++;
+ 			return i;
+ 		}
+@@ -462,17 +483,29 @@ static int bgmac_fa_next_hop_get(struct
+ 	if (free < 0)
+ 		return -ENOSPC;
+ 
+-	/* Ethernet, no tag, destination address */
+-	fa_put_bits(d, FA_NH_TAG_OP, 2, FA_NH_TAG_NONE);
++	nh = &fa->next_hop[free];
++	nh->dp = dp;
++	nh->vid = vid;
++
++	/* The switch drops the FA's tagged output unless the egress port
++	 * and the FA's own port are members of the VLAN.
++	 */
++	if (vid && !bgmac_fa_vlan_in_use(fa, nh)) {
++		err = b53_fa_vlan(dp->ds, dp->index, vid, true);
++		if (err)
++			goto clear;
++	}
++
++	/* Ethernet, the VLAN tag or none, destination address */
++	fa_put_bits(d, FA_NH_TAG_OP, 2, vid ? FA_NH_TAG_CTAG : FA_NH_TAG_NONE);
++	fa_put_bits(d, FA_NH_VLAN_TCI, 16, vid);
+ 	fa_put_mac(d, FA_NH_DA, mac);
+ 	err = bgmac_fa_tbl_write(bgmac, FA_TBL_NEXT_HOP, free, d,
+ 				 FA_NEXT_HOP_WORDS);
+ 	if (err)
+-		return err;
++		goto vlan;
+ 
+-	nh = &fa->next_hop[free];
+ 	ether_addr_copy(nh->mac, mac);
+-	nh->dp = dp;
+ 	nh->refs = 1;
+ 	nh->fdb = false;
+ 
+@@ -484,7 +517,7 @@ static int bgmac_fa_next_hop_get(struct
+ 	if (!dsa_port_bridge_dev_get(dp) && dp->ds->ops->port_fdb_add) {
+ 		struct dsa_db db = { .type = DSA_DB_PORT, .dp = dp };
+ 
+-		err = dp->ds->ops->port_fdb_add(dp->ds, dp->index, mac, 0, db);
++		err = dp->ds->ops->port_fdb_add(dp->ds, dp->index, mac, vid, db);
+ 		if (err)
+ 			netdev_warn(bgmac->net_dev,
+ 				    "flow accelerator: no switch FDB entry for %pM on port %d: %d\n",
+@@ -494,25 +527,37 @@ static int bgmac_fa_next_hop_get(struct
+ 	}
+ 
+ 	return free;
++
++vlan:
++	if (vid && !bgmac_fa_vlan_in_use(fa, nh))
++		b53_fa_vlan(dp->ds, dp->index, vid, false);
++clear:
++	nh->dp = NULL;
++	nh->vid = 0;
++	return err;
+ }
+ 
+ static void bgmac_fa_next_hop_put(struct bgmac *bgmac, int i)
+ {
+ 	struct bgmac_fa_next_hop *nh = &bgmac->fa->next_hop[i];
+ 	u32 d[FA_NEXT_HOP_WORDS] = {};
++	struct dsa_port *dp = nh->dp;
+ 
+ 	if (--nh->refs)
+ 		return;
+ 
+ 	bgmac_fa_tbl_write(bgmac, FA_TBL_NEXT_HOP, i, d, FA_NEXT_HOP_WORDS);
+ 	if (nh->fdb) {
+-		struct dsa_port *dp = nh->dp;
+ 		struct dsa_db db = { .type = DSA_DB_PORT, .dp = dp };
+ 
+-		dp->ds->ops->port_fdb_del(dp->ds, dp->index, nh->mac, 0, db);
++		dp->ds->ops->port_fdb_del(dp->ds, dp->index, nh->mac, nh->vid,
++					  db);
+ 		nh->fdb = false;
+ 	}
++	if (nh->vid && !bgmac_fa_vlan_in_use(bgmac->fa, nh))
++		b53_fa_vlan(dp->ds, dp->index, nh->vid, false);
+ 	nh->dp = NULL;
++	nh->vid = 0;
+ }
+ 
+ static int bgmac_fa_pool_get(struct bgmac *bgmac, const u8 *mac, bool external)
+@@ -567,6 +612,7 @@ struct bgmac_fa_rule {
+ 	__be32 nat_ip;
+ 	__be16 nat_port;
+ 	bool snat, dnat;		/* neither: routing only */
++	u16 push_vid;			/* VLAN tag to add */
+ 	struct dsa_port *in, *out;
+ };
+ 
+@@ -611,6 +657,7 @@ static int bgmac_fa_parse(struct bgmac *
+ 	struct flow_rule *rule = flow_cls_offload_flow_rule(f);
+ 	struct flow_action_entry *act;
+ 	bool snat_port = false, dnat_port = false;
++	bool vlan = false, pop = false;
+ 	struct net_device *out = NULL;
+ 	int i;
+ 
+@@ -620,10 +667,21 @@ static int bgmac_fa_parse(struct bgmac *
+ 	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CONTROL) ||
+ 	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_BASIC) ||
+ 	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS) ||
+-	    flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_VLAN) ||
+ 	    flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CVLAN))
+ 		return -EOPNOTSUPP;
+ 
++	/* From an 802.1Q upper of the ingress port. The FA finds the flow
++	 * in a tagged frame too; it does not look at the tag.
++	 */
++	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_VLAN)) {
++		struct flow_match_vlan m;
++
++		flow_rule_match_vlan(rule, &m);
++		if (m.key->vlan_tpid != htons(ETH_P_8021Q) || !m.key->vlan_id)
++			return -EOPNOTSUPP;
++		vlan = true;
++	}
++
+ 	{
+ 		struct flow_match_meta m;
+ 		struct net_device *in;
+@@ -719,11 +777,29 @@ static int bgmac_fa_parse(struct bgmac *
+ 		case FLOW_ACTION_CSUM:
+ 		case FLOW_ACTION_PRIORITY:
+ 			break;
+-		default:	/* VLAN, PPPoE: not supported */
++		case FLOW_ACTION_VLAN_PUSH:
++			if (r->push_vid || !act->vlan.vid ||
++			    act->vlan.vid >= VLAN_N_VID ||
++			    act->vlan.proto != htons(ETH_P_8021Q))
++				return -EOPNOTSUPP;
++			r->push_vid = act->vlan.vid;
++			break;
++		case FLOW_ACTION_VLAN_POP:
++			if (pop)
++				return -EOPNOTSUPP;
++			pop = true;
++			break;
++		default:	/* a second tag, PPPoE: not supported */
+ 			return -EOPNOTSUPP;
+ 		}
+ 	}
+ 
++	/* The next hop removes a tag or adds one, not both: a tag that the
++	 * flow comes with must go, and no other may come.
++	 */
++	if (vlan != pop || (pop && r->push_vid))
++		return -EOPNOTSUPP;
++
+ 	/* IPv6 is routed only (its NAT mangles were refused above), and
+ 	 * needs the switch to trap hop limit 1 in front of the FA
+ 	 */
+@@ -910,7 +986,8 @@ static int bgmac_fa_flow_add(struct bgma
+ 	flow->idx = base + i;
+ 	flow->lastused = jiffies;
+ 
+-	flow->next_hop = bgmac_fa_next_hop_get(bgmac, r.eth, r.out);
++	flow->next_hop = bgmac_fa_next_hop_get(bgmac, r.eth, r.out,
++					       r.push_vid);
+ 	if (flow->next_hop < 0) {
+ 		err = flow->next_hop;
+ 		goto free;
diff --git a/target/linux/bcm53xx/patches-6.18/750-net-bgmac-offload-IPv4-TCP-only-while-the-FIN-RST-trap-is-active.patch b/target/linux/bcm53xx/patches-6.18/750-net-bgmac-offload-IPv4-TCP-only-while-the-FIN-RST-trap-is-active.patch
new file mode 100644
index 0000000000..d6996e8f6c
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/750-net-bgmac-offload-IPv4-TCP-only-while-the-FIN-RST-trap-is-active.patch
@@ -0,0 +1,108 @@
+From 2109e2353140727d858007a61a902b6ac5b36d83 Mon Sep 17 00:00:00 2001
+From: Semih Baskan <strst.gs@gmail.com>
+Date: Sat, 21 Nov 2026 14:57:46 +0000
+Subject: [PATCH] net: bgmac: offload IPv4 TCP only while the FIN/RST trap is
+ active
+
+The flow accelerator also forwards the FIN and RST of a TCP connection
+it holds, so conntrack sees the connection end only through the switch
+rule that redirects them to the second CPU port. Without that port, or
+with its conduit down, the rule is off (b53_fa_trap_active()), and
+closed connections stay ESTABLISHED in conntrack. IPv6 already requires
+the trap. Require it for IPv4 TCP as well when a flow is parsed. For
+flows already in the accelerator, bgmac_fa_flow_allowed() checks again
+from the stats poll and when the flowtable asks to offload a flow that
+is already offloaded, which it does every second while the other
+direction runs in software. A flow that fails the check leaves the
+accelerator and carries on in software, though conntrack still marks it
+[HW_OFFLOAD]. IPv4 UDP is still offloaded without the trap, so a TTL 1
+packet inside an offloaded UDP flow still gets no ICMP time exceeded.
+
+Measured on an RT-N18U with the trap port's conduit down: of 33 TCP
+connections, 8 were still ESTABLISHED in conntrack 15 s after the last
+one closed, against none with the conduit up, and a TTL 1 segment inside
+an offloaded TCP flow got no ICMP time exceeded back.
+
+With this change and the conduit down, IPv4 TCP runs in software at
+597 Mbit/s and leaves no ESTABLISHED entries, while IPv4 UDP is still
+offloaded at 949 Mbit/s. A TCP flow offloaded before its trap went away
+carries on in software within seconds.
+
+On an upload whose data ran in software while its acknowledgements ran
+in the accelerator, the acknowledgements came through the CPU as well
+about a second after the conduit went down, and the upload went on at
+about 550 Mbit/s.
+
+Signed-off-by: Semih Baskan <strst.gs@gmail.com>
+---
+ drivers/net/ethernet/broadcom/bgmac-fa.c | 33 +++++++++++++++++++-----
+ 1 file changed, 26 insertions(+), 7 deletions(-)
+
+--- a/drivers/net/ethernet/broadcom/bgmac-fa.c
++++ b/drivers/net/ethernet/broadcom/bgmac-fa.c
+@@ -801,9 +801,11 @@ static int bgmac_fa_parse(struct bgmac *
+ 		return -EOPNOTSUPP;
+ 
+ 	/* IPv6 is routed only (its NAT mangles were refused above), and
+-	 * needs the switch to trap hop limit 1 in front of the FA
++	 * needs the switch to trap hop limit 1 in front of the FA; TCP
++	 * needs it to trap FIN and RST
+ 	 */
+-	if (r->t.v6 && !b53_fa_trap_active(r->in->ds, r->in->index))
++	if ((r->t.v6 || r->t.proto == IPPROTO_TCP) &&
++	    !b53_fa_trap_active(r->in->ds, r->in->index))
+ 		return -EOPNOTSUPP;
+ 
+ 	/* The entry with the addresses of an IPv6 flow has the source
+@@ -951,6 +953,19 @@ static bool bgmac_fa_reply_fits(struct b
+ 	return bgmac_fa_room(fa, rbase, rt.v6) >= (rbase == base ? 2 : 1);
+ }
+ 
++static void bgmac_fa_flow_remove(struct bgmac *bgmac,
++				 struct bgmac_fa_flow *flow);
++
++static bool bgmac_fa_flow_allowed(struct bgmac *bgmac,
++				  struct bgmac_fa_flow *flow)
++{
++	if ((flow->t.v6 || flow->t.proto == IPPROTO_TCP) &&
++	    !b53_fa_trap_active(flow->in->ds, flow->in->index))
++		return false;
++
++	return true;
++}
++
+ static int bgmac_fa_flow_add(struct bgmac *bgmac, struct flow_cls_offload *f,
+ 			     struct bgmac_fa_block *block)
+ {
+@@ -963,8 +978,13 @@ static int bgmac_fa_flow_add(struct bgma
+ 
+ 	if (!fa->active)
+ 		return -EOPNOTSUPP;
+-	if (bgmac_fa_flow_find(fa, f->cookie))
+-		return -EEXIST;
++	flow = bgmac_fa_flow_find(fa, f->cookie);
++	if (flow) {
++		if (bgmac_fa_flow_allowed(bgmac, flow))
++			return -EEXIST;
++		bgmac_fa_flow_remove(bgmac, flow);
++		return -EOPNOTSUPP;
++	}
+ 
+ 	err = bgmac_fa_parse(bgmac, f, &r);
+ 	if (err)
+@@ -1105,13 +1125,12 @@ static int bgmac_fa_flow_stats(struct bg
+ 	if (!flow)
+ 		return -ENOENT;
+ 
+-	/* The hop limit trap goes when its conduit goes down, without a
++	/* The traps go when their conduit goes down, without a
+ 	 * word to this driver. The flowtable asks for the counters of a
+ 	 * flow every few seconds: take the flow out here, it goes on in
+ 	 * software.
+ 	 */
+-	if (flow->t.v6 &&
+-	    !b53_fa_trap_active(flow->in->ds, flow->in->index)) {
++	if (!bgmac_fa_flow_allowed(bgmac, flow)) {
+ 		bgmac_fa_flow_remove(bgmac, flow);
+ 		return -ENOENT;
+ 	}
diff --git a/target/linux/bcm53xx/patches-6.18/751-net-bgmac-tag-flow-accelerator-output-for-VLAN-filtering-bridge-ports.patch b/target/linux/bcm53xx/patches-6.18/751-net-bgmac-tag-flow-accelerator-output-for-VLAN-filtering-bridge-ports.patch
new file mode 100644
index 0000000000..2f659290bc
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/751-net-bgmac-tag-flow-accelerator-output-for-VLAN-filtering-bridge-ports.patch
@@ -0,0 +1,253 @@
+From 1524d5c6316369b57ccafdff8915ec0b10e49da2 Mon Sep 17 00:00:00 2001
+From: Semih Baskan <strst.gs@gmail.com>
+Date: Sat, 21 Nov 2026 14:57:46 +0000
+Subject: [PATCH] net: bgmac: tag flow accelerator output for VLAN-filtering
+ bridge ports
+
+With VLAN filtering on for br-lan, TCP connections whose traffic to a
+bridged port went through the flow accelerator failed on an RT-N18U. In
+six runs in a row, downloads and uploads alike, none completed, while
+with filtering off both directions ran at 949 Mbit/s. The likely cause
+is the VLAN the switch gives the accelerator's output: it enters on
+port 8 untagged and gets port 8's default VID 0, while filtering moves
+br-lan's ports to VID 1. Port 8's RxDiscarded counter rose by 16 in
+each of two failed downloads but did not move in a failed upload.
+
+With filtering on, give the next hop of a flow towards a bridged port
+the VLAN that port sends untagged, as b53_fa_pvid() reports it, so that
+the accelerator's output enters port 8 tagged with it. b53_fa_pvid()
+reports a VLAN only when port 8 is a member of it too. DSA makes port 8
+a member of the VLANs the bridge itself is in, so a VLAN that is only
+switched between ports gets no flows.
+
+b53 keeps the CPU port a tagged member of its VLANs, so the frames of a
+filtering bridge port reach the accelerator tagged. A next hop either
+sends a frame untagged, removing the tag it came with, or adds one tag,
+so a flow that needs a tag stays in software while its ingress port has
+a VLAN, as a flow routed between two VLANs does. Without a tag of its
+own, a flow also stays in software when its egress port has no untagged
+VLAN. When the route adds its own tag towards a bridged port, as for a
+tagged VLAN on a trunk port, the flow is offloaded only while the port
+filters VLANs and both it and port 8 are members of that VLAN, which
+b53_fa_vlan_ok() reports. bgmac_fa_flow_allowed() makes the same checks
+for flows already in the accelerator and takes a flow out when its VLAN
+no longer fits, for example after filtering is turned off or the port
+leaves the VLAN.
+
+With this change and filtering on, the same six runs all completed in
+the accelerator at 949 Mbit/s, and port 8's RxDiscarded counter did not
+move during a download. Turning filtering on or off under an offloaded
+download slowed or stopped it for up to about 5 s before it ran in the
+accelerator again. With the software flowtable, the same change only
+slowed a download for a second or two. A download whose LAN port left
+VID 1 for a few seconds was back in the accelerator about a second after
+the port rejoined.
+
+A trunk port in a tagged VLAN, routed through an upper of br-lan,
+carried a download and an upload in the accelerator at 939 Mbit/s. When
+the port left the VLAN under a download, the flow left the accelerator
+within 3 s and the port got no more of it. A UDP download was back in
+the accelerator within a second of the port rejoining. On the same
+bridge without filtering, the download stayed in software at about 540
+Mbit/s. Without this change such a flow is offloaded, and b53_fa_vlan()
+then writes that VLAN into the switch with only the egress port and port
+8 as members, while other ports of the bridge can carry it as well. A
+standalone port is not in a bridge, so flows over an upper of a
+standalone port are still offloaded with filtering off. With filtering
+on, DSA makes such a port and port 8 members of the upper's VLAN, and
+the same membership check applies to them; b53_fa_vlan_ok() covers both
+cases. b53 keeps both in the VLAN for the accelerator while a next hop
+uses it, so without the check a flow stays in the accelerator after its
+upper is gone: on an RT-N18U with filtering on, the accelerator went on
+sending a download to the host behind a deleted upper until the download
+ended. With the check, the flow left the accelerator within 3 s.
+
+Two limits remain. A port that is an untagged member of two VLANs gets
+the tag of its PVID for both, so a flow routed to it through the other
+VLAN's interface leaves the accelerator in the PVID's VLAN. And when a
+port's PVID is changed by hand under a running flow, a flow towards it
+is taken out and, if port 8 is in the new VLAN, offloaded again with
+the new PVID: the flow rule of an untagged bridge VLAN carries no VLAN
+that would hold it to the old one.
+
+Signed-off-by: Semih Baskan <strst.gs@gmail.com>
+---
+ drivers/net/dsa/b53/b53_common.c         | 41 ++++++++++++++++++++++++
+ drivers/net/ethernet/broadcom/bgmac-fa.c | 41 +++++++++++++++++++++++-
+ include/linux/dsa/b53.h                  | 12 +++++++
+ 3 files changed, 93 insertions(+), 1 deletion(-)
+
+--- a/drivers/net/dsa/b53/b53_common.c
++++ b/drivers/net/dsa/b53/b53_common.c
+@@ -3280,6 +3280,47 @@ int b53_fa_vlan(struct dsa_switch *ds, i
+ }
+ EXPORT_SYMBOL(b53_fa_vlan);
+ 
++int b53_fa_pvid(struct dsa_switch *ds, int port)
++{
++	struct b53_device *dev = ds->priv;
++	struct b53_vlan *vl;
++	u16 members, pvid;
++
++	if (ds->ops != &b53_switch_ops)
++		return -EOPNOTSUPP;
++	if (!READ_ONCE(dev->vlan_filtering))
++		return 0;
++
++	pvid = READ_ONCE(dev->ports[port].pvid);
++	if (!pvid)
++		return READ_ONCE(dsa_to_port(ds, port)->bridge) ? -ENOENT : 0;
++
++	vl = &dev->vlans[pvid];
++	members = READ_ONCE(vl->members);
++	if (!(members & BIT(B53_CPU_PORT)) ||
++	    !(members & READ_ONCE(vl->untag) & BIT(port)))
++		return -ENOENT;
++
++	return pvid;
++}
++EXPORT_SYMBOL(b53_fa_pvid);
++
++bool b53_fa_vlan_ok(struct dsa_switch *ds, int port, u16 vid)
++{
++	struct b53_device *dev = ds->priv;
++	u16 mask = BIT(port) | BIT(B53_CPU_PORT);
++
++	if (ds->ops != &b53_switch_ops)
++		return false;
++	if (!READ_ONCE(dev->vlan_filtering))
++		return !READ_ONCE(dsa_to_port(ds, port)->bridge);
++	if (!vid || vid >= dev->num_vlans)
++		return false;
++
++	return (READ_ONCE(dev->vlans[vid].members) & mask) == mask;
++}
++EXPORT_SYMBOL(b53_fa_vlan_ok);
++
