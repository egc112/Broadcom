+ #endif /* _LINUX_DSA_B53_H */
diff --git a/target/linux/bcm53xx/patches-6.18/753-net-bgmac-take-FA-flows-out-when-hw-tc-offload-or-the-conduit-changes.patch b/target/linux/bcm53xx/patches-6.18/753-net-bgmac-take-FA-flows-out-when-hw-tc-offload-or-the-conduit-changes.patch
new file mode 100644
index 0000000000..49c250b310
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/753-net-bgmac-take-FA-flows-out-when-hw-tc-offload-or-the-conduit-changes.patch
@@ -0,0 +1,116 @@
+From 76e1e2ad56bd42856e1d33817cbd27f992464a1b Mon Sep 17 00:00:00 2001
+From: Semih Baskan <strst.gs@gmail.com>
+Date: Sat, 21 Nov 2026 14:57:47 +0000
+Subject: [PATCH] net: bgmac: take FA flows out when hw-tc-offload or the
+ conduit changes
+
+Turning hw-tc-offload off on the conduit, or moving a user port to
+another conduit, leaves the flows already in the accelerator there;
+only new flows are refused. Take a flow out in
+bgmac_fa_flow_allowed() as well when hw-tc-offload is off on the
+conduit, and when its ingress port or the port of its next hop is no
+longer served by this conduit. Both are refused for a new flow,
+hw-tc-offload by a tc_can_offload() test before the flow is parsed and
+the conduit by bgmac_fa_user_port(), so such a flow is not offloaded
+again while the condition lasts.
+
+bgmac_fa_block_cb() refuses every FLOW_CLS_REPLACE while hw-tc-offload
+is off, so the re-check of a flow already in the accelerator only runs
+at its stats poll. The flowtable sends no stats poll for a flow whose
+other direction runs in software, as that direction keeps it fresh; it
+asks to offload the flow again about once a second instead. Move the
+test into bgmac_fa_flow_add(), after that re-check, so that such a flow
+leaves as well.
+
+Measured on an RT-N18U. With hw-tc-offload turned off on the conduit
+under an offloaded download at 949 Mbit/s, the flow left the accelerator
+within 2 s and went on in software at about 465 Mbit/s. It was back in
+the accelerator within a second of hw-tc-offload going on again. Without
+this change it stayed in the accelerator at 949 Mbit/s throughout. On
+an upload whose data ran in software while its acknowledgements ran in
+the accelerator, the acknowledgements went to software within about a
+second of hw-tc-offload going off and were back in the accelerator
+within 2 s of it going on.
+
+When a port moved to the other conduit under a UDP stream towards it,
+the flow left the accelerator within 3 s and the stream went on through
+the other conduit at about 557 Mbit/s. It came back within a second of
+the port moving back. Without this change the accelerator went on
+sending the stream to the port at 900 Mbit/s while the port was on the
+other conduit. A TCP download through the port stalled at the move even
+with hw-tc-offload off, so the move was measured with UDP.
+
+Signed-off-by: Semih Baskan <strst.gs@gmail.com>
+---
+ drivers/net/ethernet/broadcom/bgmac-fa.c | 32 ++++++++++++++++++------
+ 1 file changed, 24 insertions(+), 8 deletions(-)
+
+--- a/drivers/net/ethernet/broadcom/bgmac-fa.c
++++ b/drivers/net/ethernet/broadcom/bgmac-fa.c
+@@ -590,6 +590,17 @@ static struct dsa_port *bgmac_fa_user_po
+ 	return NULL;
+ }
+ 
++static bool bgmac_fa_conduit_of(struct bgmac *bgmac, const struct dsa_port *dp)
++{
++#if IS_ENABLED(CONFIG_NET_DSA)
++	const struct dsa_port *cpu_dp = READ_ONCE(bgmac->net_dev->dsa_ptr);
++
++	return cpu_dp && READ_ONCE(dp->cpu_dp) == cpu_dp;
++#else
++	return false;
++#endif
++}
++
+ static int bgmac_fa_pvid(const struct dsa_port *in, const struct dsa_port *out)
+ {
+ 	int vid = b53_fa_pvid(out->ds, out->index);
+@@ -950,6 +961,11 @@ static bool bgmac_fa_flow_allowed(struct
+ {
+ 	struct bgmac_fa_next_hop *nh = &bgmac->fa->next_hop[flow->next_hop];
+ 
++	if (!tc_can_offload(bgmac->net_dev) ||
++	    !bgmac_fa_conduit_of(bgmac, flow->in) ||
++	    !bgmac_fa_conduit_of(bgmac, nh->dp))
++		return false;
++
+ 	if ((flow->t.v6 || flow->t.proto == IPPROTO_TCP) &&
+ 	    !b53_fa_trap_active(flow->in->ds, flow->in->index))
+ 		return false;
+@@ -986,6 +1002,9 @@ static int bgmac_fa_flow_add(struct bgma
+ 		return -EOPNOTSUPP;
+ 	}
+ 
++	if (!tc_can_offload(bgmac->net_dev))
++		return -EOPNOTSUPP;
++
+ 	err = bgmac_fa_parse(bgmac, f, &r);
+ 	if (err)
+ 		return err;
+@@ -1132,10 +1151,10 @@ static int bgmac_fa_flow_stats(struct bg
+ 	if (!flow)
+ 		return -ENOENT;
+ 
+-	/* The traps go when their conduit goes down, without a
+-	 * word to this driver. The flowtable asks for the counters of a
+-	 * flow every few seconds: take the flow out here, it goes on in
+-	 * software.
++	/* The traps go when their conduit goes down, and hw-tc-offload or a
++	 * port's VLANs, bridge or conduit can change, without a word to
++	 * this driver. The flowtable asks for the counters of a flow every
++	 * few seconds: take the flow out here, it goes on in software.
+ 	 */
+ 	if (!bgmac_fa_flow_allowed(bgmac, flow)) {
+ 		bgmac_fa_flow_remove(bgmac, flow);
+@@ -1185,10 +1204,7 @@ static int bgmac_fa_block_cb(enum tc_set
+ 	bgmac_fa_lock(bgmac);
+ 	switch (f->command) {
+ 	case FLOW_CLS_REPLACE:
+-		if (tc_can_offload(bgmac->net_dev))
+-			err = bgmac_fa_flow_add(bgmac, f, block);
+-		else
+-			err = -EOPNOTSUPP;
++		err = bgmac_fa_flow_add(bgmac, f, block);
+ 		break;
+ 	case FLOW_CLS_DESTROY:
+ 		err = bgmac_fa_flow_del(bgmac, f);
diff --git a/target/linux/bcm53xx/patches-6.18/754-net-bgmac-check-FA-flows-at-once-when-a-port-changes.patch b/target/linux/bcm53xx/patches-6.18/754-net-bgmac-check-FA-flows-at-once-when-a-port-changes.patch
new file mode 100644
index 0000000000..ed33c5dbfc
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/754-net-bgmac-check-FA-flows-at-once-when-a-port-changes.patch
@@ -0,0 +1,141 @@
+From 2a3cdba89c4a73426bf767542c35bd27016b204d Mon Sep 17 00:00:00 2001
+From: Semih Baskan <strst.gs@gmail.com>
+Date: Sat, 21 Nov 2026 14:57:47 +0000
+Subject: [PATCH] net: bgmac: check FA flows at once when a port changes
+
+bgmac_fa_flow_allowed() takes a flow out of the flow accelerator once
+the conditions it was offloaded under no longer hold: the traps, its
+port's map, VLANs and conduit, and hw-tc-offload on the conduit. It runs
+when the flowtable asks for the counters of a flow, which is every 3 to
+4 s while the flow runs. Until then a flow to a port that has just
+joined a bridge still goes out by the port map, and one to a port that
+has just left a bridge by the address table, on a port that does not
+learn.
+
+Register a netdevice notifier that queues a check of every flow when a
+user port of the conduit gains or loses an upper device (a bridge or an
+802.1Q upper) or moves to another conduit, when the conduit's features
+change, and when the conduit of the traps goes up or down. The work
+takes RTNL, so it sees the change only after DSA has applied it. The
+stats poll stays for changes that come without such an event, as of a
+bridge VLAN.
+
+Measured on an RT-N18U under an offloaded download. After its port
+joined a bridge, the accelerator held the flow for 1.65 to 2.41 s
+without this change and for 0.06 to 0.07 s with it. After its port left
+a bridge, the flowtable's own cleanup, which runs once a second, took
+the flow down within 0.35 to 0.76 s, and this change within 0.09 to
+0.11 s.
+
+Signed-off-by: Semih Baskan <strst.gs@gmail.com>
+---
+ drivers/net/ethernet/broadcom/bgmac-fa.c | 72 ++++++++++++++++++++++--
+ 1 file changed, 68 insertions(+), 4 deletions(-)
+
+--- a/drivers/net/ethernet/broadcom/bgmac-fa.c
++++ b/drivers/net/ethernet/broadcom/bgmac-fa.c
+@@ -217,6 +217,10 @@ struct bgmac_fa {
+ 	struct bgmac_fa_next_hop next_hop[FA_NEXT_HOPS];
+ 	struct bgmac_fa_pool pool[FA_POOLS];
+ 	struct list_head block_cb_list;
++
++	struct bgmac *bgmac;
++	struct notifier_block netdev_nb;
++	struct work_struct check;	/* all flows, now */
+ };
+ 
+ static u32 fa_read(struct bgmac *bgmac, u16 reg)
+@@ -1151,10 +1155,9 @@ static int bgmac_fa_flow_stats(struct bg
+ 	if (!flow)
+ 		return -ENOENT;
+ 
+-	/* The traps go when their conduit goes down, and hw-tc-offload or a
+-	 * port's VLANs, bridge or conduit can change, without a word to
+-	 * this driver. The flowtable asks for the counters of a flow every
+-	 * few seconds: take the flow out here, it goes on in software.
++	/* A port's VLANs can change without a word to this driver, and the
++	 * flowtable asks for the counters of a flow every few seconds: take
++	 * the flow out here, it goes on in software.
+ 	 */
+ 	if (!bgmac_fa_flow_allowed(bgmac, flow)) {
+ 		bgmac_fa_flow_remove(bgmac, flow);
+@@ -1298,6 +1301,59 @@ static int bgmac_fa_setup_tc(struct bgma
+ 	return bgmac_fa_setup_block(bgmac, type_data);
+ }
+ 
++/* under RTNL, so DSA has applied the change that queued it */
++static void bgmac_fa_check_work(struct work_struct *work)
++{
++	struct bgmac_fa *fa = container_of(work, struct bgmac_fa, check);
++	struct bgmac *bgmac = fa->bgmac;
++	struct bgmac_fa_flow *flow;
++	struct hlist_node *tmp;
++	int bkt;
++
++	rtnl_lock();
++	bgmac_fa_lock(bgmac);
++	hash_for_each_safe(fa->flows, bkt, tmp, flow, node)
++		if (!bgmac_fa_flow_allowed(bgmac, flow))
++			bgmac_fa_flow_remove(bgmac, flow);
++	bgmac_fa_unlock(bgmac);
++	rtnl_unlock();
++}
++
++static int bgmac_fa_netdev_event(struct notifier_block *nb,
++				 unsigned long event, void *ptr)
++{
++	struct bgmac_fa *fa = container_of(nb, struct bgmac_fa, netdev_nb);
++	struct net_device *dev = netdev_notifier_info_to_dev(ptr);
++	struct bgmac *bgmac = fa->bgmac;
++
++	switch (event) {
++	case NETDEV_CHANGEUPPER:
++		if (dev == bgmac->net_dev || bgmac_fa_user_port(bgmac, dev))
++			schedule_work(&fa->check);
++		break;
++	case NETDEV_FEAT_CHANGE:
++		if (dev == bgmac->net_dev)
++			schedule_work(&fa->check);
++		break;
++	case NETDEV_UP:
++	case NETDEV_DOWN:
++		/* the conduit of the traps */
++		if (dev != bgmac->net_dev && netdev_uses_dsa(dev))
++			schedule_work(&fa->check);
++		break;
++	}
++
++	return NOTIFY_DONE;
++}
++
++static void bgmac_fa_netdev_release(void *data)
++{
++	struct bgmac_fa *fa = data;
++
++	unregister_netdevice_notifier(&fa->netdev_nb);
++	cancel_work_sync(&fa->check);
++}
++
+ /* ---------- open / stop ---------- */
+ 
+ static bool bgmac_fa_wanted(struct bgmac *bgmac)
+@@ -1383,11 +1439,19 @@ void bgmac_fa_probe(struct bgmac *bgmac)
+ 	mutex_init(&fa->lock);
+ 	hash_init(fa->flows);
+ 	INIT_LIST_HEAD(&fa->block_cb_list);
++	fa->bgmac = bgmac;
++	INIT_WORK(&fa->check, bgmac_fa_check_work);
+ 
+ 	bgmac->fa = fa;
+ 	bgmac->fa_open = bgmac_fa_open;
+ 	bgmac->fa_stop = bgmac_fa_stop;
+ 	bgmac->fa_setup_tc = bgmac_fa_setup_tc;
++
++	fa->netdev_nb.notifier_call = bgmac_fa_netdev_event;
++	if (register_netdevice_notifier(&fa->netdev_nb) ||
++	    devm_add_action_or_reset(bgmac->dev, bgmac_fa_netdev_release, fa))
++		dev_warn(bgmac->dev,
++			 "flow accelerator: port changes are seen at the stats poll only\n");
+ }
+ EXPORT_SYMBOL_GPL(bgmac_fa_probe);
+ 
diff --git a/target/linux/bcm53xx/patches-6.18/755-net-dsa-b53-drop-the-flow-accelerator-s-VLAN-members.patch b/target/linux/bcm53xx/patches-6.18/755-net-dsa-b53-drop-the-flow-accelerator-s-VLAN-members.patch
new file mode 100644
index 0000000000..a11bf9ce86
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/755-net-dsa-b53-drop-the-flow-accelerator-s-VLAN-members.patch
@@ -0,0 +1,174 @@
+From 4d8592f404392c5a43ddbcb438941316a274d6dd Mon Sep 17 00:00:00 2001
+From: Semih Baskan <strst.gs@gmail.com>
+Date: Sat, 21 Nov 2026 14:57:47 +0000
+Subject: [PATCH] net: dsa: b53: drop the flow accelerator's VLAN members
+
+Nothing calls b53_fa_vlan() any more. The flow accelerator's driver
+names a standalone port in the flow entry, and with VLAN filtering on
+DSA has the VLAN of an 802.1Q upper in the switch's table with its port
+and port 8. Remove the helper and fa_members, which only it set, with
+the places that added fa_members to a VLAN entry and the loop in
+b53_configure_vlan() that wrote such entries with filtering off. The
+mutex around the VLAN table stays.
+
+Measured on an RT-N18U with the rest of this series. TCP ran in the
+accelerator at 947 to 949 Mbit/s with VLAN filtering off and on, IPv4
+over a VLAN on a bridge trunk and over an 802.1Q upper of a standalone
+port at 938 to 939 Mbit/s, and IPv6 the same two ways at 920 to 924
+Mbit/s, with no kernel warnings.
+
+Signed-off-by: Semih Baskan <strst.gs@gmail.com>
+---
+ drivers/net/dsa/b53/b53_common.c | 61 ++++----------------------------
+ drivers/net/dsa/b53/b53_priv.h   |  1 -
+ include/linux/dsa/b53.h          |  7 ----
+ 3 files changed, 7 insertions(+), 62 deletions(-)
+
+--- a/drivers/net/dsa/b53/b53_common.c
++++ b/drivers/net/dsa/b53/b53_common.c
+@@ -256,15 +256,12 @@ static int b53_do_vlan_op(struct b53_dev
+ static void __b53_set_vlan_entry(struct b53_device *dev, u16 vid,
+ 				 struct b53_vlan *vlan)
+ {
+-	/* the flow accelerator's members are in the table whatever else is */
+-	u16 members = vlan->members | dev->vlans[vid].fa_members;
+-
+ 	if (is5325(dev)) {
+ 		u32 entry = 0;
+ 
+-		if (members) {
++		if (vlan->members) {
+ 			entry = ((vlan->untag & VA_UNTAG_MASK_25) <<
+-				 VA_UNTAG_S_25) | members;
++				 VA_UNTAG_S_25) | vlan->members;
+ 			if (dev->core_rev >= 3)
+ 				entry |= VA_VALID_25_R4 | vid << VA_VID_HIGH_S;
+ 			else
+@@ -277,9 +274,9 @@ static void __b53_set_vlan_entry(struct
+ 	} else if (is5365(dev)) {
+ 		u16 entry = 0;
+ 
+-		if (members)
++		if (vlan->members)
+ 			entry = ((vlan->untag & VA_UNTAG_MASK_65) <<
+-				 VA_UNTAG_S_65) | members | VA_VALID_65;
++				 VA_UNTAG_S_65) | vlan->members | VA_VALID_65;
+ 
+ 		b53_write16(dev, B53_VLAN_PAGE, B53_VLAN_WRITE_65, entry);
+ 		b53_write16(dev, B53_VLAN_PAGE, B53_VLAN_TABLE_ACCESS_65, vid |
+@@ -287,13 +284,13 @@ static void __b53_set_vlan_entry(struct
+ 	} else {
+ 		b53_write16(dev, B53_ARLIO_PAGE, dev->vta_regs[1], vid);
+ 		b53_write32(dev, B53_ARLIO_PAGE, dev->vta_regs[2],
+-			    (vlan->untag << VTE_UNTAG_S) | members);
++			    (vlan->untag << VTE_UNTAG_S) | vlan->members);
+ 
+ 		b53_do_vlan_op(dev, VTA_CMD_WRITE);
+ 	}
+ 
+ 	dev_dbg(dev->ds->dev, "VID: %d, members: 0x%04x, untag: 0x%04x\n",
+-		vid, members, vlan->untag);
++		vid, vlan->members, vlan->untag);
+ }
+ 
+ static void b53_set_vlan_entry(struct b53_device *dev, u16 vid,
+@@ -1345,7 +1342,7 @@ int b53_configure_vlan(struct dsa_switch
+ 		for (vid = def_vid + 1; vid < dev->num_vlans; vid++) {
+ 			v = &dev->vlans[vid];
+ 
+-			if (!v->members && !v->fa_members)
++			if (!v->members)
+ 				continue;
+ 
+ 			b53_set_vlan_entry(dev, vid, v);
+@@ -1358,13 +1355,6 @@ int b53_configure_vlan(struct dsa_switch
+ 					    B53_VLAN_PORT_DEF_TAG(i),
+ 					    dev->ports[i].pvid);
+ 		}
+-	} else {
+-		struct b53_vlan none = {};
+-
+-		/* the flow accelerator's VLANs, see b53_fa_vlan() */
+-		for (vid = def_vid + 1; vid < dev->num_vlans; vid++)
+-			if (dev->vlans[vid].fa_members)
+-				b53_set_vlan_entry(dev, vid, &none);
+ 	}
+ 
+ 	return 0;
+@@ -3243,43 +3233,6 @@ bool b53_fa_trap_active(struct dsa_switc
+ }
+ EXPORT_SYMBOL(b53_fa_trap_active);
+ 
+-/* For the driver of the flow accelerator: the frames that it forwards
+- * come back into the switch on port 8, with the tag of an 802.1Q upper
+- * of their egress port pushed, and go through the VLAN lookup, unlike the
+- * host's own frames, which name their egress port. This driver writes
+- * the VLAN table only while VLAN filtering is on, and the upper of a
+- * standalone port is no member of a VLAN at all: the frames would be
+- * dropped. Keep @port and port 8 in the table as tagged members of @vid,
+- * until the driver takes them out again.
+- */
+-int b53_fa_vlan(struct dsa_switch *ds, int port, u16 vid, bool add)
+-{
+-	struct b53_device *dev = ds->priv;
+-	struct b53_vlan none = {};
+-	struct b53_vlan *vl;
+-
+-	if (ds->ops != &b53_switch_ops)
+-		return -EOPNOTSUPP;
+-	if (!vid || vid >= dev->num_vlans)
+-		return -EINVAL;
+-
+-	vl = &dev->vlans[vid];
+-
+-	mutex_lock(&dev->vlan_mutex);
+-	if (add) {
+-		vl->fa_members |= BIT(port) | BIT(B53_CPU_PORT);
+-	} else {
+-		vl->fa_members &= ~BIT(port);
+-		if (vl->fa_members == BIT(B53_CPU_PORT))
+-			vl->fa_members = 0;
+-	}
+-	__b53_set_vlan_entry(dev, vid, dev->vlan_filtering ? vl : &none);
+-	mutex_unlock(&dev->vlan_mutex);
+-
+-	return 0;
+-}
+-EXPORT_SYMBOL(b53_fa_vlan);
+-
+ int b53_fa_pvid(struct dsa_switch *ds, int port)
+ {
+ 	struct b53_device *dev = ds->priv;
+--- a/drivers/net/dsa/b53/b53_priv.h
++++ b/drivers/net/dsa/b53/b53_priv.h
+@@ -126,7 +126,6 @@ struct b53_port {
+ struct b53_vlan {
+ 	u16 members;
+ 	u16 untag;
+-	u16 fa_members;		/* tagged, for the flow accelerator */
+ 	bool valid;
+ };
+ 
+--- a/include/linux/dsa/b53.h
++++ b/include/linux/dsa/b53.h
+@@ -15,7 +15,6 @@ struct dsa_switch;
+ 
+ #if IS_REACHABLE(CONFIG_B53)
+ bool b53_fa_trap_active(struct dsa_switch *ds, int port);
+-int b53_fa_vlan(struct dsa_switch *ds, int port, u16 vid, bool add);
+ int b53_fa_pvid(struct dsa_switch *ds, int port);
+ bool b53_fa_vlan_ok(struct dsa_switch *ds, int port, u16 vid);
+ int b53_fa_port_map(struct dsa_switch *ds, int port);
+@@ -25,12 +24,6 @@ static inline bool b53_fa_trap_active(st
+ 	return false;
+ }
+ 
+-static inline int b53_fa_vlan(struct dsa_switch *ds, int port, u16 vid,
+-			      bool add)
+-{
+-	return -EOPNOTSUPP;
+-}
+-
+ static inline int b53_fa_pvid(struct dsa_switch *ds, int port)
+ {
+ 	return -EOPNOTSUPP;
diff --git a/target/linux/bcm53xx/patches-6.18/756-net-bgmac-offload-only-flowtables-in-the-conduit-s-netns.patch b/target/linux/bcm53xx/patches-6.18/756-net-bgmac-offload-only-flowtables-in-the-conduit-s-netns.patch
new file mode 100644
index 0000000000..84f51c7634
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/756-net-bgmac-offload-only-flowtables-in-the-conduit-s-netns.patch
@@ -0,0 +1,97 @@
+From a85255142de054d02293f9e03f7aa1bb73a4921f Mon Sep 17 00:00:00 2001
+From: Semih Baskan <strst.gs@gmail.com>
+Date: Sat, 21 Nov 2026 14:57:48 +0000
+Subject: [PATCH] net: bgmac: offload only flowtables in the conduit's netns
+
+bgmac_fa_parse() resolves the ingress ifindex of a flow in init_net,
+while the ifindex belongs to the netns of the flowtable. With the user
+ports in another netns the lookup usually finds no port and the flow
+stays in software, but an ifindex that init_net uses for another port
+of the switch gives the flow the wrong ingress port. Resolving it in
+the flowtable's netns would let that netns put flows into the flow
+accelerator, which all ports share and which matches a flow by its
+addresses and ports only, so those entries would also forward frames
+of the conduit's netns.
+
+Set up no flow block for a netns other than the conduit's, and look the
+ingress ifindex up in the conduit's netns. A further bind of a block set
+up earlier only takes a reference, so that its unbind stays balanced. A
+port outside the conduit's netns is refused for a new flow, and
+bgmac_fa_flow_allowed() takes a flow out when one of its ports moves to
+another netns. OpenWrt's netfilter patch 701 ignores -EOPNOTSUPP from a
+flowtable device's offload setup, so a flowtable in another netns runs
+in software there. Without that patch, nft fails to add such a flowtable
+with the offload flag.
+
+On an RT-N18U, a LAN port and wan were moved into another netns with an
+offload flowtable, and a UDP download ran through them. The flowtable
+was added without an error or a warning. When that netns already had
+devices at their ifindexes, as a container can have, the two ports got
+ifindexes that other ports of the switch have in init_net. Without this
+patch the download then ran through the accelerator at 900 Mbit/s; with
+it, in software at 600 Mbit/s. Without such a clash the download stayed
+in software either way. When a port moved into another netns under an
+offloaded download, the flowtable took the flow out of the accelerator
+at the move, before bgmac_fa_flow_allowed() saw it.
+
+Signed-off-by: Semih Baskan <strst.gs@gmail.com>
+---
+ drivers/net/ethernet/broadcom/bgmac-fa.c | 19 +++++++++++++++----
+ 1 file changed, 15 insertions(+), 4 deletions(-)
+
+--- a/drivers/net/ethernet/broadcom/bgmac-fa.c
++++ b/drivers/net/ethernet/broadcom/bgmac-fa.c
+@@ -586,6 +586,9 @@ static struct dsa_port *bgmac_fa_user_po
+ 	if (!dev || !netdev_uses_dsa(bgmac->net_dev))
+ 		return NULL;
+ 
++	if (!net_eq(dev_net(dev), dev_net(bgmac->net_dev)))
++		return NULL;
++
+ 	list_for_each_entry(dp, &cpu_dp->dst->ports, list)
+ 		if (dsa_port_is_user(dp) && dp->user == dev &&
+ 		    dp->cpu_dp == cpu_dp)
+@@ -677,7 +680,8 @@ static int bgmac_fa_parse(struct bgmac *
+ 
+ 		flow_rule_match_meta(rule, &m);
+ 		rcu_read_lock();
+-		in = dev_get_by_index_rcu(&init_net, m.key->ingress_ifindex);
++		in = dev_get_by_index_rcu(dev_net_rcu(bgmac->net_dev),
++					  m.key->ingress_ifindex);
+ 		r->in = bgmac_fa_user_port(bgmac, in);
+ 		rcu_read_unlock();
+ 		if (!r->in)
+@@ -970,6 +974,10 @@ static bool bgmac_fa_flow_allowed(struct
+ 	    !bgmac_fa_conduit_of(bgmac, nh->dp))
+ 		return false;
+ 
++	if (!net_eq(dev_net(flow->in->user), dev_net(bgmac->net_dev)) ||
++	    !net_eq(dev_net(nh->dp->user), dev_net(bgmac->net_dev)))
++		return false;
++
+ 	if ((flow->t.v6 || flow->t.proto == IPPROTO_TCP) &&
+ 	    !b53_fa_trap_active(flow->in->ds, flow->in->index))
+ 		return false;
+@@ -1155,9 +1163,9 @@ static int bgmac_fa_flow_stats(struct bg
+ 	if (!flow)
+ 		return -ENOENT;
+ 
+-	/* A port's VLANs can change without a word to this driver, and the
+-	 * flowtable asks for the counters of a flow every few seconds: take
+-	 * the flow out here, it goes on in software.
++	/* A port's VLANs or netns can change without a word to this driver,
++	 * and the flowtable asks for the counters of a flow every few seconds:
++	 * take the flow out here, it goes on in software.
+ 	 */
+ 	if (!bgmac_fa_flow_allowed(bgmac, flow)) {
+ 		bgmac_fa_flow_remove(bgmac, flow);
+@@ -1257,6 +1265,9 @@ static int bgmac_fa_setup_block(struct b
+ 			return 0;
+ 		}
+ 
++		if (!net_eq(f->net, dev_net(bgmac->net_dev)))
++			return -EOPNOTSUPP;
++
+ 		block = kzalloc(sizeof(*block), GFP_KERNEL);
+ 		if (!block)
+ 			return -ENOMEM;
diff --git a/target/linux/bcm53xx/patches-6.18/757-net-dsa-b53-clear-the-flow-accelerator-trap-ports-before-the-rules.patch b/target/linux/bcm53xx/patches-6.18/757-net-dsa-b53-clear-the-flow-accelerator-trap-ports-before-the-rules.patch
new file mode 100644
index 0000000000..154cc10d32
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/757-net-dsa-b53-clear-the-flow-accelerator-trap-ports-before-the-rules.patch
@@ -0,0 +1,52 @@
+From e3e33d0f2cf8d6a92df69c2b6522091a754f4164 Mon Sep 17 00:00:00 2001
+From: Semih Baskan <strst.gs@gmail.com>
+Date: Sat, 21 Nov 2026 14:57:48 +0000
+Subject: [PATCH] net: dsa: b53: clear the flow accelerator trap ports before
+ the rules
+
+b53_fa_trap_clear() turns the CFP rules off and clears them before it
+resets fa_trap_ports. During that time b53_fa_trap_active() still
+reports the traps as on, so a TCP or IPv6 flow can be offloaded after
+its rules are gone. It then runs without them until the next stats poll
+takes it out, as the flows offloaded before the clear do.
+
+Clear fa_trap_ports first, so that no new flow is admitted once the
+rules start to go, and write it with WRITE_ONCE(), as
+b53_fa_trap_active() reads it with READ_ONCE(). A flow whose check ran
+just before the clear can still be offloaded; the re-check in
+bgmac_fa_flow_allowed() takes it out with the others.
+
+With a test build on an RT-N18U, b53_fa_trap_clear() took 160 us in
+each of ten runs, which is how long the window was. In a test build that
+stretched the clear to 2 s, a TCP flow that started during it was
+offloaded and ran without the traps until the next stats poll. With this
+change it stayed in software.
+
+Signed-off-by: Semih Baskan <strst.gs@gmail.com>
+---
+ drivers/net/dsa/b53/b53_common.c | 4 ++--
+ 1 file changed, 2 insertions(+), 2 deletions(-)
+
+--- a/drivers/net/dsa/b53/b53_common.c
++++ b/drivers/net/dsa/b53/b53_common.c
+@@ -783,10 +783,10 @@ static void b53_fa_trap_clear(struct b53
+ 	static const u32 zero[B53_CFP_NUM_KEY_REGS];
+ 	int i;
+ 
++	WRITE_ONCE(dev->fa_trap_ports, 0);
+ 	b53_write8(dev, B53_CFP_PAGE, B53_CFP_CTRL, 0);
+ 	for (i = 0; i < B53_FA_TRAP_NUM; i++)
+ 		b53_cfp_write_tcam(dev, i, zero, zero);
+-	dev->fa_trap_ports = 0;
+ }
+ 
+ /* The flow accelerator in front of port 8 forwards the frames of the
+@@ -842,7 +842,7 @@ static void b53_fa_trap_update(struct b5
+ 
+ 	b53_write8(dev, B53_CFP_PAGE, B53_CFP_CTRL, src);
+ 	dev->fa_trap_port = trap;
+-	dev->fa_trap_ports = src;
++	WRITE_ONCE(dev->fa_trap_ports, src);
+ 	dev_info(ds->dev, "flow accelerator traps to port %d\n", trap);
+ }
+ 
diff --git a/target/linux/bcm53xx/patches-6.18/758-net-bgmac-stop-the-flow-accelerator-when-bgmac_open-fails.patch b/target/linux/bcm53xx/patches-6.18/758-net-bgmac-stop-the-flow-accelerator-when-bgmac_open-fails.patch
new file mode 100644
index 0000000000..077618a2ab
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/758-net-bgmac-stop-the-flow-accelerator-when-bgmac_open-fails.patch
@@ -0,0 +1,58 @@
+From 7abe0578e07736b0021a338afc867465bcae95bd Mon Sep 17 00:00:00 2001
+From: Semih Baskan <strst.gs@gmail.com>
+Date: Sat, 21 Nov 2026 14:57:48 +0000
+Subject: [PATCH] net: bgmac: stop the flow accelerator when bgmac_open() fails
+
+bgmac_open() opens the flow accelerator first. When the DMA setup or
+the IRQ request fails after that, it returns with the accelerator still
+marked active, and bgmac_stop() is not called for a device that did not
+open. Call fa_stop on those error paths, as bgmac_stop() does.
+
+No effect of the old behaviour was found. The conduit's user ports
+close before it stops, and the flowtable finishes their offload work
+when they do, so no flow reaches the driver until the conduit opens
+again. With this patch a failed open leaves the accelerator stopped, as
+bgmac_stop() does and as bgmac_fa_open() expects.
+
+On an RT-N18U, a test build that fails the DMA setup or the IRQ
+request on demand logged fa_stop after each failed open of the
+conduit, and the next open found the accelerator inactive. Without
+this patch the next open found it still active. Either way, the
+accelerator offloaded as before once the conduit opened again.
+
+Signed-off-by: Semih Baskan <strst.gs@gmail.com>
+---
+ drivers/net/ethernet/broadcom/bgmac.c | 9 +++++++--
+ 1 file changed, 7 insertions(+), 2 deletions(-)
+
+--- a/drivers/net/ethernet/broadcom/bgmac.c
++++ b/drivers/net/ethernet/broadcom/bgmac.c
+@@ -1187,14 +1187,14 @@ static int bgmac_open(struct net_device
+ 
+ 	err = bgmac_dma_init(bgmac);
+ 	if (err)
+-		return err;
++		goto err_fa_stop;
+ 
+ 	err = request_irq(bgmac->irq, bgmac_interrupt, IRQF_SHARED,
+ 			  net_dev->name, net_dev);
+ 	if (err < 0) {
+ 		dev_err(bgmac->dev, "IRQ request error: %d!\n", err);
+ 		bgmac_dma_cleanup(bgmac);
+-		return err;
++		goto err_fa_stop;
+ 	}
+ 	napi_enable(&bgmac->napi);
+ 
+@@ -1206,6 +1206,11 @@ static int bgmac_open(struct net_device
+ 	netif_start_queue(net_dev);
+ 
+ 	return 0;
++
++err_fa_stop:
++	if (bgmac->fa_stop)
++		bgmac->fa_stop(bgmac);
++	return err;
+ }
+ 
+ static int bgmac_stop(struct net_device *net_dev)
diff --git a/target/linux/bcm53xx/patches-6.18/759-net-dsa-b53-rewrite-the-flow-accelerator-traps-in-place.patch b/target/linux/bcm53xx/patches-6.18/759-net-dsa-b53-rewrite-the-flow-accelerator-traps-in-place.patch
new file mode 100644
index 0000000000..36ac62f195
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/759-net-dsa-b53-rewrite-the-flow-accelerator-traps-in-place.patch
@@ -0,0 +1,57 @@
+From a914cf1aa3fa879b146402319054dcb3ef32dd5a Mon Sep 17 00:00:00 2001
+From: Semih Baskan <strst.gs@gmail.com>
+Date: Sat, 21 Nov 2026 14:57:49 +0000
+Subject: [PATCH] net: dsa: b53: rewrite the flow accelerator traps in place
+
+b53_fa_trap_update() clears all trap rules and CFP_CTRL before it
+writes the rules for the new set of ports. When a port moves to another
+conduit, or the traps move to another CPU port, the ports that keep the
+traps are without them until the rules are written again. The
+accelerator forwards the FIN, RST and hop limit 1 frames of their flows
+meanwhile, and a stats poll in that time takes their TCP and IPv6 flows
+out until they are offloaded again.
+
+Clear the rules only when the traps go off. Otherwise take the ports
+that leave out of fa_trap_ports first, write the rules over the old
+ones, and then set CFP_CTRL and fa_trap_ports for the new ports. Each
+rule is written as a whole, so a port that keeps the traps matches every
+rule at any time.
+
+Tested on an RT-N18U: moving a port to the other conduit and back under
+a UDP stream logged "flow accelerator traps to port 5" both times and no
+error, and the stream went through the other conduit and back into the
+accelerator as before. Throughput and the tests that take the trap
+port's conduit down and up gave the same results as without this
+change. With a test build, the clear took 160 us and writing the new
+rules with CFP_CTRL took 196 to 268 us in twenty conduit moves (once
+1 ms when the trap port's conduit came up), so before this change the
+ports that keep the traps were without them for about 0.36 ms on each
+move.
+
+In a test build that stretched the window to about 4 s, TTL 1 packets
+of an offloaded flow on a port that kept the traps were neither trapped
+nor answered while another port moved to a new conduit. With this change
+they were trapped throughout the move.
+
+Signed-off-by: Semih Baskan <strst.gs@gmail.com>
+---
+ drivers/net/dsa/b53/b53_common.c | 3 ++-
+ 1 file changed, 2 insertions(+), 1 deletion(-)
+
+--- a/drivers/net/dsa/b53/b53_common.c
++++ b/drivers/net/dsa/b53/b53_common.c
+@@ -827,12 +827,13 @@ static void b53_fa_trap_update(struct b5
+ 	if (src == dev->fa_trap_ports && (!src || trap == dev->fa_trap_port))
+ 		return;
+ 
+-	b53_fa_trap_clear(dev);
+ 	if (!src) {
++		b53_fa_trap_clear(dev);
+ 		dev_info(ds->dev, "flow accelerator traps off\n");
+ 		return;
+ 	}
+ 
++	WRITE_ONCE(dev->fa_trap_ports, dev->fa_trap_ports & src);
+ 	err = b53_fa_trap_set(dev, src, b53_cfp_port_bit(trap));
+ 	if (err) {
+ 		dev_err(ds->dev, "flow accelerator traps: %pe\n", ERR_PTR(err));
diff --git a/target/linux/bcm53xx/base-files/lib/preinit/99_20_flow_accel b/target/linux/bcm53xx/base-files/lib/preinit/99_20_flow_accel
new file mode 100644
index 0000000000..006c93e5b3
--- /dev/null
+++ b/target/linux/bcm53xx/base-files/lib/preinit/99_20_flow_accel
@@ -0,0 +1,102 @@
+# The flow accelerator in front of switch port 8 works only with the
+# prepended Broadcom tag, and the tag can change only while no port of
+# the switch is up. The switch boots with the regular tag; switch it
+# here, before the network starts, when hardware flow offloading is on.
+
+flow_accel_log() {
+	echo "flow accelerator tag: $*" > /dev/kmsg
+}
+
+# The values firewall4 takes as true
+flow_accel_option() {
+	case "$(uci -q get "firewall.@defaults[0].$1")" in
+	1|on|true|yes) return 0 ;;
+	esac
+	return 1
+}
+
+# Take the conduits down and the switch to tagger $1; $err says why not
+flow_accel_retag() {
+	for c in $conduits; do
+		ip link set dev "$c" down
+	done
+	for c in $conduits; do
+		t=/sys/class/net/$c/dsa/tagging
+		[ "$(cat "$t")" = "$1" ] && continue
+		err=$({ echo "$1" > "$t"; } 2>&1) || return 1
+	done
+}
+
+flow_accel_restore() {
+	for c in $conduits; do
+		case " $up " in
+		*" $c "*) ip link set dev "$c" up ;;
+		*) ip link set dev "$c" down ;;
+		esac
+	done
+}
+
+flow_accel_tag() (
+	flow_accel_option flow_offloading || exit 0
+	flow_accel_option flow_offloading_hw || exit 0
+
+	conduits=
+	up=
+	n=0
+	for t in /sys/class/net/*/dsa/tagging; do
+		[ -e "$t" ] || continue
+		c=${t%/dsa/tagging}
+		c=${c##*/}
+		case "$(cat "$t")" in
+		brcm-prepend)
+			flow_accel_log "$c uses brcm-prepend already"
+			exit 0
+			;;
+		brcm)
+			conduits="$conduits $c"
+			n=$((n + 1))
+			[ $(($(cat "/sys/class/net/$c/flags") & 1)) = 1 ] &&
+				up="$up $c"
+			;;
+		esac
+	done
+
+	case $n in
+	0)
+		flow_accel_log "no switch with the brcm tag"
+		exit 0
+		;;
+	1)
+		flow_accel_log "${conduits# } is the only CPU port," \
+			"the traps need a second one; keeping brcm"
+		exit 0
+		;;
+	esac
+
+	if ! flow_accel_retag brcm-prepend; then
+		flow_accel_log "the switch refused brcm-prepend" \
+			"(${err##*: }); keeping brcm"
+		flow_accel_retag brcm
+		flow_accel_restore
+		exit 0
+	fi
+
+	# Opening the conduit on port 8 starts the accelerator, and fails
+	# if it does not start
+	for c in $conduits; do
+		err=$(ip link set dev "$c" up 2>&1) && continue
+		flow_accel_log "$c did not open with brcm-prepend" \
+			"(${err##*: }); back to brcm"
+		flow_accel_retag brcm ||
+			flow_accel_log "brcm refused too (${err##*: }); turn" \
+				"hardware flow offloading off in failsafe mode"
+		flow_accel_restore
+		exit 0
+	done
+
+	flow_accel_restore
+	flow_accel_log "switched$conduits to brcm-prepend" \
+		"for hardware flow offloading"
+)
+
+boot_hook_add preinit_main flow_accel_tag
diff --git a/target/linux/bcm53xx/patches-6.18/384-ARM-dts-BCM5301X-RT-N18U-drop-the-flow-accelerator-tag.patch b/target/linux/bcm53xx/patches-6.18/384-ARM-dts-BCM5301X-RT-N18U-drop-the-flow-accelerator-tag.patch
new file mode 100644
index 0000000000..169f9aab49
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/384-ARM-dts-BCM5301X-RT-N18U-drop-the-flow-accelerator-tag.patch
@@ -0,0 +1,46 @@
+From 24126ff929100213e77049a91f7d96bc0640db82 Mon Sep 17 00:00:00 2001
+From: Semih Baskan <strst.gs@gmail.com>
+Date: Mon, 23 Nov 2026 12:41:46 +0000
+Subject: [PATCH] ARM: dts: BCM5301X: RT-N18U: drop the flow accelerator tag
+
+Patch 379 names the prepended Broadcom tag on ports 5 and 8, so the
+flow accelerator is in the path on every boot, whether hardware flow
+offloading is on or not. Drop those lines and the port 8 node that
+only carried one of them. The switch then boots with the regular tag,
+and the bcm53xx preinit hook moves it to the prepended tag when the
+firewall's flow offloading and hardware flow offloading are both on.
+
+Port 5 stays a CPU port with its fixed link, for the switch's trap
+rules. User ports keep port 8 as their CPU port.
+
+Measured on an RT-N18U: with hardware flow offloading off the switch
+kept the regular tag and the accelerator stayed out of the path; with
+both options on the hook moved it to the prepended tag at boot and a
+TCP stream ran through the accelerator at 949 Mbit/s.
+
+Signed-off-by: Semih Baskan <strst.gs@gmail.com>
+---
+ arch/arm/boot/dts/broadcom/bcm47081-asus-rt-n18u.dts | 6 ------
+ 1 file changed, 6 deletions(-)
+
+--- a/arch/arm/boot/dts/broadcom/bcm47081-asus-rt-n18u.dts
++++ b/arch/arm/boot/dts/broadcom/bcm47081-asus-rt-n18u.dts
+@@ -137,8 +137,6 @@
+ 		};
+ 
+ 		port@5 {
+-			dsa-tag-protocol = "brcm-prepend";
+-
+ 			fixed-link {
+ 				speed = <1000>;
+ 				full-duplex;
+@@ -148,9 +146,5 @@
+ 		port@7 {
+ 			status = "disabled";
+ 		};
+-
+-		port@8 {
+-			dsa-tag-protocol = "brcm-prepend";
+-		};
+ 	};
+ };
