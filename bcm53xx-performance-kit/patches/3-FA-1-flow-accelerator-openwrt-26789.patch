+ 	.arl_read_entry = b53_arl_read_entry_25,
+ 	.arl_write_entry = b53_arl_write_entry_25,
+--- a/drivers/net/ethernet/broadcom/bgmac-fa.c
++++ b/drivers/net/ethernet/broadcom/bgmac-fa.c
+@@ -194,6 +194,7 @@ struct bgmac_fa_flow {
+ 	struct bgmac_fa_block *block;
+ 	struct bgmac_fa_tuple t;
+ 	struct dsa_port *in;		/* ingress port */
++	bool pvid;
+ 	int idx, next_hop, pool;	/* IPv6: entries idx and idx + 1 */
+ 	u32 hits;			/* last read from the entry */
+ 	u64 lastused;
+@@ -613,6 +614,7 @@ struct bgmac_fa_rule {
+ 	__be16 nat_port;
+ 	bool snat, dnat;		/* neither: routing only */
+ 	u16 push_vid;			/* VLAN tag to add */
++	bool pvid;
+ 	struct dsa_port *in, *out;
+ };
+ 
+@@ -635,6 +637,25 @@ static struct dsa_port *bgmac_fa_user_po
+ 	return NULL;
+ }
+ 
++static int bgmac_fa_pvid(const struct dsa_port *in, const struct dsa_port *out)
++{
++	int vid = b53_fa_pvid(out->ds, out->index);
++
++	if (vid > 0 && b53_fa_pvid(in->ds, in->index))
++		return -EOPNOTSUPP;
++
++	return vid;
++}
++
++static bool bgmac_fa_push_ok(const struct dsa_port *in,
++			     const struct dsa_port *out, u16 vid)
++{
++	if (b53_fa_pvid(in->ds, in->index))
++		return false;
++
++	return b53_fa_vlan_ok(out->ds, out->index, vid);
++}
++
+ static void bgmac_fa_mangle_eth(const struct flow_action_entry *act, u8 *eth)
+ {
+ 	void *dest = eth + act->mangle.offset;
+@@ -659,7 +680,7 @@ static int bgmac_fa_parse(struct bgmac *
+ 	bool snat_port = false, dnat_port = false;
+ 	bool vlan = false, pop = false;
+ 	struct net_device *out = NULL;
+-	int i;
++	int i, vid;
+ 
+ 	memset(r, 0, sizeof(*r));
+ 
+@@ -838,6 +859,16 @@ static int bgmac_fa_parse(struct bgmac *
+ 	if (!r->out)
+ 		return -EOPNOTSUPP;
+ 
++	if (r->push_vid && !bgmac_fa_push_ok(r->in, r->out, r->push_vid))
++		return -EOPNOTSUPP;
++	if (!r->push_vid) {
++		vid = bgmac_fa_pvid(r->in, r->out);
++		if (vid < 0 || (vid && pop))
++			return -EOPNOTSUPP;
++		r->push_vid = vid;
++		r->pvid = true;
++	}
++
+ 	return 0;
+ }
+ 
+@@ -959,10 +990,17 @@ static void bgmac_fa_flow_remove(struct
+ static bool bgmac_fa_flow_allowed(struct bgmac *bgmac,
+ 				  struct bgmac_fa_flow *flow)
+ {
++	struct bgmac_fa_next_hop *nh = &bgmac->fa->next_hop[flow->next_hop];
++
+ 	if ((flow->t.v6 || flow->t.proto == IPPROTO_TCP) &&
+ 	    !b53_fa_trap_active(flow->in->ds, flow->in->index))
+ 		return false;
+ 
++	if (flow->pvid && bgmac_fa_pvid(flow->in, nh->dp) != nh->vid)
++		return false;
++	if (!flow->pvid && !bgmac_fa_push_ok(flow->in, nh->dp, nh->vid))
++		return false;
++
+ 	return true;
+ }
+ 
+@@ -1003,6 +1041,7 @@ static int bgmac_fa_flow_add(struct bgma
+ 	flow->block = block;
+ 	flow->t = r.t;
+ 	flow->in = r.in;
++	flow->pvid = r.pvid;
+ 	flow->idx = base + i;
+ 	flow->lastused = jiffies;
+ 
+--- a/include/linux/dsa/b53.h
++++ b/include/linux/dsa/b53.h
