index 0000000000..973d532ee7
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/721-net-dsa-tag_brcm-accept-the-flow-accelerator-lookup-opcode.patch
@@ -0,0 +1,70 @@
+From 226eea9f7f5d1b3b0d5d8518b1e1026b156f397c Mon Sep 17 00:00:00 2001
+From: Erik Conijn <egc112@msn.com>
+Date: Sat, 14 Nov 2026 10:31:54 +0100
+Subject: [PATCH] net: dsa: tag_brcm: accept the flow accelerator's lookup
+ opcode
+
+The flow accelerator in front of switch port 8 of BCM5301x and BCM58xx
+puts the result of its flow lookup in the prepended tag: opcode 2, with
+its header check result in byte 2 and the source port in byte 3 as in
+opcode 0. Every frame that misses its flow table reaches the CPU that
+way once the accelerator is in the path, so the tagger dropped them all.
+
+Accept opcode 2 in the prepended tag only.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Erik Conijn <egc112@msn.com>
+---
+ net/dsa/tag_brcm.c | 29 ++++++++++++++++++++---------
+ 1 file changed, 20 insertions(+), 9 deletions(-)
+
+--- a/net/dsa/tag_brcm.c
++++ b/net/dsa/tag_brcm.c
+@@ -53,6 +53,12 @@
+ /* Ingress and egress opcodes */
+ #define BRCM_OPCODE_SHIFT	5
+ #define BRCM_OPCODE_MASK	0x7
++/* Egress opcode of the flow accelerator in front of port 8 of BCM5301x
++ * and BCM58xx, in the prepended tag only: the result of its flow lookup.
++ * Byte 2 then holds its header check result instead of a reason code;
++ * byte 3 holds the source port as with opcode 0.
++ */
++#define BRCM_OPCODE_FA_LOOKUP	0x2
+ 
+ /* Ingress fields */
+ /* 1st byte in the tag */
+@@ -150,21 +156,26 @@ static struct sk_buff *brcm_tag_rcv_ll(s
+ {
+ 	int source_port;
+ 	u8 *brcm_tag;
++	u8 opcode;
+ 
+ 	if (unlikely(!pskb_may_pull(skb, BRCM_TAG_LEN)))
+ 		return NULL;
+ 
+ 	brcm_tag = skb->data - offset;
++	opcode = (brcm_tag[0] >> BRCM_OPCODE_SHIFT) & BRCM_OPCODE_MASK;
+ 
+-	/* The opcode should never be different than 0b000 */
+-	if (unlikely((brcm_tag[0] >> BRCM_OPCODE_SHIFT) & BRCM_OPCODE_MASK))
+-		return NULL;
+-
+-	/* We should never see a reserved reason code without knowing how to
+-	 * handle it
+-	 */
+-	if (unlikely(brcm_tag[2] & BRCM_EG_RC_RSVD))
++	if (likely(!opcode)) {
++		/* We should never see a reserved reason code without knowing
++		 * how to handle it
++		 */
++		if (unlikely(brcm_tag[2] & BRCM_EG_RC_RSVD))
++			return NULL;
++	} else if (opcode != BRCM_OPCODE_FA_LOOKUP || offset != ETH_HLEN) {
++		/* Any other opcode, or the flow accelerator's one outside
++		 * the prepended tag, is unexpected
++		 */
+ 		return NULL;
++	}
+ 
+ 	/* Locate which port this is coming from */
+ 	source_port = brcm_tag[3] & BRCM_EG_PID_MASK;
diff --git a/target/linux/bcm53xx/patches-6.18/722-net-dsa-b53-allow-the-prepended-tag-on-Northstar-port-8.patch b/target/linux/bcm53xx/patches-6.18/722-net-dsa-b53-allow-the-prepended-tag-on-Northstar-port-8.patch
new file mode 100644
index 0000000000..cdf2e3f015
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/722-net-dsa-b53-allow-the-prepended-tag-on-Northstar-port-8.patch
@@ -0,0 +1,106 @@
+From 1ee9ebbf6aa71ea1dbd0a454530e247d69d9f425 Mon Sep 17 00:00:00 2001
+From: Erik Conijn <egc112@msn.com>
+Date: Sat, 14 Nov 2026 10:31:54 +0100
+Subject: [PATCH] net: dsa: b53: allow the prepended tag on Northstar port 8
+
+The BCM5301x (Northstar) switches of revision 3 and later, and all of
+BCM47094, have the same flow accelerator in front of port 8 as BCM58xx
+(Broadcom's et driver: FA_CAPABLE()). With it in the path the CPU sees
+the prepended tag, so let a device tree select "brcm-prepend" for such
+a switch with a CPU port 8, and keep the regular tag the default.
+
+The switch side is the same for both tags. DSA only changes the tagger
+while the conduits are down, which is when the conduit driver sets the
+accelerator up for it.
+
+Add the Broadcom taggers to the dsa-tag-protocol values of the binding.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Erik Conijn <egc112@msn.com>
+---
+ .../devicetree/bindings/net/dsa/dsa-port.yaml |  2 +
+ drivers/net/dsa/b53/b53_common.c              | 48 +++++++++++++++++++
+ 2 files changed, 50 insertions(+)
+
+--- a/Documentation/devicetree/bindings/net/dsa/dsa-port.yaml
++++ b/Documentation/devicetree/bindings/net/dsa/dsa-port.yaml
+@@ -51,6 +51,8 @@ properties:
+       possible. Useful when a device supports multiple protocols and
+       the default is incompatible with the Ethernet device.
+     enum:
++      - brcm
++      - brcm-prepend
+       - dsa
+       - edsa
+       - ocelot
+--- a/drivers/net/dsa/b53/b53_common.c
++++ b/drivers/net/dsa/b53/b53_common.c
+@@ -621,6 +621,17 @@ static int b53_port_set_mac_address(stru
+ 	return 0;
+ }
+ 
++/* The BCM5301x (Northstar) switches with a flow accelerator in front of
++ * port 8: switch revision 3 or later, or any BCM47094. As on BCM58xx, the
++ * accelerator turns the regular tag into a prepended one on its way to
++ * the CPU, once its driver has put it in the path.
++ */
++static bool b53_has_flow_accelerator(struct b53_device *dev)
++{
++	return is5301x(dev) &&
++	       (dev->core_rev >= 3 || of_machine_is_compatible("brcm,bcm47094"));
++}
++
+ static int b53_port_change_conduit(struct dsa_switch *ds, int port,
+ 				   struct net_device *conduit,
+ 				   struct netlink_ext_ack *extack)
+@@ -2695,6 +2706,42 @@ out:
+ }
+ EXPORT_SYMBOL(b53_get_tag_protocol);
+ 
++static int b53_change_tag_protocol(struct dsa_switch *ds,
++				   enum dsa_tag_protocol proto)
++{
++	struct b53_device *dev = ds->priv;
++	struct dsa_port *cpu_dp;
++	bool port8 = false;
++
++	/* Both tags use the same switch setup; only offer them where one of
++	 * them is in use already
++	 */
++	if (dev->tag_protocol != DSA_TAG_PROTO_BRCM &&
++	    dev->tag_protocol != DSA_TAG_PROTO_BRCM_PREPEND)
++		return -EPROTONOSUPPORT;
++
++	switch (proto) {
++	case DSA_TAG_PROTO_BRCM:
++		break;
++	case DSA_TAG_PROTO_BRCM_PREPEND:
++		dsa_switch_for_each_cpu_port(cpu_dp, ds)
++			if (cpu_dp->index == 8)
++				port8 = true;
++		if (!port8 || (dev->chip_id != BCM58XX_DEVICE_ID &&
++			       !b53_has_flow_accelerator(dev)))
++			return -EPROTONOSUPPORT;
++		break;
++	default:
++		return -EPROTONOSUPPORT;
++	}
++
++	dev->tag_protocol = proto;
++	dsa_switch_for_each_cpu_port(cpu_dp, ds)
++		b53_brcm_hdr_setup(ds, cpu_dp->index);
++
++	return 0;
++}
++
+ int b53_mirror_add(struct dsa_switch *ds, int port,
+ 		   struct dsa_mall_mirror_tc_entry *mirror, bool ingress,
+ 		   struct netlink_ext_ack *extack)
+@@ -2861,6 +2908,7 @@ static const struct phylink_mac_ops b53_
+ 
+ static const struct dsa_switch_ops b53_switch_ops = {
+ 	.get_tag_protocol	= b53_get_tag_protocol,
++	.change_tag_protocol	= b53_change_tag_protocol,
+ 	.preferred_default_local_cpu_port = b53_preferred_default_local_cpu_port,
+ 	.port_change_conduit	= b53_port_change_conduit,
+ 	.port_set_mac_address	= b53_port_set_mac_address,
diff --git a/target/linux/bcm53xx/patches-6.18/723-net-bgmac-set-up-the-Northstar-flow-accelerator.patch b/target/linux/bcm53xx/patches-6.18/723-net-bgmac-set-up-the-Northstar-flow-accelerator.patch
new file mode 100644
index 0000000000..952732b332
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/723-net-bgmac-set-up-the-Northstar-flow-accelerator.patch
@@ -0,0 +1,341 @@
+From ec8a9c67d2faa8d4a52c6a2d978d925eea1af420 Mon Sep 17 00:00:00 2001
+From: Erik Conijn <egc112@msn.com>
+Date: Sat, 14 Nov 2026 11:38:47 +0100
+Subject: [PATCH] net: bgmac: set up the Northstar flow accelerator
+
+The Northstar SoCs (BCM4708/4709/47094) have a flow accelerator between
+GMAC2 and switch port 8. Its registers are in the core space of GMAC3,
+which bgmac does not drive. Under OpenWrt nothing has set it up so far:
+it parses the traffic with tables that were never initialised and
+leaves the regular Broadcom tag alone.
+
+When the conduit on GMAC2 uses the prepended tag, put the accelerator in
+normal mode with its tables initialised and its header conversion on,
+on every open: DSA only changes the tagger while the conduit is down.
+With another tagger, put it back in bypass if an earlier open had put
+it in the path. The sequences follow Broadcom's et driver (fa_setmode(),
+fa_up(), fa_down() in et/sys/etc_fa.c, ISC licensed), whose copyright
+and permission notice the new file keeps.
+
+No flows are offloaded yet: every frame is a lookup miss and goes to the
+CPU as before.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Erik Conijn <egc112@msn.com>
+---
+ drivers/net/ethernet/broadcom/Makefile     |   2 +-
+ drivers/net/ethernet/broadcom/bgmac-bcma.c |   4 +
+ drivers/net/ethernet/broadcom/bgmac-fa.c   | 237 +++++++++++++++++++++
+ drivers/net/ethernet/broadcom/bgmac.c      |   6 +
+ drivers/net/ethernet/broadcom/bgmac.h      |   6 +
+ 5 files changed, 254 insertions(+), 1 deletion(-)
+ create mode 100644 drivers/net/ethernet/broadcom/bgmac-fa.c
+
+--- a/drivers/net/ethernet/broadcom/Makefile
++++ b/drivers/net/ethernet/broadcom/Makefile
+@@ -13,7 +13,7 @@ obj-$(CONFIG_BNX2X) += bnx2x/
+ obj-$(CONFIG_SB1250_MAC) += sb1250-mac.o
+ obj-$(CONFIG_TIGON3) += tg3.o
+ obj-$(CONFIG_BGMAC) += bgmac.o
+-obj-$(CONFIG_BGMAC_BCMA) += bgmac-bcma.o bgmac-bcma-mdio.o
++obj-$(CONFIG_BGMAC_BCMA) += bgmac-bcma.o bgmac-bcma-mdio.o bgmac-fa.o
+ obj-$(CONFIG_BGMAC_PLATFORM) += bgmac-platform.o
+ obj-$(CONFIG_SYSTEMPORT) += bcmsysport.o
+ obj-$(CONFIG_BNXT) += bnxt/
+--- a/drivers/net/ethernet/broadcom/bgmac-bcma.c
++++ b/drivers/net/ethernet/broadcom/bgmac-bcma.c
+@@ -311,6 +311,10 @@ static int bgmac_probe(struct bcma_devic
+ 	bgmac->cmn_maskset32 = bcma_bgmac_cmn_maskset32;
+ 	bgmac->phy_connect = bcma_phy_connect;
+ 
++	/* Northstar: the flow accelerator is between GMAC2 and switch port 8 */
++	if (bgmac_is_bcm4707_family(core) && core->core_unit == 2)
++		bgmac_fa_probe(bgmac);
++
+ 	err = bgmac_enet_probe(bgmac);
+ 	if (err)
+ 		goto err1;
+--- /dev/null
++++ b/drivers/net/ethernet/broadcom/bgmac-fa.c
+@@ -0,0 +1,237 @@
++// SPDX-License-Identifier: ISC
++/*
++ * Flow accelerator (FA) of the Broadcom Northstar SoCs (BCM4708, BCM4709,
++ * BCM47094)
++ *
++ * Copyright (C) 2015, Broadcom Corporation. All Rights Reserved.
++ * Copyright (C) 2026 Erik Conijn <egc112@msn.com>
++ *
++ * Permission to use, copy, modify, and/or distribute this software for any
++ * purpose with or without fee is hereby granted, provided that the above
++ * copyright notice and this permission notice appear in all copies.
++ *
++ * THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
++ * WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
++ * MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY
++ * SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
++ * WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN ACTION
++ * OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN
++ * CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
++ *
++ * The register map and the mode sequences follow Broadcom's et driver
++ * (et/sys/etc_fa.c and et/include/fa_core.h: fa_setmode(), fa_up() and
++ * fa_down()), as published under the ISC license in router GPL source
++ * releases.
++ *
++ * The FA sits between switch port 8 and GMAC2; its registers are in the
++ * core space of GMAC3, which is otherwise unused. With its header
++ * conversion on, it turns the switch's regular Broadcom tag into a
++ * prepended one, opcode 2, on the way to the CPU, and takes the prepended
++ * tag from the CPU. So it must be in the path exactly while the DSA
++ * conduit on GMAC2 uses the "brcm-prepend" tagger, which can only change
++ * while the conduit is down: set the mode on every open.
++ */
++
++#include <linux/bcma/bcma.h>
++#include <linux/iopoll.h>
++#include <linux/module.h>
++#include <net/dsa.h>
++
++#include "bgmac.h"
++
++#define FA_BASE				0xc00	/* in the GMAC3 core */
++
++#define FA_CONTROL			0x00
++#define  FA_CTL_SW_ACC_MODE		BIT(0)
++#define  FA_CTL_BYPASS			BIT(1)
++#define  FA_CTL_CRC_OWRT		BIT(3)
++#define  FA_CTL_NAPT_FLOW_INIT		BIT(13)
++#define  FA_CTL_NEXT_HOP_INIT		BIT(14)
++#define  FA_CTL_HWQ_INIT		BIT(15)
++#define  FA_CTL_LAB_INIT		BIT(16)
++#define  FA_CTL_HB_INIT			BIT(17)
++#define  FA_CTL_DSBL_MAC_DA_CHECK	BIT(18)
++#define FA_BCM_HDR_CTL			0x08
++#define  FA_BCM_HDR_HW_EN		BIT(0)
++#define  FA_BCM_HDR_SW_RX_EN		BIT(1)
++#define  FA_BCM_HDR_SW_TX_EN		BIT(2)
++#define  FA_BCM_HDR_PARSE_IGN_EN	BIT(3)
++#define FA_L2_SKIP_CTL			0x0c
++#define  FA_L2_SKIP_ET_TO_SNAP_CONV	BIT(20)
++#define FA_L3_IPV4_TYPE			0x28
++#define  FA_L3_IPV4_UDP_TCP		0x1106	/* reset value: 17, 6 */
++#define  FA_L3_IPV4_CKSUM_EN		BIT(16)
++#define FA_L3_NAPT_CTL			0x2c
++#define  FA_L3_NAPT_DEC_TTL		BIT(21)
++#define FA_STATUS			0x30
++#define  FA_STATUS_INIT_DONE		GENMASK(9, 5)
++#define FA_STATUS_MASK			0x34
++#define FA_RCV_STATUS_EN		0x38
++#define FA_ERROR			0x64
++#define FA_ERROR_MASK			0x68
++
++#define FA_CTL_INIT_ALL	(FA_CTL_NAPT_FLOW_INIT | FA_CTL_NEXT_HOP_INIT | \
++			 FA_CTL_HWQ_INIT | FA_CTL_LAB_INIT | FA_CTL_HB_INIT)
++
++struct bgmac_fa {
++	struct bcma_device *core;	/* GMAC3, holding the FA registers */
++	bool normal;			/* in the path since the last open */
++};
++
++static u32 fa_read(struct bgmac *bgmac, u16 reg)
++{
++	return bcma_read32(bgmac->fa->core, FA_BASE + reg);
++}
++
++static void fa_write(struct bgmac *bgmac, u16 reg, u32 val)
++{
++	bcma_write32(bgmac->fa->core, FA_BASE + reg, val);
++}
++
++static u32 fa_read_status(struct bgmac *bgmac)
++{
++	return fa_read(bgmac, FA_STATUS);
++}
++
++/* fa_setmode(): select the mode and initialise all tables; the init bits
++ * clear themselves and the status reports when the tables are done.
++ */
++static int bgmac_fa_setmode(struct bgmac *bgmac, bool bypass)
++{
++	u32 val, status;
++	int err;
++
++	val = fa_read(bgmac, FA_CONTROL);
++	val &= ~(FA_CTL_SW_ACC_MODE | FA_CTL_BYPASS);
++	if (bypass)
++		val |= FA_CTL_BYPASS;
++	val |= FA_CTL_DSBL_MAC_DA_CHECK | FA_CTL_INIT_ALL | FA_CTL_CRC_OWRT;
++	fa_write(bgmac, FA_CONTROL, val);
++
++	err = readx_poll_timeout(fa_read_status, bgmac, status,
++				 (status & FA_STATUS_INIT_DONE) ==
++				 FA_STATUS_INIT_DONE, 10, 50000);
++	if (err)
++		dev_err(bgmac->dev, "flow accelerator: no table init (status 0x%08x)\n",
++			status);
++	return err;
++}
++
++/* fa_up() in normal mode, with the header conversion that makes the FA
++ * produce and take the prepended tag (Broadcom only enables it with the
++ * hardware hash; the conversion itself does not depend on the hash).
++ */
++static int bgmac_fa_normal(struct bgmac *bgmac)
++{
++	int err;
++
++	err = bgmac_fa_setmode(bgmac, false);
++	if (err)
++		return err;
++
++	/* no interrupts, no frames held back for parse errors */
++	fa_write(bgmac, FA_STATUS_MASK, 0);
++	fa_write(bgmac, FA_RCV_STATUS_EN, 0);
++	fa_write(bgmac, FA_ERROR_MASK, 0);
++
++	fa_write(bgmac, FA_BCM_HDR_CTL, FA_BCM_HDR_HW_EN | FA_BCM_HDR_SW_RX_EN |
++		 FA_BCM_HDR_SW_TX_EN | FA_BCM_HDR_PARSE_IGN_EN);
++	fa_write(bgmac, FA_L2_SKIP_CTL, FA_L2_SKIP_ET_TO_SNAP_CONV);
++
++	/* Full values rather than fa_up()'s read-modify-write: bypass
++	 * clears both registers, and the reset values (TTL decrement, the
++	 * TCP and UDP protocol numbers) must come back after it. Software
++	 * hash, seed 0, hit counters not cleared on read.
++	 */
++	fa_write(bgmac, FA_L3_NAPT_CTL, FA_L3_NAPT_DEC_TTL);
++	fa_write(bgmac, FA_L3_IPV4_TYPE, FA_L3_IPV4_UDP_TCP | FA_L3_IPV4_CKSUM_EN);
++
++	/* the error register is write-1-to-clear */
++	fa_write(bgmac, FA_ERROR, fa_read(bgmac, FA_ERROR));
++
++	return 0;
++}
++
++/* fa_down(), FA side: bypass, empty tables, no header conversion */
++static int bgmac_fa_bypass(struct bgmac *bgmac)
++{
++	int err;
++
++	err = bgmac_fa_setmode(bgmac, true);
++	if (err)
++		return err;
++
++	fa_write(bgmac, FA_BCM_HDR_CTL, 0);
++	fa_write(bgmac, FA_L2_SKIP_CTL, 0);
++	fa_write(bgmac, FA_L3_NAPT_CTL, 0);
++	fa_write(bgmac, FA_L3_IPV4_TYPE, 0);
++
++	return 0;
++}
++
++static bool bgmac_fa_wanted(struct bgmac *bgmac)
++{
++#if IS_ENABLED(CONFIG_NET_DSA)
++	struct net_device *dev = bgmac->net_dev;
++
++	return netdev_uses_dsa(dev) && dev->dsa_ptr->index == 8 &&
++	       dev->dsa_ptr->tag_ops->proto == DSA_TAG_PROTO_BRCM_PREPEND;
++#else
++	return false;
++#endif
++}
++
++static int bgmac_fa_open(struct bgmac *bgmac)
++{
++	int err;
++
++	if (!bgmac_fa_wanted(bgmac)) {
++		/* back out of the path if an earlier open put it there */
++		if (!bgmac->fa->normal)
++			return 0;
++		err = bgmac_fa_bypass(bgmac);
++		if (!err)
++			bgmac->fa->normal = false;
++		return err;
++	}
++
++	if (!bcma_core_is_enabled(bgmac->fa->core)) {
++		dev_err(bgmac->dev, "flow accelerator: GMAC3 core is not enabled\n");
++		return -ENODEV;
++	}
++
++	err = bgmac_fa_normal(bgmac);
++	if (err)
++		return err;
++
++	if (!bgmac->fa->normal)
++		dev_info(bgmac->dev, "flow accelerator in the path (prepended tag)\n");
++	bgmac->fa->normal = true;
++
++	return 0;
++}
++
++/* Called for GMAC2 of a Northstar SoC; the FA is in its path to port 8 */
++void bgmac_fa_probe(struct bgmac *bgmac)
++{
++	struct bcma_device *core = bgmac->bcma.core;
++	struct bcma_device *gmac3;
++	struct bgmac_fa *fa;
++
++	gmac3 = bcma_find_core_unit(core->bus, BCMA_CORE_MAC_GBIT, 3);
++	if (!gmac3)
++		return;
++
++	fa = devm_kzalloc(bgmac->dev, sizeof(*fa), GFP_KERNEL);
++	if (!fa)
++		return;
++
++	fa->core = gmac3;
++	bgmac->fa = fa;
++	bgmac->fa_open = bgmac_fa_open;
++}
++EXPORT_SYMBOL_GPL(bgmac_fa_probe);
++
++MODULE_AUTHOR("Erik Conijn");
++MODULE_DESCRIPTION("Broadcom Northstar flow accelerator");
++MODULE_LICENSE("Dual BSD/GPL");
+--- a/drivers/net/ethernet/broadcom/bgmac.c
++++ b/drivers/net/ethernet/broadcom/bgmac.c
+@@ -1177,6 +1177,12 @@ static int bgmac_open(struct net_device
+ 	struct bgmac *bgmac = netdev_priv(net_dev);
+ 	int err = 0;
+ 
++	if (bgmac->fa_open) {
++		err = bgmac->fa_open(bgmac);
++		if (err)
++			return err;
++	}
++
+ 	bgmac_chip_reset(bgmac);
+ 
+ 	err = bgmac_dma_init(bgmac);
+--- a/drivers/net/ethernet/broadcom/bgmac.h
++++ b/drivers/net/ethernet/broadcom/bgmac.h
+@@ -436,6 +436,8 @@ struct bgmac_rx_header {
+ 	__le16 pad[12];
+ };
+ 
++struct bgmac_fa;
++
+ struct bgmac {
+ 	union {
+ 		struct {
+@@ -494,6 +496,9 @@ struct bgmac {
+ 	void (*cmn_maskset32)(struct bgmac *bgmac, u16 offset, u32 mask,
+ 			      u32 set);
+ 	int (*phy_connect)(struct bgmac *bgmac);
++	/* optional: the flow accelerator in front of this MAC (bgmac-fa.c) */
++	struct bgmac_fa *fa;
++	int (*fa_open)(struct bgmac *bgmac);
+ };
+ 
+ struct bgmac *bgmac_alloc(struct device *dev);
+@@ -506,6 +511,7 @@ int bgmac_enet_resume(struct bgmac *bgma
+ 
+ struct mii_bus *bcma_mdio_mii_register(struct bgmac *bgmac);
+ void bcma_mdio_mii_unregister(struct mii_bus *mii_bus);
++void bgmac_fa_probe(struct bgmac *bgmac);
+ 
+ static inline u32 bgmac_read(struct bgmac *bgmac, u16 offset)
+ {
diff --git a/target/linux/bcm53xx/patches-6.18/724-net-bgmac-offload-flows-to-the-Northstar-flow-accelerator.patch b/target/linux/bcm53xx/patches-6.18/724-net-bgmac-offload-flows-to-the-Northstar-flow-accelerator.patch
new file mode 100644
index 0000000000..cd550c0d22
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/724-net-bgmac-offload-flows-to-the-Northstar-flow-accelerator.patch
@@ -0,0 +1,1186 @@
+From 24f5f4efb6f6bface0846a2eae9c0d1a7d4796e2 Mon Sep 17 00:00:00 2001
+From: Erik Conijn <egc112@msn.com>
+Date: Sat, 14 Nov 2026 16:51:38 +0100
+Subject: [PATCH] net: bgmac: offload flows to the Northstar flow accelerator
+
+With the flow accelerator in the path (previous patch), let it forward
+the connections that a netfilter flowtable offloads. DSA passes the
+flowtable block from the user ports to the conduit's ndo_setup_tc, so
+bgmac gets one, and NETIF_F_HW_TC to switch it off.
+
+Offloaded: IPv4 TCP and UDP between two user ports of the switch behind
+this conduit, routed or with NAT of the source or of the destination
+(address and port). Everything else stays in software: IPv6, VLAN and
+PPPoE, both kinds of NAT at once, fragments.
+
+Each direction is one entry of the 1024-entry flow table, in one of the
+four slots selected by the software hash (CRC-ITU-T over the tuple, as
+fa_crc_ccitt() in Broadcom's etc_fa.c). The entry points to a next hop
+(destination MAC) and a pool entry (source MAC), shared between flows.
+The table formats and the access sequence follow etc_fa.c; the
+flow_rule parsing follows mtk_ppe_offload.c.
+
+Three details found on the hardware:
+- The FA hands its output to the switch with a tag that leaves the
+  forwarding to the switch's address table. DSA keeps learning off on
+  standalone ports such as the WAN port, so the switch flooded every
+  offloaded frame to all ports. Give it a static FDB entry for a next
+  hop behind a standalone port, as long as the next hop is in use.
+- The flowtable offloads the two directions separately and retries only
+  when both were refused. A direction whose reply does not fit in its
+  bucket is refused too, so the connection stays in software as a whole
+  and is retried later.
+- nf_tables unbinds a flowtable block on a ruleset change and tears its
+  connections down only after the last driver unbound, so the driver
+  never hears about them; a firewall reload left the old entries
+  forwarding outside the new ruleset. Remove a block's flows when it is
+  unbound.
+
+The tables are initialised on every open, so stop drops all flows; the
+flowtable then offloads the connections again from software.
+
+A table access busy-waits for the hardware, as etc_fa.c does: it takes
+microseconds. Sleeping there, under the lock that every add, removal
+and counter read takes, made the flowtable's workers queue up: with
+about 250 flows the load average reached 15 while the CPU was idle.
+On the A2 revision of the BCM4707 family (not BCM47094), etc_fa.c also
+lowers the hardware queue threshold and waits 1 ms around each table
+access (WAR777). Here that is done once per locked operation, so a flow
+add or removal waits once, not for each of its table accesses. No A2
+board was available to test it.
+
+The FA counts hits per entry but not bytes: the flowtable gets packet
+counts and the last-used time. One hit is one packet: on a Linksys
+EA6900, three runs of 74998 and 100002 UDP datagrams through an
+offloaded flow each ended with the conntrack packet counter at that
+number plus one, for the datagram that set the flow up.
+
+Known limits, for the patches that follow: the FA drops IPv4 packets
+with TTL 1 silently instead of passing them to Linux for the ICMP time
+exceeded, and it forwards a TCP FIN or RST without telling the
+flowtable, so the connection stays established in conntrack until it
+times out.
+
+Measured on a Linksys EA6900 (BCM4708), iperf3 TCP between a LAN port
+and the WAN port through NAT, upload/download in Mbit/s:
+- no offloading:              367/438, one CPU core busy
+- software flow offloading:   456/535, one CPU core busy
+- hardware flow offloading:   941/941, 1-3 % CPU
+- port forward from the WAN:  949/926, 1 % CPU
+Thirty firewall reloads during one transfer kept it at 938 Mbit/s with
+exactly two entries in the table each time, and the table was empty
+again a minute after the transfer.
+
+After a reload, conntrack sometimes shows such a connection as
+[OFFLOAD] instead of [HW_OFFLOAD] while the hardware forwards it: the
+old and the new flowtable share the conntrack entry, and the old one's
+delete work can clear IPS_HW_OFFLOAD after the new one's add work set
+it. That is the flowtable core, not this driver.
+
