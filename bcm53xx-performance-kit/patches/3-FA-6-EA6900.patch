diff --git a/target/linux/bcm53xx/patches-6.18/328-ARM-dts-BCM5301X-EA6900-use-the-flow-accelerator-tag.patch b/target/linux/bcm53xx/patches-6.18/328-ARM-dts-BCM5301X-EA6900-use-the-flow-accelerator-tag.patch
new file mode 100644
index 0000000000..b743f965be
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/328-ARM-dts-BCM5301X-EA6900-use-the-flow-accelerator-tag.patch
@@ -0,0 +1,26 @@
+From 46680993eb0fef1dee1f0eac941f44841c1576f6 Mon Sep 17 00:00:00 2001
+From: Erik Conijn <egc112@msn.com>
+Date: Sat, 14 Nov 2026 10:31:54 +0100
+Subject: [PATCH] ARM: dts: BCM5301X: EA6900: use the flow accelerator's tag
+
+Use the prepended Broadcom tag on the CPU port (port 8, gmac2), so that
+the flow accelerator between them is in the path. The EA6900's BCM4708
+has switch revision 3, which has the accelerator.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Erik Conijn <egc112@msn.com>
+---
+ arch/arm/boot/dts/broadcom/bcm4708-linksys-ea6900.dts | 2 ++
+ 1 file changed, 2 insertions(+)
+
+--- a/arch/arm/boot/dts/broadcom/bcm4708-linksys-ea6900.dts
++++ b/arch/arm/boot/dts/broadcom/bcm4708-linksys-ea6900.dts
+@@ -148,6 +148,8 @@
+ 
+ 		port@8 {
+ 			label = "cpu";
++			/* through the flow accelerator, see bgmac-fa.c */
++			dsa-tag-protocol = "brcm-prepend";
+ 		};
+ 	};
+ };
diff --git a/target/linux/bcm53xx/patches-6.18/329-ARM-dts-BCM5301X-EA6900-add-port-5-for-the-flow-accelerator-traps.patch b/target/linux/bcm53xx/patches-6.18/329-ARM-dts-BCM5301X-EA6900-add-port-5-for-the-flow-accelerator-traps.patch
new file mode 100644
index 0000000000..12a7a67c1f
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/329-ARM-dts-BCM5301X-EA6900-add-port-5-for-the-flow-accelerator-traps.patch
@@ -0,0 +1,37 @@
+From 1cf984275e087fe4357b9ad890641772a98f5bc1 Mon Sep 17 00:00:00 2001
+From: Erik Conijn <egc112@msn.com>
+Date: Sat, 14 Nov 2026 13:44:04 +0100
+Subject: [PATCH] ARM: dts: BCM5301X: EA6900: add port 5 for the flow
+ accelerator traps
+
+Describe switch port 5, connected to gmac0, as a second CPU port. b53
+redirects the frames that the flow accelerator in front of port 8
+cannot handle (TTL 1, TCP FIN and RST) to it. The tree has one tagger,
+so the port names the same one as port 8; it carries the regular tag.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Erik Conijn <egc112@msn.com>
+---
+ arch/arm/boot/dts/broadcom/bcm4708-linksys-ea6900.dts | 11 ++++++++++-
+ 1 file changed, 10 insertions(+), 1 deletion(-)
+
+--- a/arch/arm/boot/dts/broadcom/bcm4708-linksys-ea6900.dts
++++ b/arch/arm/boot/dts/broadcom/bcm4708-linksys-ea6900.dts
+@@ -139,7 +139,16 @@
+ 		};
+ 
+ 		port@5 {
+-			status = "disabled";
++			/* takes the flow accelerator's traps, see b53_common.c;
++			 * one tagger per tree, and this port carries the
++			 * regular tag
++			 */
++			dsa-tag-protocol = "brcm-prepend";
++
++			fixed-link {
++				speed = <1000>;
++				full-duplex;
++			};
+ 		};
+ 
+ 		port@7 {
diff --git a/target/linux/bcm53xx/patches-6.18/384-ARM-dts-BCM5301X-EA6900-set-WAN-MAC-from-nvram.patch b/target/linux/bcm53xx/patches-6.18/384-ARM-dts-BCM5301X-EA6900-set-WAN-MAC-from-nvram.patch
new file mode 100644
index 0000000000..7a8a846ca5
--- /dev/null
+++ b/target/linux/bcm53xx/patches-6.18/384-ARM-dts-BCM5301X-EA6900-set-WAN-MAC-from-nvram.patch
@@ -0,0 +1,28 @@
+From: Erik Conijn <egc112@msn.com>
+Subject: [PATCH] ARM: dts: BCM5301X: EA6900: set WAN MAC from nvram
+
+The WAN port's MAC address is et0macaddr + 1, which user space sets on
+the port today. Read it from nvram instead, so the port keeps it when
+it moves to the other CPU port; a port without one takes the LAN
+address of its new conduit, and 703 refuses that move.
+
+Kit copy of the EA6900 part of 383 in openwrt#26789.
+
+The value is the one OpenWrt sets from user space when nvram has no
+wan_hwaddr.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Erik Conijn <egc112@msn.com>
+---
+--- a/arch/arm/boot/dts/broadcom/bcm4708-linksys-ea6900.dts
++++ b/arch/arm/boot/dts/broadcom/bcm4708-linksys-ea6900.dts
+@@ -120,6 +120,9 @@
+ 	ports {
+ 		port@0 {
+ 			label = "wan";
++
++			nvmem-cells = <&et0macaddr 1>;
++			nvmem-cell-names = "mac-address";
+ 		};
+ 
+ 		port@1 {
