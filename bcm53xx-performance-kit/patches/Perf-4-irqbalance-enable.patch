diff --git a/target/linux/bcm53xx/base-files/etc/uci-defaults/99-irqbalance-enable b/target/linux/bcm53xx/base-files/etc/uci-defaults/99-irqbalance-enable
new file mode 100755
index 0000000000..eb51af7716
--- /dev/null
+++ b/target/linux/bcm53xx/base-files/etc/uci-defaults/99-irqbalance-enable
@@ -0,0 +1,7 @@
+#!/bin/sh
+# The irqbalance package installs disabled. On the dual-core Northstar boards Ethernet and the radios
+# otherwise share CPU core 0, and a busy 5 GHz radio starves the 2.4 GHz one (EA6900, measured 2026-10-29).
+[ -f /etc/config/irqbalance ] || exit 0
+uci -q set irqbalance.irqbalance.enabled='1'
+uci commit irqbalance
+exit 0
