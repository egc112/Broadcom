From: aleferri b43-ac-wip
Subject: [PATCH] b43: AC-PHY carry of b43/ from 3517def to bc63d98

Includes 15206f2, 421c6cc, 982f500, 4c5d6e5, our merged PR #5 (909/911/921/922) and bc63d98.
---
diff --git a/drivers/net/wireless/broadcom/b43/b43.h b/drivers/net/wireless/broadcom/b43/b43.h
index e739c8e..97b3b2f 100644
--- a/drivers/net/wireless/broadcom/b43/b43.h
+++ b/drivers/net/wireless/broadcom/b43/b43.h
@@ -9,6 +9,7 @@
 #include <linux/bcma/bcma.h>
 #include <linux/ssb/ssb.h>
 #include <linux/completion.h>
+#include <linux/ratelimit.h>
 #include <net/mac80211.h>
 
 #include "debugfs.h"
@@ -344,6 +345,7 @@ enum {
 #define B43_SHM_SH_LFFBLIM		0x0046	/* Long frame fallback retry limit */
 #define B43_SHM_SH_BEACPHYCTL		0x0054	/* Beacon PHY TX control word (see PHY TX control) */
 #define B43_SHM_SH_BEACPHYCTL_AC	0x00CC	/* Beacon PHY TX control word, AC microcode */
+#define B43_SHM_SH_TXCORE_AC		0x05D4	/* TX core mask per rate class, 5 words, AC microcode */
 #define B43_SHM_SH_EXTNPHYCTL		0x00B0	/* Extended bytes for beacon PHY control (N) */
 #define B43_SHM_SH_BCN_LI		0x00B6	/* beacon listen interval */
 /* SHM_SHARED ACK/CTS control */
@@ -1032,6 +1034,9 @@ struct b43_wldev {
 	bool cac_pending;
 	struct cfg80211_chan_def tuned_chandef;
 
+	/* AC: rate limit of the TX state dump on a PHY TX error. */
+	struct ratelimit_state txerr_dump_rs;
+
 	struct work_struct restart_work;
 
 	/* encryption/decryption */
diff --git a/drivers/net/wireless/broadcom/b43/dma.c b/drivers/net/wireless/broadcom/b43/dma.c
index 819e81b..5417f38 100644
--- a/drivers/net/wireless/broadcom/b43/dma.c
+++ b/drivers/net/wireless/broadcom/b43/dma.c
@@ -718,6 +718,8 @@ static int dmacontroller_setup(struct b43_dmaring *ring)
 			if (!parity)
 				enable |= B43_DMA64_TXPARITYDISABLE;
 			if (ring->dev->dma.index_is_addr) {
+				value |= b43_dma_read(ring, B43_DMA64_TXCTL) &
+					 B43_DMA64_TXCTL_KEEP;
 				b43_dma_write(ring, B43_DMA64_TXCTL, value);
 				b43_dma_write(ring, B43_DMA64_TXRINGLO, addrlo);
 				b43_dma_write(ring, B43_DMA64_TXRINGHI, addrhi);
@@ -759,6 +761,8 @@ static int dmacontroller_setup(struct b43_dmaring *ring)
 			if (!parity)
 				value |= B43_DMA64_RXPARITYDISABLE;
 			if (ring->dev->dma.index_is_addr) {
+				value |= b43_dma_read(ring, B43_DMA64_RXCTL) &
+					 B43_DMA64_RXCTL_KEEP;
 				b43_dma_write(ring, B43_DMA64_RXRINGLO, addrlo);
 				b43_dma_write(ring, B43_DMA64_RXRINGHI, addrhi);
 				b43_dma_write(ring, B43_DMA64_RXCTL, value);
@@ -1099,8 +1103,8 @@ static bool b43_dma_translation_in_low_word(struct b43_wldev *dev,
  * addresses in its index registers, asked of the engine as the stock driver
  * does: write all ones to the ring address and see which low bits stay, the
  * 0xff0 of brcmsmac's _dma_descriptor_align(). Such an engine also gets its
- * ring address before it is enabled; the others after, as b43 has always
- * done.
+ * ring address before it is enabled, and keeps its outstanding reads, burst
+ * and prefetch; the others are set up as b43 has always done.
  */
 static bool b43_dma64_index_is_addr(struct b43_wldev *dev)
 {
diff --git a/drivers/net/wireless/broadcom/b43/dma.h b/drivers/net/wireless/broadcom/b43/dma.h
index 13d9394..6dfd859 100644
--- a/drivers/net/wireless/broadcom/b43/dma.h
+++ b/drivers/net/wireless/broadcom/b43/dma.h
@@ -90,6 +90,7 @@ struct b43_dmadesc32 {
 #define		B43_DMA64_TXPARITYDISABLE		0x00000800
 #define		B43_DMA64_TXADDREXT_MASK		0x00030000
 #define		B43_DMA64_TXADDREXT_SHIFT		16
+#define		B43_DMA64_TXCTL_KEEP		0x03FC00C0	/* Outstanding reads, burst, prefetch */
 #define B43_DMA64_TXINDEX				0x04
 #define B43_DMA64_TXRINGLO				0x08
 #define B43_DMA64_TXRINGHI				0x0C
@@ -118,6 +119,7 @@ struct b43_dmadesc32 {
 #define		B43_DMA64_RXPARITYDISABLE		0x00000800
 #define		B43_DMA64_RXADDREXT_MASK		0x00030000
 #define		B43_DMA64_RXADDREXT_SHIFT		16
+#define		B43_DMA64_RXCTL_KEEP		0x03FC0000	/* Burst, prefetch */
 #define B43_DMA64_RXINDEX				0x24
 #define B43_DMA64_RXRINGLO				0x28
 #define B43_DMA64_RXRINGHI				0x2C
diff --git a/drivers/net/wireless/broadcom/b43/main.c b/drivers/net/wireless/broadcom/b43/main.c
index 0d11173..ace0d8e 100644
--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -2011,9 +2011,21 @@ static void b43_write_template_common(struct b43_wldev *dev,
 				      u16 ram_offset,
 				      u16 shm_size_offset, u8 rate)
 {
+	struct b43_tpl_layout cck_tpl;
 	const struct b43_tpl_layout *tpl = dev->fw.tpl;
 	unsigned int i, total = tpl->hdr_len + size;
 	struct b43_plcp_hdr4 plcp;
+
+	/*
+	 * The 12-byte AC header carries the PLCP at offset 3 for OFDM and at
+	 * offset 6 for CCK (aleferri/b43-ac-wip#4); a CCK beacon with it at 3
+	 * faulted on every TBTT on 2.4 GHz.
+	 */
+	if (tpl->hdr_len == 12 && b43_is_cck_rate(rate)) {
+		cck_tpl = *tpl;
+		cck_tpl.plcp_off = 6;
+		tpl = &cck_tpl;
+	}
 	struct b43_ram_seq seq = { .next = U16_MAX }, *s = NULL;
 
 	if (dev->phy.type == B43_PHYTYPE_AC) {
@@ -2479,6 +2491,102 @@ out:
 			B43_DEBUGIRQ_REASON_REG, B43_DEBUGIRQ_ACK);
 }
 
+/*
+ * Not rate-limited: a dump is one line per rate, and net_ratelimit() would
+ * cut it short. Its callers limit it instead.
+ */
+static __printf(2, 3) void b43_ac_state_print(struct b43_wl *wl,
+					      const char *fmt, ...)
+{
+	struct va_format vaf;
+	va_list args;
+
+	if (b43_modparam_verbose < B43_VERBOSITY_INFO)
+		return;
+
+	va_start(args, fmt);
+	vaf.fmt = fmt;
+	vaf.va = &args;
+	printk(KERN_INFO "b43-%s: %pV", wiphy_name(wl->hw->wiphy), &vaf);
+	va_end(args);
+}
+
+#define B43_AC_TXERR_DUMP_INTERVAL	(60 * HZ)
+/* Words of a rate block: the direct maps point ten words apart. */
+#define B43_AC_RT_BLOCK_WORDS		10
+
+/* A rate's slot in the direct and basic maps, which are picked by its class. */
+static u16 b43_rate_map_slot(u16 hw_value, u16 *direct, u16 *basic)
+{
+	if (b43_is_cck_rate(hw_value)) {
+		*direct = B43_SHM_SH_CCKDIRECT;
+		*basic = B43_SHM_SH_CCKBASIC;
+		return b43_plcp_get_ratecode_cck(hw_value) & 0xF;
+	}
+	*direct = B43_SHM_SH_OFDMDIRECT;
+	*basic = B43_SHM_SH_OFDMBASIC;
+	return b43_plcp_get_ratecode_ofdm(hw_value) & 0xF;
+}
+
+/*
+ * What the AC microcode builds its own frames from: the beacon's PHY control
+ * words, the TX core table, the probe-response cells and, for each rate of
+ * the band, its direct and basic map entries and the rate block the direct
+ * map points to.
+ */
+static void b43_ac_dump_tx_state(struct b43_wldev *dev, const char *why)
+{
+	struct b43_wl *wl = dev->wl;
+	const struct ieee80211_supported_band *sband =
+		wl->hw->wiphy->bands[b43_current_band(wl)];
+	u16 phyctl[3], cores[5], blk[B43_AC_RT_BLOCK_WORDS];
+	unsigned int i, j;
+
+	b43_ac_state_print(wl, "%s: width %d, tuned %d, MACCTL 0x%08x, "
+			   "HOSTF5 0x%04x, PRMAXTIME %u, PRTLEN %u, "
+			   "PRSSIDLEN 0x%04x\n",
+			   why, wl->hw->conf.chandef.width,
+			   dev->tuned_chandef.width,
+			   b43_read32(dev, B43_MMIO_MACCTL),
+			   b43_shm_read16(dev, B43_SHM_SHARED, B43_SHM_SH_HOSTF5),
+			   b43_shm_read16(dev, B43_SHM_SHARED,
+					  B43_SHM_SH_PRMAXTIME),
+			   b43_shm_read16(dev, B43_SHM_SHARED, B43_SHM_SH_PRTLEN),
+			   b43_shm_read16(dev, B43_SHM_SHARED,
+					  B43_SHM_SH_PRSSIDLEN));
+
+	for (j = 0; j < ARRAY_SIZE(phyctl); j++)
+		phyctl[j] = b43_shm_read16(dev, B43_SHM_SHARED,
+					   B43_SHM_SH_BEACPHYCTL_AC + 2 * j);
+	for (j = 0; j < ARRAY_SIZE(cores); j++)
+		cores[j] = b43_shm_read16(dev, B43_SHM_SHARED,
+					  B43_SHM_SH_TXCORE_AC + 2 * j);
+	b43_ac_state_print(wl, "%s: beacon phyctl %04x %04x %04x, "
+			   "TX cores %04x %04x %04x %04x %04x\n",
+			   why, phyctl[0], phyctl[1], phyctl[2],
+			   cores[0], cores[1], cores[2], cores[3], cores[4]);
+
+	for (i = 0; i < sband->n_bitrates; i++) {
+		const struct ieee80211_rate *rate = &sband->bitrates[i];
+		u16 direct, basic, slot, ptr;
+
+		slot = b43_rate_map_slot(rate->hw_value, &direct, &basic);
+		ptr = b43_shm_read16(dev, B43_SHM_SHARED, direct + 2 * slot);
+		for (j = 0; j < ARRAY_SIZE(blk); j++)
+			blk[j] = ptr ? b43_shm_read16(dev, B43_SHM_SHARED,
+						      2 * ptr + 2 * j) : 0;
+		b43_ac_state_print(wl, "%s: %u.%u Mb/s direct 0x%04x basic "
+				   "0x%04x, block %04x %04x %04x %04x %04x "
+				   "%04x %04x %04x %04x %04x\n",
+				   why, rate->bitrate / 10, rate->bitrate % 10,
+				   ptr,
+				   b43_shm_read16(dev, B43_SHM_SHARED,
+						  basic + 2 * slot),
+				   blk[0], blk[1], blk[2], blk[3], blk[4],
+				   blk[5], blk[6], blk[7], blk[8], blk[9]);
+	}
+}
+
 static void b43_ac_report_phy_txerr(struct b43_wldev *dev)
 {
 	u16 base = dev->fw.shm ? dev->fw.shm->txerr : 0;
@@ -2508,6 +2616,8 @@ static void b43_ac_report_phy_txerr(struct b43_wldev *dev)
 		b43_shm_read16(dev, B43_SHM_SHARED, base + B43_TXERR_FRAME),
 		ctl[0], ctl[1], ctl[2], plcp[0], plcp[1], plcp[2], plcp[3],
 		plcp[4], plcp[5], plcp[6]);
+	if (__ratelimit(&dev->txerr_dump_rs))
+		b43_ac_dump_tx_state(dev, "TX fault");
 	b43_shm_write16(dev, B43_SHM_SHARED, base, 0);
 }
 
@@ -3822,7 +3932,6 @@ static void b43_rate_memory_init(struct b43_wldev *dev)
 	case B43_PHYTYPE_LP:
 	case B43_PHYTYPE_HT:
 	case B43_PHYTYPE_LCN:
-	case B43_PHYTYPE_AC:
 		b43_rate_memory_write(dev, B43_OFDM_RATE_6MB, 1);
 		b43_rate_memory_write(dev, B43_OFDM_RATE_9MB, 1);
 		b43_rate_memory_write(dev, B43_OFDM_RATE_12MB, 1);
@@ -3838,6 +3947,15 @@ static void b43_rate_memory_init(struct b43_wldev *dev)
 		b43_rate_memory_write(dev, B43_CCK_RATE_5MB, 0);
 		b43_rate_memory_write(dev, B43_CCK_RATE_11MB, 0);
 		break;
+	case B43_PHYTYPE_AC:
+		/*
+		 * The AC microcode reaches its rate blocks through the direct
+		 * and basic maps at B43_SHM_SH_OFDMDIRECT and following, and
+		 * 0x480-0x4ff is no table of it. Its basic maps are written by
+		 * the PHY init (b43_phy_ac_basic_rate_map()) and by
+		 * b43_update_basic_rates().
+		 */
+		break;
 	default:
 		B43_WARN_ON(1);
 	}
@@ -4591,10 +4709,17 @@ static bool b43_tx_rates_ok(struct ieee80211_hw *hw,
 {
 	const struct ieee80211_supported_band *band = hw->wiphy->bands[info->band];
 	const struct ieee80211_tx_rate *r = info->control.rates;
+	struct b43_wldev *dev = hw_to_b43_wl(hw)->current_dev;
 
 	if (!band)
 		return false;
-	if (band->vht_cap.vht_supported)
+	/*
+	 * Whether the frame gets the AC descriptor follows the firmware's
+	 * header format, not the band: the 2.4 GHz band of an AC-PHY core has
+	 * HT but no VHT, and its MCS rates need the AC descriptor as well.
+	 */
+	if (band->vht_cap.vht_supported ||
+	    (dev && dev->fw.hdr_format == B43_FW_HDR_AC))
 		return b43_txhdr_ac_rate_ok(band, &r[0]);
 	return !b43_tx_rate_is_mcs(&r[0]) && !b43_tx_rate_is_mcs(&r[1]);
 }
@@ -5337,6 +5462,10 @@ static void b43_op_bss_info_changed(struct ieee80211_hw *hw,
 			b43_short_slot_timing_disable(dev);
 	}
 
+	if (dev->phy.type == B43_PHYTYPE_AC &&
+	    changed & BSS_CHANGED_BEACON_ENABLED && conf->enable_beacon)
+		b43_ac_dump_tx_state(dev, "beaconing");
+
 	b43_mac_enable(dev);
 out_unlock_mutex:
 	mutex_unlock(&wl->mutex);
@@ -5508,6 +5637,8 @@ static void b43_op_configure_filter(struct ieee80211_hw *hw,
 		   FIF_OTHER_BSS |
 		   FIF_BCN_PRBRESP_PROMISC;
 
+	/* @changed is against mac80211's flags, which survive b43_op_start(). */
+	changed |= wl->filter_flags ^ *fflags;
 	wl->filter_flags = *fflags;
 
 	if (changed && b43_status(dev) >= B43_STAT_INITIALIZED)
@@ -6175,10 +6306,11 @@ static int b43_wireless_core_init(struct b43_wldev *dev)
 	 * end state matches, not the order. The beacon TSF offset depends on
 	 * the mode, see b43_adjust_opmode().
 	 *
-	 * The probe-response offload stays off (PRMAXTIME below), so its cells,
-	 * PRSSID, PRSSIDLEN and PRTLEN, are left alone, and so is HOSTF5 bit
-	 * 15, with which the microcode keeps probe requests for itself
-	 * (b43_phy_ac_op_switch_channel()).
+	 * The probe-response offload stays off (HOSTF2 bit 0, set by
+	 * b43_phy_ac_op_switch_channel(); the PRMAXTIME below is overwritten
+	 * there), so its cells, PRSSID, PRSSIDLEN and PRTLEN, are left alone,
+	 * and so is HOSTF5 bit 15, with which the microcode keeps probe
+	 * requests for itself.
 	 */
 	if (dev->dev->core_rev >= 42) {
 		b43_shm_write16(dev, B43_SHM_SHARED,
@@ -6779,6 +6911,11 @@ static int b43_setup_bands(struct b43_wldev *dev,
 		hw->wiphy->bands[NL80211_BAND_2GHZ] = band;
 	}
 	if (dev->phy.type == B43_PHYTYPE_AC) {
+		/* A rate and its fallbacks, a block each. */
+		hw->max_rates = B43_TXH_AC_RATES;
+		ieee80211_hw_set(hw, AMPDU_AGGREGATION);
+		hw->max_tx_aggregation_subframes = IEEE80211_MAX_AMPDU_BUF_HT;
+		hw->max_rx_aggregation_subframes = IEEE80211_MAX_AMPDU_BUF_HT;
 		if (have_5ghz_phy) {
 			struct ieee80211_supported_band *band =
 				&dev->wl->band_5ghz_ac;
@@ -6786,13 +6923,6 @@ static int b43_setup_bands(struct b43_wldev *dev,
 			*band = b43_band_5GHz_acphy;
 			b43_ac_set_ht_vht_cap(dev, band);
 			hw->wiphy->bands[NL80211_BAND_5GHZ] = band;
-			/* A rate and its fallbacks, a block each. */
-			hw->max_rates = B43_TXH_AC_RATES;
-			ieee80211_hw_set(hw, AMPDU_AGGREGATION);
-			hw->max_tx_aggregation_subframes =
-				IEEE80211_MAX_AMPDU_BUF_HT;
-			hw->max_rx_aggregation_subframes =
-				IEEE80211_MAX_AMPDU_BUF_HT;
 		}
 	} else
 	if (dev->phy.type == B43_PHYTYPE_N) {
@@ -6887,6 +7017,12 @@ static void b43_supported_bands(struct b43_wldev *dev, bool *have_2ghz_phy,
 		*have_2ghz_phy = false;
 		*have_5ghz_phy = true;
 		return;
+	case 0x43a1: /* BCM4360 */
+	case 0x43b2: /* BCM4352 */
+		/* 2.4 GHz only devices */
+		*have_2ghz_phy = true;
+		*have_5ghz_phy = false;
+		return;
 	}
 
 	/* As a fallback, try to guess using PHY type */
@@ -7045,6 +7181,9 @@ static int b43_one_core_attach(struct b43_bus_dev *dev, struct b43_wl *wl)
 	b43_set_status(wldev, B43_STAT_UNINIT);
 	wldev->bad_frames_preempt = modparam_bad_frames_preempt;
 	INIT_LIST_HEAD(&wldev->list);
+	ratelimit_state_init(&wldev->txerr_dump_rs,
+			     B43_AC_TXERR_DUMP_INTERVAL, 1);
+	ratelimit_set_flags(&wldev->txerr_dump_rs, RATELIMIT_MSG_ON_RELEASE);
 
 	err = b43_wireless_core_attach(wldev);
 	if (err)
diff --git a/drivers/net/wireless/broadcom/b43/phy_ac.c b/drivers/net/wireless/broadcom/b43/phy_ac.c
index 3848285..330516f 100644
--- a/drivers/net/wireless/broadcom/b43/phy_ac.c
+++ b/drivers/net/wireless/broadcom/b43/phy_ac.c
@@ -972,7 +972,8 @@ static void b43_phy_ac_chainmask_block(struct b43_wldev *dev,
 		hweight8((u8)pair[1]) > 1 ? pair[1] : mask;
 	txcore[B43_PHY_AC_TXCORE_NSTS1 + 2] = mask;
 	for (i = 0; i <= B43_PHY_AC_TXCORE_NSTS1 + 1; i++)
-		b43_shm_write16(dev, B43_SHM_SHARED, 0x05d4 + 2 * i, txcore[i]);
+		b43_shm_write16(dev, B43_SHM_SHARED, B43_SHM_SH_TXCORE_AC + 2 * i,
+				txcore[i]);
 }
 
 /*
@@ -991,6 +992,14 @@ static void b43_phy_ac_bss_cc_update(struct b43_wldev *dev,
 	u16 cc = b43_shm_read16(dev, B43_SHM_SHARED, 0x00cc);
 
 	b43_phy_ac_chain_pair(dev, site, dev->phy.ac->cal_width, pair);
+	/*
+	 * A CCK beacon on 2.4 GHz goes out on one chain, as the CCK cell of
+	 * 0x05d4 and the initvals' 0x0044 have it; with the OFDM mask (0x01c4)
+	 * every CCK beacon ended in a PHY transmission error.
+	 */
+	if (dev->phy.ac->beacon_cck &&
+	    b43_current_band(dev->wl) == NL80211_BAND_2GHZ)
+		pair[0] = b43_phy_ac_chain_mask(dev->phy.ac->coremask, 1);
 	cc = (u16)((cc & ~0x01c0) | (pair[0] << 6));
 	b43_shm_write16(dev, B43_SHM_SHARED, 0x00cc, cc);
 	b43_shm_write16(dev, B43_SHM_SHARED, 0x00cc, cc);
@@ -1283,6 +1292,7 @@ static void b43_phy_ac_op_beacon_rate_set(struct b43_wldev *dev, bool cck)
 	if (ac->beacon_cck == cck)
 		return;
 	ac->beacon_cck = cck;
+	b43_phy_ac_bss_cc_update(dev, B43_PHY_AC_CHAIN_TXPWR);
 	if (ac->txpwr_spacing.has_cck)
 		b43_shm_write16(dev, B43_SHM_SHARED, 0x00ce,
 				b43_phy_ac_beacon_pwr_offset_at(dev,
@@ -4725,16 +4735,28 @@ b43_phy_ac_post_noise_shaping_core_transition(struct b43_wldev *dev,
 	 * cleared instead (a different mask, not just a different value); radio
 	 * 0x0033's nibble goes from 0x80 to 0xc0. The 0x06ee field is always
 	 * 0x8.
-	 */
-	if (dev->phy.ac->cal_width == NL80211_CHAN_WIDTH_20)
+	 *
+	 * Those are 5 GHz captures. On 2.4 GHz at 20 MHz wl 7.14 on the R7000
+	 * (BCM4360, femctrl 3 sub 3, ch 11) has 0x0045 bits 9:8 clear and bit 6
+	 * set (0x70ff) and the 0x0033 nibble at 0x60 (0x4060); with the 5 GHz
+	 * values QPSK and 16-QAM 1/2 lost 17 % of their frames on the EA6900.
+	 */
+	if (b43_current_band(dev->wl) == NL80211_BAND_2GHZ &&
+	    dev->phy.ac->cal_width == NL80211_CHAN_WIDTH_20)
+		b43_radio_maskset(dev, 0x0045 + stride, (u16)~0x0340, 0x0040);
+	else if (dev->phy.ac->cal_width == NL80211_CHAN_WIDTH_20)
 		b43_radio_maskset(dev, 0x0045 + stride, (u16)~0x0300, 0x0300);
 	else
 		b43_radio_maskset(dev, 0x0045 + stride, (u16)~0x0040, 0x0000);
 	b43_phy_read_log(dev, 0x06dc + stride);
 	b43_phy_maskset(dev, 0x06ee + stride, (u16)~0x000c, 0x0008);
-	b43_radio_maskset(dev, 0x0033 + stride, (u16)~0x00f0,
-			  dev->phy.ac->cal_width == NL80211_CHAN_WIDTH_20
-				? 0x0080 : 0x00c0);
+	if (b43_current_band(dev->wl) == NL80211_BAND_2GHZ &&
+	    dev->phy.ac->cal_width == NL80211_CHAN_WIDTH_20)
