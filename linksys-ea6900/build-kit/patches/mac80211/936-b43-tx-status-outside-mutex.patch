From: Erik Conijn <egc112@msn.com>
Subject: [PATCH] b43: report TX status to mac80211 outside wl->mutex

The TX status goes to mac80211 from the interrupt thread with wl->mutex held.
mac80211 enables bottom halves on the way, and the softirqs that run then,
the Ethernet NAPI poll, the bridge and the next frames queued for b43, run
under the mutex too, while b43_tx_work() spins on it: in a 5 GHz download on
a BCM4708 + BCM4360 (EA6900), 22 % of the CPU time.

Queue the frames and report them with the received frames once the mutex is
dropped (b43_rx_deliver()).

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Erik Conijn <egc112@msn.com>
---
--- a/drivers/net/wireless/broadcom/b43/b43.h
+++ b/drivers/net/wireless/broadcom/b43/b43.h
@@ -1133,6 +1133,8 @@
 	 * drops the mutex (b43_rx_deliver()).
 	 */
 	struct sk_buff_head rx_queue;
+	/* Sent frames whose TX status b43_rx_deliver() reports, likewise. */
+	struct sk_buff_head txstatus_queue;
 
 	/* Flag that implement the queues stopping. */
 	bool tx_queue_stopped[B43_QOS_QUEUE_NUM];
--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -2843,10 +2843,18 @@
 	struct sk_buff *skb;
 	LIST_HEAD(list);
 
-	if (skb_queue_empty(&wl->rx_queue))
+	if (skb_queue_empty(&wl->rx_queue) &&
+	    skb_queue_empty(&wl->txstatus_queue))
 		return;
 
 	local_bh_disable();
+	/*
+	 * The TX status too: mac80211 enables bottom halves on the way, and
+	 * the softirqs that then run (the Ethernet NAPI poll, the bridge, the
+	 * next frames for b43) would otherwise run under wl->mutex as well.
+	 */
+	while ((skb = skb_dequeue(&wl->txstatus_queue)))
+		ieee80211_tx_status_skb(wl->hw, skb);
 	while ((skb = skb_dequeue(&wl->rx_queue)))
 		ieee80211_rx_list(wl->hw, NULL, skb, &list);
 	netif_receive_skb_list(&list);
@@ -5851,6 +5859,8 @@
 		}
 	}
 	skb_queue_purge(&wl->rx_queue);
+	while (skb_queue_len(&wl->txstatus_queue))
+		ieee80211_free_txskb(wl->hw, skb_dequeue(&wl->txstatus_queue));
 
 	b43_mac_suspend(dev);
 	b43_leds_exit(dev);
@@ -7501,6 +7511,7 @@
 		wl->tx_queue_stopped[queue_num] = false;
 	}
 	skb_queue_head_init(&wl->rx_queue);
+	skb_queue_head_init(&wl->txstatus_queue);
 
 	snprintf(chip_name, ARRAY_SIZE(chip_name),
 		 (dev->chip_id > 0x9999) ? "%d" : "%04X", dev->chip_id);
--- a/drivers/net/wireless/broadcom/b43/dma.c
+++ b/drivers/net/wireless/broadcom/b43/dma.c
@@ -1634,7 +1634,8 @@
 				ring->nr_failed_tx_packets++;
 			ring->nr_total_packet_tries += status->frame_count;
 #endif /* DEBUG */
-			ieee80211_tx_status_skb(dev->wl->hw, meta->skb);
+			/* Reported by b43_rx_deliver(), outside wl->mutex. */
+			skb_queue_tail(&dev->wl->txstatus_queue, meta->skb);
 
 			/* skb will be freed by ieee80211_tx_status_skb().
 			 * Poison our pointer. */
--- a/drivers/net/wireless/broadcom/b43/pio.c
+++ b/drivers/net/wireless/broadcom/b43/pio.c
@@ -585,7 +585,7 @@
 	q->buffer_used -= total_len;
 	q->free_packet_slots += 1;
 
-	ieee80211_tx_status_skb(dev->wl->hw, pack->skb);
+	skb_queue_tail(&dev->wl->txstatus_queue, pack->skb);
 	pack->skb = NULL;
 	list_add(&pack->list, &q->packets_list);
 
