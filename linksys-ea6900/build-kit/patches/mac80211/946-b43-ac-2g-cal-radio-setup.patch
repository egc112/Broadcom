From: Erik Conijn <egc112@msn.com>
Subject: [PATCH] b43: AC-PHY: 2.4 GHz values for the calibration radio setup

Before the TX IQ/LO and RX-IQ calibrations, two places set up the radio
of each chain for the calibration loopback with six MODs on 0x?1a,
0x?1f, 0x?170 and 0x?1e. Both use the 5 GHz values on either band.

On 2.4 GHz the stock driver uses other values: 0x?1a[7:4] = 0x8 (not
0xb), 0x?1f bit 2 and 0x?170 bit 8 cleared, 0x?170 bit 14 and 0x?1e
bit 2 set. Seen in a bus trace of wl on a BCM4360 (femctrl 3) at
2.4 GHz ch 6, on all three chains and at both places; at 5 GHz the same
trace has the existing values.

With the 5 GHz values, the 2.4 GHz TX IQ/LO calibration gets results
that differ on every run (LO words like 0xdc95 where wl gets 0x0001),
and the RX-IQ calibration measures its loopback tone through that
miscalibrated TX path. The register writes of both calibrations were
otherwise compared op by op with the same trace and match.

Move the six MODs into one helper that picks the band's values.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Erik Conijn <egc112@msn.com>
---
--- a/drivers/net/wireless/broadcom/b43/phy_ac.c
+++ b/drivers/net/wireless/broadcom/b43/phy_ac.c
@@ -7068,6 +7068,31 @@
 					  b43_phy_ac_chain_range_regs[i] + s);
 }
 
+/*
+ * Radio setup of the calibration loopback, per chain, after saving the
+ * registers for the restore: six MODs, in the stock driver's order. The
+ * values depend on the band. On 5 GHz, 0x?1a[7:4] = 0xb, 0x?1f bit 2 and
+ * 0x?170 bit 8 are set and 0x?1e bit 2 is cleared. On 2.4 GHz, 0x?1a[7:4]
+ * = 0x8, 0x?1f bit 2 and 0x?170 bit 8 are cleared and 0x?170 bit 14 and
+ * 0x?1e bit 2 are set. The 5 GHz values on 2.4 GHz leave the TX IQ/LO
+ * calibration measuring a wrong signal: its results are large and differ
+ * on every run, and the RX-IQ calibration that follows inherits the error.
+ */
+static void b43_phy_ac_cal_radio_setup(struct b43_wldev *dev,
+				       unsigned int core)
+{
+	bool g = b43_current_band(dev->wl) == NL80211_BAND_2GHZ;
+	u16 s = (u16)(core * 0x200);
+
+	b43_phy_ac_chain_range_save(dev, core);
+	b43_radio_maskset(dev, 0x001a + s, (u16)~0x00f0, g ? 0x0080 : 0x00b0);
+	b43_radio_maskset(dev, 0x001f + s, (u16)~0x0004, g ? 0 : 0x0004);
+	b43_radio_maskset(dev, 0x0170 + s, (u16)~0x0100, g ? 0 : 0x0100);
+	b43_radio_maskset(dev, 0x0170 + s, (u16)~0x4000, g ? 0x4000 : 0);
+	b43_radio_maskset(dev, 0x001e + s, (u16)~0x0004, g ? 0x0004 : 0);
+	b43_radio_maskset(dev, 0x001a + s, (u16)~0x0300, 0);
+}
+
 /* Save 0x040f for a later write-back, then clear its bit 9. */
 static void b43_phy_ac_rxcal_040f_save(struct b43_wldev *dev)
 {
@@ -7135,17 +7160,8 @@
 		u8 c;
 		u8 num_cores = dev->phy.ac->num_cores;
 
-		for_each_set_bit(c, &dev->phy.ac->coremask, num_cores) {
-			u16 s = (u16)(c * 0x200);
-
-			b43_phy_ac_chain_range_save(dev, c);
-			b43_radio_maskset(dev, 0x001a + s, (u16)~0x00f0, 0x00b0);
-			b43_radio_maskset(dev, 0x001f + s, (u16)~0x0004, 0x0004);
-			b43_radio_maskset(dev, 0x0170 + s, (u16)~0x0100, 0x0100);
-			b43_radio_maskset(dev, 0x0170 + s, (u16)~0x4000, 0);
-			b43_radio_maskset(dev, 0x001e + s, (u16)~0x0004, 0);
-			b43_radio_maskset(dev, 0x001a + s, (u16)~0x0300, 0);
-		}
+		for_each_set_bit(c, &dev->phy.ac->coremask, num_cores)
+			b43_phy_ac_cal_radio_setup(dev, c);
 	}
 
 	/*
@@ -7876,18 +7892,8 @@
 	b43_phy_ac_classctl_write_peeked(dev, true);
 
 	/* 3o-3r: per chain, seven radio reads and six radio MODs. */
-	for_each_set_bit(core, &dev->phy.ac->coremask, dev->phy.ac->num_cores) {
-		u16 s = (u16)(core * 0x200);
-
-		b43_phy_ac_chain_range_save(dev, core);
-		/* each maskset is MOD + RD + WR */
-		b43_radio_maskset(dev, 0x001a + s, (u16)~0x00f0, 0x00b0);
-		b43_radio_maskset(dev, 0x001f + s, (u16)~0x0004, 0x0004);
-		b43_radio_maskset(dev, 0x0170 + s, (u16)~0x0100, 0x0100);
-		b43_radio_maskset(dev, 0x0170 + s, (u16)~0x4000, 0);
-		b43_radio_maskset(dev, 0x001e + s, (u16)~0x0004, 0);
-		b43_radio_maskset(dev, 0x001a + s, (u16)~0x0300, 0);
-	}
+	for_each_set_bit(core, &dev->phy.ac->coremask, dev->phy.ac->num_cores)
+		b43_phy_ac_cal_radio_setup(dev, core);
 }
 
